<!DOCTYPE html>
<html lang="am">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Amanuel Light and Life School</title>
    
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>

    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #eef2f5; margin: 0; padding: 20px; color: #333; }
        .container { max-width: 1200px; margin: auto; }
        
        /* Language Toggle Magic */
        body.lang-am .en { display: none !important; }
        body.lang-en .am { display: none !important; }

        h2 { color: #2c3e50; text-align: center; margin-bottom: 30px; font-size: 28px; }
        .card { background: white; padding: 25px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); margin-bottom: 25px; border-top: 4px solid #2980b9; }
        .card h3 { color: #1f4e79; margin-top: 0; margin-bottom: 20px; font-size: 20px; border-bottom: 2px solid #ecf0f1; padding-bottom: 10px; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; background: white; }
        th, td { border: 1px solid #e0e0e0; padding: 12px; text-align: center; font-size: 14px; }
        th { background: #1f4e79; color: white; font-weight: 600; position: sticky; top: 0; }
        tr:nth-child(even) { background: #f8f9fa; }
        tr:hover { background: #e8f4fd; }
        input[type="text"], input[type="number"], select, input[type="file"] { width: 100%; padding: 10px; margin-bottom: 10px; border: 1px solid #ccd1d9; border-radius: 6px; box-sizing: border-box; font-family: inherit; }
        button { background: #3498db; color: white; border: none; padding: 10px 20px; border-radius: 6px; cursor: pointer; font-weight: bold; transition: background 0.3s; }
        button:hover { background: #2980b9; }
        .btn-green { background: #27ae60; } .btn-green:hover { background: #219653; }
        .btn-red { background: #e74c3c; } .btn-red:hover { background: #c0392b; }
        .btn-orange { background: #f39c12; } .btn-orange:hover { background: #d68910; }
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .logout-btn { background: #e74c3c; color: white; padding: 10px 20px; text-decoration: none; border-radius: 6px; font-weight: bold; }
        #editor { height: 150px; background: white; border-radius: 0 0 6px 6px; }
    </style>
</head>
<body class="lang-am">
    <div class="container">
        
        <!-- Top Navigation (Language & Logout) -->
        <div style="display: flex; justify-content: flex-end; gap: 15px; align-items: center; margin-bottom: 20px;">
            <div style="background: white; padding: 5px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                <button onclick="setLang('am')" id="btn-am" style="background:#27ae60; color:white; padding:5px 15px; border-radius:5px; border:none; cursor:pointer; font-weight:bold;">🇪🇹 አማርኛ</button>
                <button onclick="setLang('en')" id="btn-en" style="background:transparent; color:#333; padding:5px 15px; border-radius:5px; border:none; cursor:pointer; font-weight:bold;">🇬🇧 English</button>
            </div>
            <a href="/logout" class="logout-btn">🚪 <span class="am">ውጣ</span><span class="en">Logout</span></a>
        </div>

        <h2>👑 <span class="am">የዲሬክተር / አድሚን መቆጣጠሪያ</span><span class="en">Admin Dashboard</span></h2>

        <!-- Academic Year -->
        <div class="card" style="background: #fffcf5; border-color: #f39c12;">
            <h3 style="color: #d35400; border-bottom-color: #fce8cd;">🎓 <span class="am">የአካዳሚክ ዓመት ማጠቃለያ</span><span class="en">Academic Year-End Actions</span></h3>
            <p style="font-size: 13px; color: #555;">
                <span class="am">ማሳሰቢያ፦ እነዚህን ተግባራት ከማድረግዎ በፊት እባክዎ የክፍል ውጤቶችን ዳውንሎድ ማድረጎን ያረጋግጡ።</span>
                <span class="en">Note: Please ensure you have downloaded all class reports before proceeding.</span>
            </p>
            <div style="display: flex; gap: 15px; flex-wrap: wrap; margin-top: 15px;">
                <form action="/admin/archive-year" method="POST" onsubmit="return confirm('እርግጠኛ ነዎት? / Are you sure?');">
                    <button type="submit" class="btn-orange">🗂️ <span class="am">1. የዓመቱን ውጤት ቋጥሮ ያዝ</span><span class="en">1. Archive Academic Year</span></button>
                </form>
                <form action="/admin/promote-students" method="POST" onsubmit="return confirm('እርግጠኛ ነዎት? / Are you sure?');">
                    <button type="submit" class="btn-green">🚀 <span class="am">2. ተማሪዎችን ወደ ቀጣይ ክፍል አሳድግ</span><span class="en">2. Promote All Students</span></button>
                </form>
            </div>
        </div>

        <!-- Notification -->
        <div class="card">
            <h3>📢 <span class="am">አዲስ ማስታወቂያ መላኪያ</span><span class="en">Send New Notification</span></h3>
            <form id="notifForm" action="/admin/save-notice" method="POST" enctype="multipart/form-data">
                <label><span class="am">ለማን ይላክ?</span><span class="en">To Whom?</span></label>
                <select name="target_audience" style="width: 100%; max-width: 300px; display: block; margin-bottom: 15px;">
                    <option value="ALL">ለማንኛውም ሰው (To All / Everyone)</option>
                    <%- gradeCheckboxes %>
                </select>

                <label><span class="am">መልዕክትዎን ይጻፉ፦</span><span class="en">Write your message:</span></label>
                <div id="editor"></div>
                <input type="hidden" name="message" id="hiddenMessage">

                <label style="display: block; margin-top: 15px;">📎 <span class="am">ፋይል ወይም ፎቶ አያይዝ (አማራጭ)</span><span class="en">Attach File/Photo (Optional)</span>:</label>
                <input type="file" name="attachment" style="max-width: 300px; display: block;">

                <button type="submit" style="margin-top: 15px; width: 100%; max-width: 300px;">📩 <span class="am">ማስታወቂያውን ላክ</span><span class="en">Send Notification</span></button>
            </form>
        </div>

        <div class="card">
            <h3>🔔 <span class="am">ቀደም ሲል የተላኩ ማስታወቂያዎች</span><span class="en">Previously Sent Notifications</span></h3>
            <div style="max-height: 400px; overflow-y: auto;">
                <%- adminNotiRows %>
            </div>
        </div>

        <div class="grid-2">
            <!-- Pending Students -->
            <div class="card" style="border-color: #27ae60;">
                <h3 style="color: #27ae60; border-bottom-color: #d5f5e3;">🟢 <span class="am">አዲስ አመልካቾች</span><span class="en">Pending Approvals</span></h3>
                <div style="overflow-x: auto;">
                    <table>
                        <tr>
                            <th>#</th>
                            <th><span class="am">መታወቂያ</span><span class="en">ID</span></th>
                            <th><span class="am">ስም</span><span class="en">Name</span></th>
                            <th><span class="am">ክፍያ</span><span class="en">Payment</span></th>
                            <th><span class="am">ተግባር</span><span class="en">Action</span></th>
                        </tr>
                        <%- pRows %>
                    </table>
                </div>
            </div>

                                                <!-- 👩‍🏫 Teachers Management (Multi-Section Assignment & Teacher Handover) -->
            <div class="card" style="border-color: #8e44ad; grid-column: 1 / -1;">
                <h3 style="color: #8e44ad; border-bottom-color: #f4ecf7;">
                    👩‍🏫 <span class="am">መምህራን ምዝገባ እና የብዙ ክፍል/ሴክሽን ምደባ</span><span class="en">Teachers Registration & Multi-Section Assignment</span>
                </h3>
                
                <!-- 1. አዲስ መምህር መመዝገቢያ (ብዙ ክፍልና ሴክሽን መምረጫ ያለው) -->
                <form action="/admin/register-teacher-full" method="POST" enctype="multipart/form-data" style="margin-bottom: 20px; background: #faf8fc; padding: 18px; border-radius: 10px; border: 1px solid #e8daef;">
                    <h4 style="margin-top:0; color:#8e44ad;">➕ <span class="am">1. አዲስ መምህር መመዝገቢያ</span><span class="en">1. Register New Teacher</span></h4>

                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px;">
                        <div>
                            <label style="font-weight:bold; font-size:13px;"><span class="am">👤 የመምህሩ ሙሉ ስም *</span><span class="en">👤 Teacher Full Name *</span></label>
                            <input type="text" name="name" placeholder="ሙሉ ስም (ከነአያት) / Full Name" required>
                        </div>
                        <div>
                            <label style="font-weight:bold; font-size:13px;"><span class="am">⚧ ፆታ *</span><span class="en">⚧ Gender *</span></label>
                            <select name="gender" required>
                                <option value="">ፆታ / Gender</option>
                                <option value="Male">ወንድ / Male</option>
                                <option value="Female">ሴት / Female</option>
                            </select>
                        </div>
                        <div>
                            <label style="font-weight:bold; font-size:13px;"><span class="am">📞 ስልክ ቁጥር *</span><span class="en">📞 Phone Number *</span></label>
                            <input type="text" name="phone" placeholder="09... / 07..." required>
                        </div>
                        <div>
                            <label style="font-weight:bold; font-size:13px;"><span class="am">📘 የሚያስተምሩት ትምህርት *</span><span class="en">📘 Subject *</span></label>
                            <input type="text" name="subject" placeholder="ምሳሌ: Maths, English..." required>
                        </div>
                        <div>
                            <label style="font-weight:bold; font-size:13px;"><span class="am">🚨 የአደጋ ጊዜ ተጠሪ ስም *</span><span class="en">🚨 Emergency Contact Name *</span></label>
                            <input type="text" name="emergency_name" placeholder="ተጠሪ ስም / Contact Name" required>
                        </div>
                        <div>
                            <label style="font-weight:bold; font-size:13px;"><span class="am">☎️ የአደጋ ጊዜ ተጠሪ ስልክ *</span><span class="en">☎️ Emergency Phone *</span></label>
                            <input type="text" name="emergency_phone" placeholder="09... / 07..." required>
                        </div>
                    </div>

                    <!-- 🏫 ብዙ ክፍልና ሴክሽን በአንድ ጊዜ መምረጫ (Multi-Section Checkboxes) -->
                    <label style="font-weight:bold; font-size:13.5px; color:#8e44ad; display:block; margin-top:8px; margin-bottom:6px;">
                        🏫 <span class="am">የሚመደቡባቸውን ክፍሎች እና ሴክሽኖች ይምረጡ (ብዙ መምረጥ ይቻላል) *</span>
                        <span class="en">Select Assigned Classes & Sections (Multiple Allowed) *</span>
                    </label>
                    <select id="rawSectionOptionsSource" style="display:none;"><%- sectionOptions %></select>
                    <div id="regSectionCheckboxes" class="multi-sec-grid"></div>
                    <input type="hidden" name="assigned_sections" id="regAssignedSectionsInput" required>

                    <label style="font-weight:bold; font-size:13px; display:block; margin-top:10px;">
                        📷 <span class="am">የመምህሩ ፎቶ (ለመታወቂያ)</span><span class="en">Teacher Photo (For ID)</span>:
                    </label>
                    <input type="file" name="teacher_photo" accept="image/*" style="background: white;">

                    <button type="submit" class="btn-green" style="width: 100%; background: #8e44ad; padding: 12px; font-size: 15px; margin-top: 8px; color:white; border:none; border-radius:6px; font-weight:bold; cursor:pointer;">
                        🪪 <span class="am">መምህር መዝግብና መታወቂያ አውጣ</span><span class="en">Register & Generate Teacher ID</span>
                    </button>
                </form>

                <!-- 2. ለመምህር ተጨማሪ ብዙ ክፍሎች መመደቢያ እና መምህር በመምህር መተኪያ (ውጤት ሳይጠፋ) -->
                <div style="background: #eef7fa; padding: 18px; border-radius: 10px; border: 2px solid #3498db; margin-bottom: 20px;">
                    <h4 style="margin-top:0; color:#1f4e79;">
                        🔄 <span class="am">2. ለመምህር ብዙ ክፍሎች መመደቢያ / መምህር በመምህር መተኪያ</span>
                        <span class="en">2. Assign Multiple Sections / Teacher Handover</span>
                    </h4>
                    <p style="font-size: 12.5px; color: #555; margin-top: -5px; margin-bottom: 12px;">
                        <span class="am">💡 ለአንድ መምህር ብዙ ክፍሎችን በአንድ ጊዜ መመደብ ይችላሉ። የሚለቅ መምህር ካለም ሲተኩት <b>ቀድሞ የተሞሉ ውጤቶች ሳይጠፉ</b> አዲሱ መምህር ከቆመበት ይቀጥላል።</span>
                        <span class="en">💡 Assign one or multiple sections at once. Replacing a leaving teacher preserves all entered student grades.</span>
                    </p>

                    <form action="/admin/handover-section" method="POST">
                        <label style="font-weight:bold; font-size:13px; color:#1f4e79; display:block; margin-bottom:6px;">
                            🏫 <span class="am">ክፍሎች እና ሴክሽኖች ይምረጡ (1 ወይም ብዙ መምረጥ ይችላሉ) *</span>
                            <span class="en">Select Class & Sections (One or Multiple) *</span>
                        </label>
                        <div id="handoverSectionCheckboxes" class="multi-sec-grid"></div>
                        <input type="hidden" name="section_name" id="handoverSectionsInput" required>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px;">
                            <div>
                                <label style="font-weight:bold; font-size:13px; color:#c0392b;">
                                    <span class="am">📤 የሚለቀው መምህር (የሚተካ ከሆነ ብቻ)</span><span class="en">📤 Leaving Teacher (If replacing)</span>
                                </label>
                                <select name="old_teacher_id" id="oldTeacherSelect">
                                    <option value="">-- የለም (ተጨማሪ ምደባ) / None --</option>
                                </select>
                            </div>
                            <div>
                                <label style="font-weight:bold; font-size:13px; color:#27ae60;">
                                    <span class="am">📥 የሚመደበው / ተተኪው መምህር *</span><span class="en">📥 Assigned / Incoming Teacher *</span>
                                </label>
                                <select name="new_teacher_id" id="newTeacherSelect" required>
                                    <option value="">መምህር ይምረጡ / Select Teacher</option>
                                </select>
                            </div>
                        </div>

                        <button type="submit" style="width: 100%; background: #2980b9; color:white; border:none; border-radius:6px; font-weight:bold; padding: 12px; margin-top: 8px; cursor:pointer;">
                            🔄 <span class="am">የተመረጡትን ክፍሎች ለመምህሩ መድብ / አስተላልፍ</span><span class="en">Assign / Handover Selected Sections</span>
                        </button>
                    </form>
                </div>

                <!-- 3. የመምህራን ዝርዝር ሰንጠረዥ -->
                <div style="overflow-x: auto;">
                    <table id="teachersListTable">
                        <tr>
                            <th><span class="am">መታወቂያ</span><span class="en">ID</span></th>
                            <th><span class="am">ስም</span><span class="en">Name</span></th>
                            <th><span class="am">ክፍሎች</span><span class="en">Sections</span></th>
                            <th><span class="am">ይለፍ ቃል</span><span class="en">Pass</span></th>
                            <th><span class="am">አስተካክል</span><span class="en">Edit</span></th>
                        </tr>
                        <%- tRows %>
                    </table>
                </div>
            </div>

            <!-- 📊 የዲሬክተር ሳምንታዊ እና ወርሃዊ ሪፖርት ካርድ (Director Weekly & Monthly Report) -->
            <div class="card" id="directorReportCard" style="border-color: #16a085; grid-column: 1 / -1; background: linear-gradient(to right, #ffffff, #f4fbf9);">
                <h3 style="color: #16a085; border-bottom-color: #d1f2eb;">
                    📊 <span class="am">የዲሬክተር ሳምንታዊ እና ወርሃዊ ሪፖርት</span><span class="en">Director's Weekly & Monthly Report</span>
                </h3>
                <form action="/admin/director-report" method="GET" target="_blank" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 15px; align-items: end;">
                    <div>
                        <label style="font-weight:bold; font-size:13.5px; color:#16a085;">
                            📅 <span class="am">የሪፖርት አይነት ይምረጡ *</span><span class="en">Select Report Type *</span>
                        </label>
                        <select name="type" required style="margin-bottom:0;">
                            <option value="weekly">📆 ሳምንታዊ ሪፖርት (Weekly Report)</option>
                            <option value="monthly">🗓️ ወርሃዊ ሪፖርት (Monthly Report)</option>
                        </select>
                    </div>
                    <div>
                        <label style="font-weight:bold; font-size:13.5px; color:#16a085;">
                            ✍️ <span class="am">የዲሬክተሩ ማጠቃለያ ማስታወሻ (ካለ)</span><span class="en">Director's Summary Note (Optional)</span>
                        </label>
                        <input type="text" name="note" placeholder="የሳምንቱ/የወሩ አበይት ክንውኖች..." style="margin-bottom:0;">
                    </div>
                    <div>
                        <button type="submit" style="width:100%; background:#16a085; color:white; padding:12px; border:none; border-radius:6px; font-weight:bold; font-size:15px; cursor:pointer;">
                            🖨️ <span class="am">ሪፖርት አዘጋጅና አውጣ (Generate & Print)</span><span class="en">Generate & Print Report</span>
                        </button>
                    </div>
                </form>
            </div>

            <style>
                /* ☑️ የብዙ ክፍል/ሴክሽን መምረጫ ሳጥኖች ንድፍ */
                .multi-sec-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(155px, 1fr)); gap: 8px; background: white; padding: 12px; border: 1px solid #ccd1d9; border-radius: 8px; max-height: 165px; overflow-y: auto; margin-bottom: 10px; }
                .sec-chk-label { display: flex; align-items: center; gap: 6px; background: #f8fafc; padding: 7px 10px; border-radius: 6px; border: 1px solid #e2e8f0; font-size: 13px; font-weight: 600; color: #2c3e50; cursor: pointer; transition: 0.2s; }
                .sec-chk-label:hover { border-color: #3498db; background: #ebf5fb; }
                .sec-chk-label input { width: 16px; height: 16px; margin: 0; cursor: pointer; }

                /* 📉 አዲስ አመልካቾች ካርድ ማሳነሻ (Compact Applicants Card) */
                .compact-applicants-card { padding: 14px !important; max-height: 310px !important; overflow-y: auto !important; }
                .compact-applicants-card h3 { font-size: 16px !important; margin-bottom: 8px !important; padding-bottom: 6px !important; }
                .compact-applicants-card table th, .compact-applicants-card table td { padding: 5px 6px !important; font-size: 12px !important; }

                /* 📈 የትምህርት አይነቶች ካርድ ማሳደጊያ (Expanded Subjects Card) */
                .expanded-subjects-card { grid-column: 1 / -1 !important; padding: 28px !important; border-width: 3px !important; }
                .expanded-subjects-card h3 { font-size: 22px !important; }
                .expanded-subjects-card input, .expanded-subjects-card select, .expanded-subjects-card button { font-size: 16px !important; padding: 12px !important; }
                .expanded-subjects-card table th, .expanded-subjects-card table td { padding: 12px 15px !important; font-size: 15.5px !important; }
            </style>

            <script>
                document.addEventListener("DOMContentLoaded", function() {
                    // 1. ☑️ የክፍልና ሴክሽን ምርጫዎችን ወደ Multi-Select Checkboxes መቀየር
                    const rawSelect = document.getElementById("rawSectionOptionsSource");
                    const regGrid = document.getElementById("regSectionCheckboxes");
                    const handGrid = document.getElementById("handoverSectionCheckboxes");
                    const regInput = document.getElementById("regAssignedSectionsInput");
                    const handInput = document.getElementById("handoverSectionsInput");

                    if (rawSelect) {
                        Array.from(rawSelect.options).forEach(opt => {
                            const val = opt.value.trim();
                            const text = opt.textContent.trim();
                            if (!val) return;

                            // ለአዲስ መምህር መመዝገቢያ
                            if (regGrid) {
                                regGrid.innerHTML += `<label class="sec-chk-label"><input type="checkbox" class="reg-sec-chk" value="${val}"> <span>${text}</span></label>`;
                            }
                            // ለክፍል ምደባ እና መምህር መተኪያ
                            if (handGrid) {
                                handGrid.innerHTML += `<label class="sec-chk-label"><input type="checkbox" class="hand-sec-chk" value="${val}"> <span>${text}</span></label>`;
                            }
                        });

                        document.querySelectorAll(".reg-sec-chk").forEach(chk => {
                            chk.addEventListener("change", () => {
                                const selected = Array.from(document.querySelectorAll(".reg-sec-chk:checked")).map(c => c.value);
                                regInput.value = selected.join(", ");
                            });
                        });

                        document.querySelectorAll(".hand-sec-chk").forEach(chk => {
                            chk.addEventListener("change", () => {
                                const selected = Array.from(document.querySelectorAll(".hand-sec-chk:checked")).map(c => c.value);
                                handInput.value = selected.join(", ");
                            });
                        });
                    }

                    // 2. 👨‍🏫 መምህራንን ወደ Dropdown መሙላት
                    const table = document.getElementById("teachersListTable");
                    const oldSel = document.getElementById("oldTeacherSelect");
                    const newSel = document.getElementById("newTeacherSelect");
                    if (table && oldSel && newSel) {
                        table.querySelectorAll("tr").forEach((row, index) => {
                            if (index === 0) return;
                            const cells = row.querySelectorAll("td");
                            if (cells.length >= 2) {
                                const tId = cells[0].innerText.trim();
                                const tName = cells[1].innerText.trim();
                                if (tId) {
                                    oldSel.innerHTML += `<option value="${tId}">${tName} (${tId})</option>`;
                                    newSel.innerHTML += `<option value="${tId}">${tName} (${tId})</option>`;
                                }
                            }
                        });
                    }

                    // 3. 📉 "አዲስ አመልካቾች" ሳይዝ መቀነስ እና 📈 "የትምህርት አይነቶች" ሳይዝ መጨመር + Credit Hour ማጥፋት
                    document.querySelectorAll(".card").forEach(card => {
                        const heading = card.querySelector("h3, h2, h4");
                        if (!heading) return;
                        const text = heading.innerText;

                        // ሀ. አዲስ አመልካቾች ሳይዝ መቀነስ
                        if (text.includes("አዲስ አመልካቾች") || text.toLowerCase().includes("pending") || text.toLowerCase().includes("applicant")) {
                            card.classList.add("compact-applicants-card");
                        }

                        // ለ. የትምህርት አይነቶች ሳይዝ መጨመር እና Credit Hour ማጥፋት
                        if (text.includes("የትምህርት አይነቶች") || text.toLowerCase().includes("subject") || text.toLowerCase().includes("course")) {
                            card.classList.add("expanded-subjects-card");

                            // Credit Hour የሚል Input ካለ ማጥፋት
                            card.querySelectorAll("input, label").forEach(el => {
                                const attrText = (el.name || "") + " " + (el.placeholder || "") + " " + (el.innerText || "");
                                if (attrText.toLowerCase().includes("credit") || attrText.toLowerCase().includes("cret") || attrText.includes("ክሬዲት") || attrText.includes("ሰዓት")) {
                                    if (el.tagName === "INPUT") {
                                        el.required = false;
                                        el.value = "0";
                                        el.style.display = "none";
                                    } else {
                                        el.style.display = "none";
                                    }
                                }
                            });

                            // በሰንጠረዡ ውስጥ Credit Hour የሚል አምድ (Column) ካለ ማጥፋት
                            const subTable = card.querySelector("table");
                            if (subTable) {
                                let creditColIndex = -1;
                                const ths = subTable.querySelectorAll("tr:first-child th");
                                ths.forEach((th, idx) => {
                                    const thTxt = th.innerText.toLowerCase();
                                    if (thTxt.includes("credit") || thTxt.includes("cret") || thTxt.includes("ክሬዲት") || thTxt.includes("hr")) {
                                        creditColIndex = idx;
                                        th.style.display = "none";
                                    }
                                });
                                if (creditColIndex > -1) {
                                    subTable.querySelectorAll("tr").forEach((tr, rIdx) => {
                                        if (rIdx === 0) return;
                                        const tds = tr.querySelectorAll("td");
                                        if (tds[creditColIndex]) tds[creditColIndex].style.display = "none";
                                    });
                                }
                            }
                        }

                        // ሐ. የድሮ የማይሰራ የዲሬክተር ሪፖርት ካርድ ካለ መደበቅ (አዲሱ ስላለ)
                        if (card.id !== "directorReportCard" && (text.includes("ሳምንታዊ") || text.includes("ወርሃዊ") || text.toLowerCase().includes("director"))) {
                            card.style.display = "none";
                        }
                    });
                });
            </script>


                // በሰንጠረዡ ውስጥ ያሉትን መምህራን ወደ ምርጫው (Dropdown) በራሱ እንዲያስገባ
                document.addEventListener("DOMContentLoaded", function() {
                    const table = document.getElementById("teachersListTable");
                    const oldSel = document.getElementById("oldTeacherSelect");
                    const newSel = document.getElementById("newTeacherSelect");
                    if (table && oldSel && newSel) {
                        const rows = table.querySelectorAll("tr");
                        rows.forEach((row, index) => {
                            if (index === 0) return; // የመጀመሪያውን የርዕስ መስመር ይዘለዋል
                            const cells = row.querySelectorAll("td");
                            if (cells.length >= 2) {
                                const tId = cells[0].innerText.trim();
                                const tName = cells[1].innerText.trim();
                                if (tId) {
                                    oldSel.innerHTML += `<option value="${tId}">${tName} (${tId})</option>`;
                                    newSel.innerHTML += `<option value="${tId}">${tName} (${tId})</option>`;
                                }
                            }
                        });
                    }
                });
            </script>



        <div class="grid-2">
            <!-- Sections -->
            <div class="card">
                <h3>🏫 <span class="am">የክፍል ሴክሽኖች</span><span class="en">Class Sections</span></h3>
                <form action="/admin/add-section" method="POST" style="display: flex; gap: 10px; margin-bottom: 15px;">
                    <input type="text" name="name" placeholder="Grade 1 - Section A" required style="margin-bottom: 0;">
                    <button type="submit">➕ <span class="am">ጨምር</span><span class="en">Add</span></button>
                </form>
                <div style="overflow-x: auto;">
                    <table>
                        <tr>
                            <th><span class="am">የሴክሽን ስም</span><span class="en">Section Name</span></th>
                            <th><span class="am">ተቆጣጣሪ</span><span class="en">Proctor</span></th>
                            <th><span class="am">አጥፋ</span><span class="en">Delete</span></th>
                        </tr>
                        <%- secRows %>
                    </table>
                </div>
            </div>

            <!-- Courses -->
            <div class="card">
                <h3>📚 <span class="am">የትምህርት አይነቶች</span><span class="en">Courses</span></h3>
                <form action="/admin/add-course" method="POST" style="background: #fafafa; padding: 15px; border-radius: 8px; margin-bottom: 15px;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                        <input type="text" name="code" placeholder="Course Code" required>
                        <input type="text" name="title" placeholder="Course Title" required>
                        <input type="number" name="credit_hours" placeholder="Credit Hours" required>
                        <select name="class_level" required>
                            <option value="">የትኛውን ክፍል? / Which Class?</option>
                            <%- sectionOptions %>
                        </select>
                    </div>
                    <button type="submit" class="btn-green" style="width: 100%; margin-top: 10px;">➕ <span class="am">የትምህርት አይነት ጨምር</span><span class="en">Add Course</span></button>
                </form>
            </div>
        </div>

        <!-- Director Report -->
        <div class="card" style="text-align: center; background: #fdf2e9; border-color: #e67e22;">
            <h3 style="color: #d35400;">📁 <span class="am">የዲሬክተር ሳምንታዊ እና ወርሃዊ ሪፖርት</span><span class="en">Director Weekly & Monthly Report</span></h3>
            <a href="/director-report" target="_blank" style="display: inline-block; background: #8e44ad; color: white; padding: 12px 25px; text-decoration: none; border-radius: 6px; font-weight: bold; font-size: 16px;">
                📂 <span class="am">ሪፖርቱን ክፈት</span><span class="en">Open Director Report</span>
            </a>
        </div>

        <!-- Registered Students Link -->
        <div class="card" style="text-align: center; background: #e8f8f5; border-color: #1abc9c;">
            <h3 style="color: #16a085;">👨‍🎓 <span class="am">የተመዘገቡ ተማሪዎች ማህደር</span><span class="en">Registered Students Database</span></h3>
            <a href="/admin/registered-students" target="_blank" style="display: inline-block; background: #1abc9c; color: white; padding: 15px 30px; text-decoration: none; border-radius: 8px; font-weight: bold; font-size: 18px; margin-top: 10px;">
                📂 <span class="am">የተማሪዎችን ዝርዝር ክፈት</span><span class="en">Open Students List</span>
            </a>
        </div>

    </div>

    <script>
        // Language Toggle Script
        function setLang(lang) {
            document.body.className = 'lang-' + lang;
            localStorage.setItem('prefLang', lang);
            
            // Style the active button
            document.getElementById('btn-am').style.background = lang === 'am' ? '#27ae60' : 'transparent';
            document.getElementById('btn-am').style.color = lang === 'am' ? 'white' : '#333';
            
            document.getElementById('btn-en').style.background = lang === 'en' ? '#2980b9' : 'transparent';
            document.getElementById('btn-en').style.color = lang === 'en' ? 'white' : '#333';
        }

        // Apply saved language on load
        document.addEventListener("DOMContentLoaded", function() {
            let savedLang = localStorage.getItem('prefLang') || 'am';
            setLang(savedLang);
        });

        // Quill Setup
        var quill = new Quill('#editor', {
            theme: 'snow',
            modules: { toolbar: [ [{ 'font': [] }, { 'size': [] }], ['bold', 'italic', 'underline'], [{'color': []}, {'background': []}], ['clean'] ] }
        });
        document.getElementById('notifForm').onsubmit = function() {
            document.getElementById('hiddenMessage').value = document.querySelector('#editor .ql-editor').innerHTML;
        };
    </script>
</body>
</html>
