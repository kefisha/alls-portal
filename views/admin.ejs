                <label style="font-weight:bold; font-size:13px; display:block; margin-top:10px;">
                    📷 <span class="am">የመምህሩ ፎቶ (ለመታወቂያ)</span><span class="en">Teacher Photo (For ID)</span>:
                </label>
                <input type="file" name="teacher_photo" accept="image/*" style="background: white;">

                <button type="submit" class="btn-green" style="width: 100%; background: #8e44ad; padding: 12px; font-size: 15px; margin-top: 8px; color:white; border:none; border-radius:6px; font-weight:bold; cursor:pointer;">
                    🪪 <span class="am">መምህር መዝግብና መታወቂያ አውጣ</span><span class="en">Register & Generate Teacher ID</span>
                </button>
            </form>

            <div style="background: #eef7fa; padding: 18px; border-radius: 10px; border: 2px solid #3498db; margin-bottom: 20px;">
                <h4 style="margin-top:0; color:#1f4e79;">
                    🔄 <span class="am">2. ለመምህር ብዙ ክፍሎች መመደቢያ / መምህር በመምህር መተኪያ</span>
                    <span class="en">2. Assign Multiple Sections / Teacher Handover</span>
                </h4>
                <form action="/admin/handover-section" method="POST">
                    <label style="font-weight:bold; font-size:13px; color:#1f4e79; display:block; margin-bottom:6px;">
                        🏫 <span class="am">ክፍሎች እና ሴክሽኖች ይምረጡ (1 ወይም ብዙ መምረጥ ይችላሉ) *</span>
                        <span class="en">Select Class & Sections (One or Multiple) *</span>
                    </label>
                    <div id="handoverSectionCheckboxes" class="multi-sec-grid"></div>
                    <input type="hidden" name="section_name" id="handoverSectionsInput" required>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px;">
                        <div>
                            <label style="font-weight:bold; font-size:13px; color:#c0392b;">
                                <span class="am">📤 የሚለቀው መምህር (የሚተካ ከሆነ ብቻ)</span><span class="en">📤 Leaving Teacher (If replacing)</span>
                            </label>
                            <select name="old_teacher_id" id="oldTeacherSelect">
                                <option value="">-- የለም (ተጨማሪ ምደባ) / None --</option>
                            </select>
                        </div>
                        <div>
                            <label style="font-weight:bold; font-size:13.5px; color:#27ae60;">
                                <span class="am">📥 የሚመደበው / ተተኪው መምህር *</span><span class="en">📥 Assigned / Incoming Teacher *</span>
                            </label>
                            <select name="new_teacher_id" id="newTeacherSelect" required>
                                <option value="">መምህር ይምረጡ / Select Teacher</option>
                            </select>
                        </div>
                    </div>

                    <button type="submit" style="width: 100%; background: #2980b9; color:white; border:none; border-radius:6px; font-weight:bold; padding: 12px; margin-top: 8px; cursor:pointer;">
                        🔄 <span class="am">የተመረጡትን ክፍሎች ለመምህሩ መድብ / አስተላልፍ</span><span class="en">Assign / Handover Selected Sections</span>
                    </button>
                </form>
            </div>

            <div style="overflow-x: auto;">
                <table id="teachersListTable">
                    <tr>
                        <th><span class="am">መታወቂያ</span><span class="en">ID</span></th>
                        <th><span class="am">ስም</span><span class="en">Name</span></th>
                        <th><span class="am">ክፍሎች</span><span class="en">Sections</span></th>
                        <th><span class="am">ይለፍ ቃል</span><span class="en">PIN / Pass</span></th>
                        <th><span class="am">እርምጃ</span><span class="en">Action</span></th>
                    </tr>
                    <%- tRows %>
                </table>
            </div>
        </div>

        <!-- Class Sections Card -->
        <div class="card">
            <h3>🏫 <span class="am">የክፍል ሴክሽኖች</span><span class="en">Class Sections</span></h3>
            <form action="/admin/add-section" method="POST" style="display: flex; gap: 10px; margin-bottom: 15px;">
                <input type="text" name="name" placeholder="Grade 1 - Section A" required style="margin-bottom: 0;">
                <button type="submit">➕ <span class="am">ጨምር</span><span class="en">Add</span></button>
            </form>
            <div style="overflow-x: auto;">
                <table>
                    <tr>
                        <th><span class="am">የሴክሽን ስም</span><span class="en">Section Name</span></th>
                        <th><span class="am">ተቆጣጣሪ መምህር</span><span class="en">Proctor</span></th>
                        <th><span class="am">አጥፋ</span><span class="en">Delete</span></th>
                        <th><span class="am">ተግባር</span><span class="en">Actions</span></th>
                    </tr>
                    <%- secRows %>
                </table>
            </div>
        </div>

        <!-- Courses Card -->
        <div class="card expanded-subjects-card" style="border-color: #2980b9;">
            <h3>📚 <span class="am">የትምህርት አይነቶች ምዝገባ እና ዝርዝር</span><span class="en">Courses Registration & List</span></h3>
            <form action="/admin/add-course" method="POST" style="background: #f8fafc; padding: 18px; border-radius: 10px; border: 1px solid #e2e8f0; margin-bottom: 20px;">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px;">
                    <input type="text" name="code" placeholder="የትምህርት ኮድ / Course Code (e.g. ENG-01)" required style="margin-bottom:0;">
                    <input type="text" name="title" placeholder="የትምህርት ስም / Course Title (e.g. English)" required style="margin-bottom:0;">
                    <input type="hidden" name="credit_hours" value="0">
                    <select name="class_level" required style="margin-bottom:0;">
                        <option value="">የትኛውን ክፍል? / Which Class?</option>
                        <%- sectionOptions %>
                    </select>
                    <select name="teacher_id" style="margin-bottom:0;">
                        <option value="">መምህር ይምረጡ / Select Teacher</option>
                        <%- teacherOptions %>
                    </select>
                </div>
                <button type="submit" class="btn-green" style="width: 100%; margin-top: 12px;">
                    ➕ <span class="am">የትምህርት አይነት ጨምር</span><span class="en">Add Course</span>
                </button>
            </form>

            <div style="overflow-x: auto;">
                <table id="coursesListTable">
                    <tr>
                        <th><span class="am">ኮድ</span><span class="en">Code</span></th>
                        <th><span class="am">የትምህርት ስም</span><span class="en">Course Title</span></th>
                        <th style="display:none;">Cr.Hr</th>
                        <th><span class="am">ክፍል</span><span class="en">Class</span></th>
                        <th><span class="am">መምህር</span><span class="en">Teacher</span></th>
                        <th><span class="am">አጥፋ</span><span class="en">Delete</span></th>
                    </tr>
                    <%- cRows %>
                </table>
            </div>
        </div>

    
        <!-- Academic Year - bottom -->
        <!-- Academic Year (bottom) -->
        <!-- Academic Year -->
        <div class="card" style="border-color: #f39c12;">
            <h3 style="color: #d35400; border-bottom-color: #fce8cd;">🎓 <span class="am">የአካዳሚክ ዓመት ማጠቃለያ</span><span class="en">Academic Year-End Actions</span></h3>
            <p style="font-size: 13px; color: #555;">
                <span class="am">ማሳሰቢያ፦ እነዚህን ተግባራት ከማድረግዎ በፊት እባክዎ የክፍል ውጤቶችን ዳውንሎድ ማድረጎን ያረጋግጡ።</span>
                <span class="en">Note: Please ensure you have downloaded all class reports before proceeding.</span>
            </p>
            <div style="display: flex; gap: 15px; flex-wrap: wrap; margin-top: 15px;">
                <form action="/admin/archive-year" method="POST" onsubmit="return confirm('እርግጠኛ ነዎት? / Are you sure?');">
                    <button type="submit" class="btn-orange">🗂️ <span class="am">1. የዓመቱን ውጤት ቋጥሮ ያዝ</span><span class="en">1. Archive Academic Year</span></button>
                </form>
                <form action="/admin/promote-students" method="POST" onsubmit="return confirm('እርግጠኛ ነዎት? / Are you sure?');">
                    <button type="submit" class="btn-green">🚀 <span class="am">2. ተማሪዎችን ወደ ቀጣይ ክፍል አሳድግ</span><span class="en">2. Promote All Students</span></button>
                </form>
            </div>
    </div>

    <script>
        window.setLang = function setLang(lang) {
            const cleanLang = (lang === 'en') ? 'en' : 'am';
            document.body.className = 'lang-' + cleanLang;
            localStorage.setItem('prefLang', cleanLang);
            
            const btnAm = document.getElementById('btn-am');
            const btnEn = document.getElementById('btn-en');
            if (btnAm && btnEn) {
                btnAm.style.background = cleanLang === 'am' ? '#27ae60' : 'transparent';
                btnAm.style.color = cleanLang === 'am' ? 'white' : '#333';
                
                btnEn.style.background = cleanLang === 'en' ? '#2980b9' : 'transparent';
                btnEn.style.color = cleanLang === 'en' ? 'white' : '#333';
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            const savedLang = localStorage.getItem('prefLang') || 'am';
            setLang(savedLang);

            var quill = null;
            try {
                if (document.getElementById('editor') && window.Quill) {
                    quill = new Quill('#editor', {
                        theme: 'snow',
                        placeholder: 'መልዕክትዎን እዚህ ይጻፉ... / Write message...',
                        modules: {
                            toolbar: [
                                [{ 'font': [] }, { 'size': ['small', false, 'large', 'huge'] }],
                                [{ 'header': [1, 2, 3, false] }],
                                ['bold', 'italic', 'underline', 'strike'],
                                [{ 'color': [] }, { 'background': [] }],
                                [{ 'align': [] }],
                                [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                                ['clean']
                            ]
                        }
                    });
                    window._adminQuill = quill;
                }
            } catch (err) {
                console.error('Quill init failed', err);
                var ed = document.getElementById('editor');
                if (ed) {
                    ed.innerHTML = '<textarea id="editorFallback" style="width:100%;min-height:140px;padding:10px;font-size:15px;" placeholder="Write message..."></textarea>';
                }
            }

            const notifForm = document.getElementById('notifForm');
            if (notifForm) {
                notifForm.addEventListener('submit', function(e) {
                    var hm = document.getElementById('hiddenMessage');
                    if (window._adminQuill) {
                        hm.value = window._adminQuill.root.innerHTML;
                    } else {
                        var fb = document.getElementById('editorFallback');
                        hm.value = fb ? fb.value : '';
                    }
                    if (!hm.value || hm.value === '<p><br></p>') {
                        e.preventDefault();
                        alert('መልዕክት ይጻፉ / Write a message');
                        return;
                    }
                    const indiv = (document.getElementById('individualTargetValue').value || '').trim();
                    const finalField = document.getElementById('finalTargetAudience');
                    const quickVal = document.getElementById('quickTargetSelect') ? document.getElementById('quickTargetSelect').value : 'ALL_STUDENTS';
                    if (indiv && (indiv.startsWith('TEACHER:') || indiv.startsWith('STUDENT:'))) {
                        finalField.value = indiv;
                    } else {
                        finalField.value = quickVal || 'ALL_STUDENTS';
                    }
                    if (!finalField.value) finalField.value = 'ALL_STUDENTS';
                });
            }

            // Keep finalTargetAudience synced when user changes the quick select
            const quickSel = document.getElementById('quickTargetSelect');
            if (quickSel) {
                quickSel.addEventListener('change', function() {
                    document.getElementById('individualTargetValue').value = '';
                    document.getElementById('selectedPersonBox').style.display = 'none';
                    document.getElementById('finalTargetAudience').value = this.value;
                });
                // Set initial value
                document.getElementById('finalTargetAudience').value = quickSel.value;
            }

            // ========== LIVE SEARCH FOR TEACHER / STUDENT ==========
            let peopleData = {teachers:[], students:[]};
            peopleData = {teachers:[], students:[]}; // search uses API
            const searchInput = document.getElementById('peopleSearchInput');
            const resultsBox = document.getElementById('searchResultsBox');
            const selectedBox = document.getElementById('selectedPersonBox');
            const selectedText = document.getElementById('selectedPersonText');
            const individualValue = document.getElementById('individualTargetValue');

            window.clearSelectedPerson = function() {
                individualValue.value = '';
                selectedBox.style.display = 'none';
                selectedText.textContent = '';
                searchInput.value = '';
                resultsBox.style.display = 'none';
                // Revert to quick select value
                const qs = document.getElementById('quickTargetSelect');
                if (qs) document.getElementById('finalTargetAudience').value = qs.value;
            };

            if (searchInput) {
                function renderPeopleMatches(matches) {
                    if (!matches.length) {
                        resultsBox.style.display = 'block';
                        resultsBox.innerHTML = '<div style="padding:12px;color:#888;">No match</div>';
                        return;
                    }
                    resultsBox.style.display = 'block';
                    resultsBox.innerHTML = matches.slice(0, 25).map(function(m) {
                        return '<div class="people-hit" data-val="'+m.val+'" data-label="'+m.label.replace(/"/g,'&quot;')+'" style="padding:10px 12px;cursor:pointer;border-bottom:1px solid #eee;font-size:14px;">'+m.label+'</div>';
                    }).join('');
                    resultsBox.querySelectorAll('.people-hit').forEach(function(row) {
                        row.addEventListener('click', function() {
                            individualValue.value = row.getAttribute('data-val');
                            selectedText.textContent = row.getAttribute('data-label');
                            selectedBox.style.display = 'block';
                            resultsBox.style.display = 'none';
                            searchInput.value = row.getAttribute('data-label');
                            document.getElementById('finalTargetAudience').value = individualValue.value;
                        });
                    });
                }
                searchInput.addEventListener('input', function() {
                    const q = this.value.trim().toLowerCase();
                    // Live API search (teachers + students)
                    if (q.length >= 1) {
                        fetch('/api/search-students?q='+encodeURIComponent(q), {credentials:'same-origin'})
                          .then(function(r){ return r.json(); })
                          .then(function(d){
                            var m = [];
                            (d.teachers||[]).forEach(function(t){
                              m.push({ val: 'TEACHER:'+t.id, label: '👨‍🏫 '+(t.name||'')+' ('+t.id+')' });
                            });
                            (d.rows||[]).forEach(function(s){
                              m.push({ val: 'STUDENT:'+s.student_id, label: '🎓 '+(s.name||'')+' ('+s.student_id+')' });
                            });
                            if (m.length) renderPeopleMatches(m);
                          }).catch(function(){});
                    }
                    if (q.length < 1) {
                        resultsBox.style.display = 'none';
                        resultsBox.innerHTML = '';
                        return;
                    }

                    const matches = [];
                    (peopleData.teachers || []).forEach(t => {
                        if (t.name.toLowerCase().includes(q) || t.id.toLowerCase().includes(q)) {
                            matches.push({ ...t, label: `👩‍🏫 መምህር: ${t.name} (${t.id})`, value: `TEACHER:${t.id}` });
                        }
                    });
                    (peopleData.students || []).forEach(s => {
                        if (s.name.toLowerCase().includes(q) || s.id.toLowerCase().includes(q)) {
                            matches.push({ ...s, label: `👨‍🎓 ተማሪ: ${s.name} (${s.id})`, value: `STUDENT:${s.id}` });
                        }
                    });

                    if (matches.length === 0) {
                        resultsBox.innerHTML = `<div style="padding:12px; color:#777;">ምንም አልተገኘም / No results</div>`;
                    } else {
                        resultsBox.innerHTML = matches.slice(0, 15).map(m => `
                            <div class="search-result-item" data-value="${m.value}" data-label="${m.label}"
                                 style="padding:11px 14px; cursor:pointer; border-bottom:1px solid #eee; font-size:14px;"
                                 onmouseover="this.style.background='#e3f2fd'" onmouseout="this.style.background='white'">
                                ${m.label}
                            </div>
                        `).join('');
                    }
                    resultsBox.style.display = 'block';

                    resultsBox.querySelectorAll('.search-result-item').forEach(item => {
                        item.addEventListener('click', function() {
                            const val = this.getAttribute('data-value');
                            individualValue.value = val;
                            document.getElementById('finalTargetAudience').value = val;
                            selectedText.textContent = this.getAttribute('data-label');
                            selectedBox.style.display = 'block';
                            searchInput.value = '';
                            resultsBox.style.display = 'none';
                        });
                    });
                });

                // Hide results when clicking outside
                document.addEventListener('click', function(e) {
                    if (!searchInput.contains(e.target) && !resultsBox.contains(e.target)) {
                        resultsBox.style.display = 'none';
                    }
                });
            }

            const rawSelect = document.getElementById("rawSectionOptionsSource");
            const regGrid = document.getElementById("regSectionCheckboxes");
            const handGrid = document.getElementById("handoverSectionCheckboxes");
            const regInput = document.getElementById("regAssignedSectionsInput");
            const handInput = document.getElementById("handoverSectionsInput");

            if (rawSelect) {
                Array.from(rawSelect.options).forEach(opt => {
                    const val = opt.value.trim();
                    const text = opt.textContent.trim();
                    if (!val) return;

                    if (regGrid) {
                        regGrid.innerHTML += `<label class="sec-chk-label"><input type="checkbox" class="reg-sec-chk" value="${val}"> <span>${text}</span></label>`;
                    }
                    if (handGrid) {
                        handGrid.innerHTML += `<label class="sec-chk-label"><input type="checkbox" class="hand-sec-chk" value="${val}"> <span>${text}</span></label>`;
                    }
                });

                document.querySelectorAll(".reg-sec-chk").forEach(chk => {
                    chk.addEventListener("change", () => {
                        const selected = Array.from(document.querySelectorAll(".reg-sec-chk:checked")).map(c => c.value);
                        regInput.value = selected.join(", ");
                    });
                });

                document.querySelectorAll(".hand-sec-chk").forEach(chk => {
                    chk.addEventListener("change", () => {
                        const selected = Array.from(document.querySelectorAll(".hand-sec-chk:checked")).map(c => c.value);
                        handInput.value = selected.join(", ");
                    });
                });
            }

            const table = document.getElementById("teachersListTable");
            const oldSel = document.getElementById("oldTeacherSelect");
            const newSel = document.getElementById("newTeacherSelect");
            if (table && oldSel && newSel) {
                table.querySelectorAll("tr").forEach((row, index) => {
                    if (index === 0) return;
                    const cells = row.querySelectorAll("td");
                    if (cells.length >= 2) {
                        const tId = cells[0].innerText.trim();
                        const tName = cells[1].innerText.trim();
                        if (tId && !tId.includes("ምንም")) {
                            oldSel.innerHTML += `<option value="${tId}">${tName} (${tId})</option>`;
                            newSel.innerHTML += `<option value="${tId}">${tName} (${tId})</option>`;
                        }
                    }
                });
            }

            const coursesTable = document.getElementById("coursesListTable");
            if (coursesTable) {
                coursesTable.querySelectorAll("tr").forEach((tr, rIdx) => {
                    if (rIdx === 0) return;
                    const tds = tr.querySelectorAll("td");
                    if (tds.length >= 6 && tds[2]) {
                        tds[2].style.display = "none";
                    }
                });
            }

            fetch('/api/admin/roster-summary')
                .then(r => r.json())
                .then(data => {
                    const subBox = document.getElementById('submittedClassesButtons');
                    if (data.submissions && data.submissions.length > 0) {
                        subBox.innerHTML = data.submissions.map(s => `
                            <a href="/admin/master-roster/${encodeURIComponent(s.academic_year)}/${encodeURIComponent(s.class_level)}" target="_blank"
                               style="background:#27ae60; color:white; padding:10px 16px; border-radius:8px; text-decoration:none; font-size:13.5px; font-weight:bold; box-shadow:0 3px 8px rgba(39,174,96,0.25); display:inline-block;">
                                🏫 ${s.class_level} | 📘 ${s.course_title} <br>
                                <small style="color:#eafaf1;">👨‍🏫 መምህር: ${s.teacher_name} | 📅 ${s.academic_year}</small>
                            </a>
                        `).join('');
                    } else {
                        subBox.innerHTML = `<span style="color:#7f8c8d; font-size:13.5px;">እስካሁን መምህራን Submit ያደረጉት ክፍል የለም።</span>`;
                    }
                });

            // ===== Unread Badge =====
            function refreshUnreadBadge() {
                fetch('/api/unread-count').then(r => r.json()).then(d => {
                    const badge = document.getElementById('unreadBadge');
                    if (badge) {
                        if (d.count > 0) {
                            badge.textContent = d.count;
                            badge.classList.add('show');
                        } else {
                            badge.classList.remove('show');
                        }
                    }
                }).catch(() => {});
            }
            refreshUnreadBadge();
            setInterval(refreshUnreadBadge, 30000);

            // Mark notifications as read when viewing the list
            document.querySelectorAll('[id^="editNotif_"], [id^="replyNotif_"]').forEach(el => {
                const id = el.id.replace(/^(editNotif_|replyNotif_)/, '');
                if (id) fetch('/api/mark-read/' + id, { method: 'POST' }).catch(() => {});
            });

            // ===== Charts =====
            const maleC = <%= typeof maleCount !== 'undefined' ? maleCount : 0 %>;
            const femaleC = <%= typeof femaleCount !== 'undefined' ? femaleCount : 0 %>;
            const exc = <%= typeof excellent !== 'undefined' ? excellent : 0 %>;
            const good = <%= typeof good !== 'undefined' ? good : 0 %>;
            const avg = <%= typeof average !== 'undefined' ? average : 0 %>;
            const poor = <%= typeof poor !== 'undefined' ? poor : 0 %>;

            if (typeof Chart !== 'undefined') {
                new Chart(document.getElementById('genderChart'), {
                    type: 'doughnut',
                    data: {
                        labels: ['Male', 'Female'],
                        datasets: [{ data: [maleC, femaleC], backgroundColor: ['#3498db', '#e84393'] }]
                    },
                    options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
                });
                new Chart(document.getElementById('gradeChart'), {
                    type: 'bar',
                    data: {
                        labels: ['Excellent 90+', 'Good 75+', 'Average 50+', 'Poor <50'],
                        datasets: [{ label: 'Count', data: [exc, good, avg, poor], backgroundColor: ['#27ae60', '#2980b9', '#f39c12', '#e74c3c'] }]
                    },
                    options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
                });
                // Class chart - simple placeholder from stats
                new Chart(document.getElementById('classChart'), {
                    type: 'pie',
                    data: {
                        labels: ['Total Students'],
                        datasets: [{ data: [maleC + femaleC || 1], backgroundColor: ['#8e44ad'] }]
                    },
                    options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
                });
            }
        });

        // ===== Dark Mode =====
        function toggleDark() {
            document.body.classList.toggle('dark');
            const isDark = document.body.classList.contains('dark');
            localStorage.setItem('darkMode', isDark ? '1' : '0');
            document.getElementById('darkToggle').textContent = isDark ? '☀️ Light' : '🌙 Dark';
        }
        if (localStorage.getItem('darkMode') === '1') {
            document.body.classList.add('dark');
            const btn = document.getElementById('darkToggle');
            if (btn) btn.textContent = '☀️ Light';
        }
    
    // Stay in place after save/send/reply (no jump to top)
    (function(){
        const KEY = 'scrollPos_' + location.pathname;
        const saved = sessionStorage.getItem(KEY);
        if (saved) {
            const y = parseInt(saved, 10);
            if (!isNaN(y)) {
                requestAnimationFrame(function(){ window.scrollTo(0, y); });
                setTimeout(function(){ window.scrollTo(0, y); }, 50);
                setTimeout(function(){ window.scrollTo(0, y); }, 200);
            }
            sessionStorage.removeItem(KEY);
        }
        function saveScroll(){ sessionStorage.setItem(KEY, String(window.scrollY || window.pageYOffset || 0)); }
        document.addEventListener('submit', function(e){
            const f = e.target;
            if (!f || f.tagName !== 'FORM') return;
            // AJAX forms handle themselves
            if (f.classList.contains('ajax-grade-form') || f.id === 'studentChatForm' || f.id === 'chatForm') return;
            saveScroll();
        }, true);
        document.addEventListener('click', function(e){
            const a = e.target.closest && e.target.closest('a[href]');
            if (!a) return;
            const href = a.getAttribute('href') || '';
            if (href.indexOf('/admin/approve/') === 0 || href.indexOf('/admin/reject/') === 0 ||
                href.indexOf('/delete-notification/') === 0 || href.indexOf('/edit-notification/') === 0) {
                saveScroll();
            }
        }, true);
    })();


    // Toast + loading + file preview + table search
    (function(){
        if (!document.querySelector('.toast-wrap')) {
            const w = document.createElement('div');
            w.className = 'toast-wrap';
            document.body.appendChild(w);
        }
        window.showToast = function(msg, type) {
            const w = document.querySelector('.toast-wrap');
            const t = document.createElement('div');
            t.className = 'toast' + (type === 'err' ? ' err' : type === 'info' ? ' info' : '');
            t.textContent = msg;
            w.appendChild(t);
            setTimeout(() => { t.remove(); }, 3200);
        };
        // Loading on non-AJAX form submit
        document.addEventListener('submit', function(e) {
            const f = e.target;
            if (!f || f.tagName !== 'FORM') return;
            if (f.classList.contains('ajax-grade-form') || f.id === 'studentChatForm' || f.id === 'chatForm') return;
            const btn = f.querySelector('button[type="submit"]');
            if (btn) { btn.classList.add('btn-loading'); btn.disabled = true; }
        }, true);
        // File preview for /uploads/ links
        document.addEventListener('click', function(e) {
            const a = e.target.closest && e.target.closest('a[href*="/uploads/"]');
            if (!a) return;
            const href = a.getAttribute('href') || '';
            if (!/\.(jpg|jpeg|png|gif|webp|pdf)(\?|$)/i.test(href) && href.indexOf('/uploads/') === -1) return;
            // preview images
            if (/\.(jpg|jpeg|png|gif|webp)(\?|$)/i.test(href)) {
                e.preventDefault();
                let m = document.getElementById('filePreviewModal');
                if (!m) {
                    m = document.createElement('div');
                    m.id = 'filePreviewModal';
                    m.className = 'preview-modal';
                    m.innerHTML = '<div class="box"><button type="button" class="close" onclick="document.getElementById(\'filePreviewModal\').classList.remove(\'show\')">×</button><img id="previewImg" src=""></div>';
                    document.body.appendChild(m);
                    m.addEventListener('click', function(ev){ if (ev.target === m) m.classList.remove('show'); });
                }
                document.getElementById('previewImg').src = href;
                m.classList.add('show');
            }
        });
        // Table search: input.search-box data-table="tableId"
        document.querySelectorAll('.search-box[data-table]').forEach(function(inp) {
            inp.addEventListener('input', function() {
                const q = (inp.value || '').toLowerCase();
                const table = document.getElementById(inp.getAttribute('data-table'));
                if (!table) return;
                table.querySelectorAll('tr').forEach(function(tr, i) {
                    if (i === 0 && tr.querySelector('th')) return;
                    tr.style.display = !q || tr.textContent.toLowerCase().indexOf(q) !== -1 ? '' : 'none';
                });
            });
        });
        // Empty states
        document.querySelectorAll('table[data-empty]').forEach(function(table) {
            const rows = table.querySelectorAll('tr');
            const dataRows = Array.from(rows).filter(r => !r.querySelector('th'));
            if (dataRows.length === 0) {
                const wrap = document.createElement('div');
                wrap.className = 'empty-state';
                wrap.innerHTML = '<span class="ico">📭</span>' + (table.getAttribute('data-empty') || 'No data');
                table.parentNode.insertBefore(wrap, table.nextSibling);
            }
        });
    })();

    // Widgets: pending count from table rows, unread, activity log
    (function(){
        const pt = document.getElementById('pendingTable');
        if (pt) {
            const n = pt.querySelectorAll('tr').length - 1;
            const el = document.getElementById('wPending');
            if (el) el.textContent = Math.max(0, n);
        }
        fetch('/api/unread-count').then(r=>r.json()).then(d=>{
            const el = document.getElementById('wUnread');
            if (el) el.textContent = d.count || 0;
        }).catch(()=>{});
        fetch('/api/activity-log').then(r=>r.json()).then(d=>{
            const t = document.getElementById('activityTable');
            if (!t) return;
            (d.rows||[]).forEach(row => {
                const tr = document.createElement('tr');
                tr.innerHTML = '<td>'+(row.created_at||'')+'</td><td>'+(row.actor_role||'')+' '+(row.actor_name||'')+'</td><td>'+(row.action||'')+'</td><td style="text-align:left">'+(row.details||'')+'</td>';
                t.appendChild(tr);
            });
            if (!(d.rows||[]).length) {
                const tr = document.createElement('tr');
                tr.innerHTML = '<td colspan="4"><div class="empty-state"><span class="ico">📭</span>No activity yet</div></td>';
                t.appendChild(tr);
            }
        }).catch(()=>{});
        // Toast after hash actions
        if (location.hash === '#pending-approvals') showToast('✅ Pending list updated', 'info');
        if (location.hash === '#fees') { if (typeof openAdminPanel==='function') openAdminPanel('fees'); showToast('Fee ledger', 'info'); }
        if (location.hash === '#examSchedule') { if (typeof openAdminPanel==='function') openAdminPanel('examSchedule'); }
        if (location.hash === '#notifications') showToast('💬 Notifications updated', 'info');
        fetch('/api/fees').then(r=>r.json()).then(d=>{
            const el=document.getElementById('feeList');
            if(!el) return;
            el.innerHTML='<table style="font-size:12px;width:100%"><tr><th>ID</th><th>Name</th><th>Amt</th><th>Paid</th><th>Status</th><th>Edit</th></tr>'
              +(d.rows||[]).slice(0,30).map(function(f){
                return '<tr><td>'+f.student_id+'</td><td>'+f.student_name+'</td><td>'+f.amount+'</td><td>'+f.paid+'</td><td>'+f.status+'</td>'
                  +'<td style="min-width:200px;"><form action="/admin/fee-edit" method="POST" style="display:flex;flex-wrap:wrap;gap:3px;align-items:center;">'
                  +'<input type="hidden" name="id" value="'+f.id+'">'
                  +'<input name="amount" type="number" step="any" value="'+f.amount+'" style="width:60px;padding:3px;font-size:11px;">'
                  +'<input name="paid" type="number" step="any" value="'+f.paid+'" style="width:60px;padding:3px;font-size:11px;">'
                  +'<input name="description" value="'+(f.description||'')+'" style="width:80px;padding:3px;font-size:11px;">'
                  +'<button type="submit" style="padding:3px 6px;font-size:11px;background:#2980b9;">✏️</button></form>'
                  +'<form action="/admin/fee-delete" method="POST" onsubmit="return confirm(\'Delete fee?');" style="display:inline;">'
                  +'<input type="hidden" name="id" value="'+f.id+'"><button type="submit" style="padding:3px 6px;font-size:11px;background:#e74c3c;">🗑️</button></form></td></tr>';
              }).join('')
              +'</table>';
        }).catch(()=>{});

        // ===== Timetable Excel Grid =====
        window._ttDays = ['Monday','Tuesday','Wednesday','Thursday','Friday'];
        window._ttTimes = {1:'8:00–8:45',2:'8:45–9:30',3:'9:30–10:15',4:'10:15–11:00',5:'11:00–11:45',6:'11:45–12:30'};
        window.buildTTGrid = function(grid) {
            const tb = document.querySelector('#ttGrid tbody');
            if (!tb) return;
            tb.innerHTML = '';
            for (let p = 1; p <= 6; p++) {
                const tr = document.createElement('tr');
                let html = '<td style="white-space:nowrap;vertical-align:top;"><b>P'+p+'</b><br><small style="color:#64748b">'+(window._ttTimes[p]||'')+'</small></td>';
                window._ttDays.forEach(function(day) {
                    const c = (grid && grid[day] && grid[day][p]) ? grid[day][p] : {subject:'',teacher:'',room:''};
                    const esc = function(s){ return String(s||'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;'); };
                    html += '<td style="min-width:110px;vertical-align:top;">'
                      + '<input data-day="'+day+'" data-p="'+p+'" data-f="subject" placeholder="Subject" value="'+esc(c.subject)+'" style="width:100%;margin:2px 0;padding:6px;font-size:12px;box-sizing:border-box;">'
                      + '<input data-day="'+day+'" data-p="'+p+'" data-f="teacher" placeholder="Teacher" value="'+esc(c.teacher)+'" style="width:100%;margin:2px 0;padding:6px;font-size:12px;box-sizing:border-box;">'
                      + '</td>';
                });
                tr.innerHTML = html;
                tb.appendChild(tr);
            }
        };
        window.loadTTGrid = function() {
            const cls = (document.getElementById('ttClass').value || '').trim();
            if (!cls) { if (window.showToast) showToast('Section ያስገቡ e.g. Grade 5A', 'err'); else alert('Enter section'); return; }
            fetch('/api/timetable?class=' + encodeURIComponent(cls), { credentials: 'same-origin' })
              .then(function(r){ return r.json(); })
              .then(function(d){
                  window.buildTTGrid(d.grid || {});
                  if (window.showToast) showToast('Timetable loaded', 'info');
              })
              .catch(function(){ if (window.showToast) showToast('Load failed', 'err'); });
        };
        window.saveTTGrid = function() {
            const cls = (document.getElementById('ttClass').value || '').trim();
            if (!cls) { if (window.showToast) showToast('Section ያስገቡ', 'err'); else alert('Enter section'); return; }
            const grid = {};
            window._ttDays.forEach(function(d){ grid[d] = {}; });
            document.querySelectorAll('#ttGrid input').forEach(function(inp) {
                const day = inp.getAttribute('data-day');
                const p = inp.getAttribute('data-p');
                const f = inp.getAttribute('data-f');
                if (!grid[day][p]) grid[day][p] = { subject: '', teacher: '', room: '' };
                grid[day][p][f] = inp.value;
            });
            fetch('/admin/timetable-grid', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ class_level: cls, grid: grid })
            })
            .then(function(r){ return r.json(); })
            .then(function(d){
                if (d.success) { if (window.showToast) showToast('✅ Saved ('+d.saved+' slots)'); else alert('Saved'); }
                else { if (window.showToast) showToast('Save failed', 'err'); else alert('Failed'); }
            })
            .catch(function(){ if (window.showToast) showToast('Network error', 'err'); });
        };
        // Build empty grid on page load so cells are visible
        window.buildTTGrid({});
        window.loadExamCalendar = function(){
            fetch('/api/exam-schedule').then(r=>r.json()).then(d=>{
                var cal=document.getElementById('examCalendar');
                var el=document.getElementById('examList');
                var rows=d.rows||[];
                var table = '<div style="overflow-x:auto;"><table style="font-size:13px;width:100%;min-width:640px;"><thead><tr>'
                  +'<th>Date</th><th>Time</th><th>Class</th><th>Subject</th><th>Notes</th><th>Edit / Delete</th></tr></thead><tbody>';
                if(!rows.length){
                    table += '<tr><td colspan="6">No exams yet</td></tr>';
                } else {
                    rows.forEach(function(x){
                        table += '<tr>'
                          +'<td colspan="6" style="padding:0;border:none;">'
                          +'<form action="/admin/exam-edit" method="POST" style="display:grid;grid-template-columns:110px 90px 1fr 1fr 1fr auto auto;gap:6px;align-items:center;padding:8px;border-bottom:1px solid #e2e8f0;">'
                          +'<input type="hidden" name="id" value="'+x.id+'">'
                          +'<input name="exam_date" type="date" value="'+(x.exam_date||'')+'" style="padding:6px;font-size:12px;">'
                          +'<input name="exam_time" value="'+(x.exam_time||'')+'" style="padding:6px;font-size:12px;">'
                          +'<input name="class_level" value="'+(x.class_level||'')+'" style="padding:6px;font-size:12px;">'
                          +'<input name="subject" value="'+(x.subject||'')+'" style="padding:6px;font-size:12px;">'
                          +'<input name="notes" value="'+(x.notes||'')+'" style="padding:6px;font-size:12px;">'
                          +'<button type="submit" style="padding:6px 10px;font-size:12px;background:#2980b9;color:#fff;border:none;border-radius:6px;">✏️ Update</button>'
                          +'</form></td></tr>'
                          +'<tr><td colspan="6" style="padding:0 8px 8px;border:none;text-align:right;">'
                          +'<form action="/admin/exam-delete" method="POST" style="display:inline;" onsubmit="return confirm(\'Delete?\');">'
                          +'<input type="hidden" name="id" value="'+x.id+'">'
                          +'<button type="submit" style="padding:4px 10px;font-size:11px;background:#e74c3c;color:#fff;border:none;border-radius:6px;">🗑️ Delete</button></form>'
                          +'</td></tr>';
                    });
                }
                table += '</tbody></table></div>';
                if(cal) cal.innerHTML = table;
                if(el) el.innerHTML = '';
            }).catch(function(){});
        };
        loadExamCalendar();

        // Report card: name search → select → then open
        (function(){
            var inp = document.getElementById('rcNameSearch');
            var box = document.getElementById('rcNameResults');
            var idInp = document.getElementById('rcStudentId');
            var nameHid = document.getElementById('rcNameHidden');
            if (!inp || !box) return;
            var timer = null;
            inp.addEventListener('input', function(){
                clearTimeout(timer);
                nameHid.value = '';
                timer = setTimeout(function(){
                    var q = (inp.value||'').trim();
                    if (q.length < 2) { box.style.display='none'; box.innerHTML=''; return; }
                    fetch('/api/search-students?q='+encodeURIComponent(q), {credentials:'same-origin'})
                      .then(function(r){ return r.json(); })
                      .then(function(d){
                        var rows = d.rows || [];
                        if (!rows.length) {
                            box.style.display='block';
                            box.innerHTML='<div style="padding:10px;color:#999;">No match</div>';
                            return;
                        }
                        box.style.display='block';
                        box.innerHTML = rows.map(function(s){
                            return '<button type="button" class="rc-pick" data-id="'+s.student_id+'" data-name="'+(s.name||'').replace(/"/g,'&quot;')+'" style="display:block;width:100%;text-align:left;padding:10px 12px;border:none;border-bottom:1px solid #eee;background:#fff;cursor:pointer;font-size:13px;">'
                              +'<b>'+(s.name||'')+'</b> <span style="color:#64748b;">('+(s.student_id||'')+')</span> '
                              +'<small style="color:#94a3b8;">'+(s.class_level||'')+'</small></button>';
                        }).join('');
                        box.querySelectorAll('.rc-pick').forEach(function(btn){
                            btn.addEventListener('click', function(){
                                idInp.value = btn.getAttribute('data-id') || '';
                                nameHid.value = btn.getAttribute('data-name') || '';
                                inp.value = btn.getAttribute('data-name') || '';
                                box.style.display='none';
                                box.innerHTML='';
                                if (window.showToast) showToast('Selected: '+idInp.value, 'info');
                            });
                        });
                      }).catch(function(){});
                }, 280);
            });
            var form = document.getElementById('reportCardForm');
            if (form) {
                form.addEventListener('submit', function(e){
                    if (!(idInp.value||'').trim() && !(nameHid.value||'').trim()) {
                        e.preventDefault();
                        if (window.showToast) showToast('ስም ይምረጡ ወይም ID ያስገቡ', 'err');
                        else alert('Select a student or enter ID');
                    }
                });
            }
        })();


        document.querySelectorAll('#bottomLinks a[href^="#"]').forEach(function(a) {
            a.addEventListener('click', function(e) {
                var id = (a.getAttribute('href') || '').replace('#','');
                if (id && document.getElementById(id)) {
                    e.preventDefault();
                    openAdminPanel(id);
                    history.replaceState(null,'','#'+id);
                }
            });
        });
        if (location.hash && location.hash.length > 1) {
            var hid = location.hash.replace('#','');
            if (document.getElementById(hid)) openAdminPanel(hid);
        }

        // Fee name search
        (function(){
            var inp = document.getElementById('feeSearchName');
            if (!inp) return;
            var t = null;
            inp.addEventListener('input', function(){
                clearTimeout(t);
                t = setTimeout(function(){
                    var q = (inp.value||'').trim();
                    if (q.length < 2) { document.getElementById('feeNameResults').innerHTML=''; return; }
                    fetch('/api/search-students?q='+encodeURIComponent(q), {credentials:'same-origin'})
                      .then(r=>r.json()).then(d=>{
                        var box = document.getElementById('feeNameResults');
                        box.innerHTML = (d.rows||[]).slice(0,8).map(function(s){
                          return '<button type="button" style="display:block;width:100%;text-align:left;margin:3px 0;padding:6px;font-size:12px;" onclick="document.getElementById(\'feeStudentId\').value=\''+s.student_id+'\';document.getElementById(\'feeNameResults\').innerHTML=\'\';">'+s.name+' ('+s.student_id+')</button>';
                        }).join('') || '<span style="color:#999">No match</span>';
                      }).catch(()=>{});
                }, 300);
            });
        })();

    })();

</script>

<script>
// ===== Notification: Quill + people search (standalone, runs early) =====
document.addEventListener('DOMContentLoaded', function() {
    // Quill
    try {
        if (window.Quill && document.getElementById('editor')) {
            var q = new Quill('#editor', {
                theme: 'snow',
                placeholder: 'መልዕክትዎን እዚህ ይጻፉ... / Write message...',
                modules: {
                    toolbar: [
                        [{ font: [] }, { size: ['small', false, 'large', 'huge'] }],
                        ['bold', 'italic', 'underline'],
                        [{ color: [] }, { background: [] }],
                        [{ list: 'ordered' }, { list: 'bullet' }],
                        ['clean']
                    ]
                }
            });
            window._adminQuill = q;
        }
    } catch (e) {
        console.error('Quill', e);
        var ed = document.getElementById('editor');
        if (ed) ed.innerHTML = '<textarea id="editorFallback" style="width:100%;min-height:140px;padding:12px;border:none;font-size:15px;" placeholder="Write message..."></textarea>';
    }

    // Form submit
    var form = document.getElementById('notifForm');
    if (form) {
        form.addEventListener('submit', function(e) {
            var hm = document.getElementById('hiddenMessage');
            if (window._adminQuill) hm.value = window._adminQuill.root.innerHTML;
            else {
                var fb = document.getElementById('editorFallback');
                if (fb) hm.value = fb.value;
            }
            var text = (hm.value || '').replace(/<[^>]+>/g, '').trim();
            if (!text) { e.preventDefault(); alert('መልዕክት ይጻፉ'); return; }
            var indiv = (document.getElementById('individualTargetValue') || {}).value || '';
            var finalField = document.getElementById('finalTargetAudience');
            var quick = document.getElementById('quickTargetSelect');
            if (finalField) {
                if (indiv.indexOf('TEACHER:') === 0 || indiv.indexOf('STUDENT:') === 0) finalField.value = indiv;
                else finalField.value = (quick && quick.value) ? quick.value : 'ALL_STUDENTS';
            }
        });
    }

    // People search via API
    var searchInput = document.getElementById('peopleSearchInput');
    var resultsBox = document.getElementById('searchResultsBox');
    var selectedBox = document.getElementById('selectedPersonBox');
    var selectedText = document.getElementById('selectedPersonText');
    var individualValue = document.getElementById('individualTargetValue');
    var timer = null;

    window.clearSelectedPerson = function() {
        if (individualValue) individualValue.value = '';
        if (selectedBox) selectedBox.style.display = 'none';
        if (selectedText) selectedText.textContent = '';
        if (searchInput) searchInput.value = '';
        if (resultsBox) { resultsBox.style.display = 'none'; resultsBox.innerHTML = ''; }
        var qs = document.getElementById('quickTargetSelect');
        var ff = document.getElementById('finalTargetAudience');
        if (qs && ff) ff.value = qs.value;
    };

    if (searchInput && resultsBox) {
        searchInput.addEventListener('input', function() {
            clearTimeout(timer);
            var q = (searchInput.value || '').trim();
            if (q.length < 1) {
                resultsBox.style.display = 'none';
                resultsBox.innerHTML = '';
                return;
            }
            timer = setTimeout(function() {
                fetch('/api/search-students?q=' + encodeURIComponent(q), { credentials: 'same-origin' })
                    .then(function(r) { return r.json(); })
                    .then(function(d) {
                        var html = '';
                        (d.teachers || []).forEach(function(t) {
                            html += '<div data-val="TEACHER:' + t.id + '" data-label="👨‍🏫 ' + (t.name || '') + ' (' + t.id + ')" style="padding:10px 12px;cursor:pointer;border-bottom:1px solid #eee;">👨‍🏫 ' + (t.name || '') + ' <small>(' + t.id + ')</small></div>';
                        });
                        (d.rows || []).forEach(function(s) {
                            html += '<div data-val="STUDENT:' + s.student_id + '" data-label="🎓 ' + (s.name || '') + ' (' + s.student_id + ')" style="padding:10px 12px;cursor:pointer;border-bottom:1px solid #eee;">🎓 ' + (s.name || '') + ' <small>(' + s.student_id + ')</small></div>';
                        });
                        if (!html) html = '<div style="padding:12px;color:#888;">No match</div>';
                        resultsBox.innerHTML = html;
                        resultsBox.style.display = 'block';
                        resultsBox.querySelectorAll('[data-val]').forEach(function(row) {
                            row.onclick = function() {
                                individualValue.value = row.getAttribute('data-val');
                                selectedText.textContent = row.getAttribute('data-label');
                                selectedBox.style.display = 'block';
                                resultsBox.style.display = 'none';
                                searchInput.value = row.getAttribute('data-label');
                                var ff = document.getElementById('finalTargetAudience');
                                if (ff) ff.value = individualValue.value;
                            };
                        });
                    })
                    .catch(function() {
                        resultsBox.innerHTML = '<div style="padding:12px;color:#c00;">Search failed</div>';
                        resultsBox.style.display = 'block';
                    });
            }, 250);
        });
    }

    var quickSel = document.getElementById('quickTargetSelect');
    if (quickSel) {
        quickSel.addEventListener('change', function() {
            if (individualValue) individualValue.value = '';
            if (selectedBox) selectedBox.style.display = 'none';
            var ff = document.getElementById('finalTargetAudience');
            if (ff) ff.value = quickSel.value;
        });
    }
});
</script>

</body>
</html>
