<!DOCTYPE html>
<html lang="am">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Amanuel Light and Life School</title>
    
    <!-- Quill Rich Text Editor (ለማስታወቂያ መጻፊያው ፎንት እና ከለር) -->
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>

    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #eef2f5; margin: 0; padding: 20px; color: #333; }
        .container { max-width: 1200px; margin: auto; }
        h2 { color: #2c3e50; text-align: center; margin-bottom: 30px; font-size: 28px; }
        .card { background: white; padding: 25px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); margin-bottom: 25px; border-top: 4px solid #2980b9; }
        .card h3 { color: #1f4e79; margin-top: 0; margin-bottom: 20px; font-size: 20px; border-bottom: 2px solid #ecf0f1; padding-bottom: 10px; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; background: white; }
        th, td { border: 1px solid #e0e0e0; padding: 12px; text-align: center; font-size: 14px; }
        th { background: #1f4e79; color: white; font-weight: 600; position: sticky; top: 0; }
        tr:nth-child(even) { background: #f8f9fa; }
        tr:hover { background: #e8f4fd; }
        input[type="text"], input[type="number"], select, input[type="file"] { width: 100%; padding: 10px; margin-bottom: 10px; border: 1px solid #ccd1d9; border-radius: 6px; box-sizing: border-box; font-family: inherit; }
        button { background: #3498db; color: white; border: none; padding: 10px 20px; border-radius: 6px; cursor: pointer; font-weight: bold; transition: background 0.3s; }
        button:hover { background: #2980b9; }
        .btn-green { background: #27ae60; } .btn-green:hover { background: #219653; }
        .btn-red { background: #e74c3c; } .btn-red:hover { background: #c0392b; }
        .btn-orange { background: #f39c12; } .btn-orange:hover { background: #d68910; }
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .stats-box { background: #fdfdfd; padding: 15px; border-radius: 8px; border-left: 5px solid #2ecc71; box-shadow: 0 2px 5px rgba(0,0,0,0.05); text-align: center; }
        .logout-btn { display: inline-block; background: #e74c3c; color: white; padding: 10px 20px; text-decoration: none; border-radius: 6px; font-weight: bold; margin-bottom: 20px; }
        #editor { height: 150px; background: white; border-radius: 0 0 6px 6px; }
    </style>
</head>
<body>
    <div class="container">
        <div style="text-align: right;">
            <a href="/logout" class="logout-btn">🚪 ውጣ (Logout)</a>
        </div>

        <h2>👑 የዲሬክተር / አድሚን መቆጣጠሪያ (Admin Dashboard)</h2>

        <!-- 🎓 Academic Year Management Panel (የአዲሱ ዓመት ማጠቃለያ) -->
        <div class="card" style="background: #fffcf5; border-color: #f39c12;">
            <h3 style="color: #d35400; border-bottom-color: #fce8cd;">🎓 የአካዳሚክ ዓመት ማጠቃለያ (Year-End Actions)</h3>
            <p style="font-size: 13px; color: #555;">ማሳሰቢያ፦ እነዚህን ተግባራት ከማድረግዎ በፊት እባክዎ የክፍል ውጤቶችን (PDF/Excel) ዳውንሎድ ማድረጎን ያረጋግጡ።</p>
            
            <div style="display: flex; gap: 15px; flex-wrap: wrap; margin-top: 15px;">
                <form action="/admin/archive-year" method="POST" onsubmit="return confirm('እርግጠኛ ነዎት? ይህ የዘንድሮን ውጤት ወደ ማህደር (Archive) አዛውሮ ፖርታሉን ለቀጣይ ዓመት ዜሮ ያደርገዋል!');">
                    <button type="submit" class="btn-orange">🗂️ 1. የዓመቱን ውጤት ቋጥሮ ያዝ (Archive Year)</button>
                </form>

                <form action="/admin/promote-students" method="POST" onsubmit="return confirm('እርግጠኛ ነዎት? ሁሉም ተማሪዎች ወደ ቀጣይ ክፍል (ለምሳሌ 1ኛ ክፍል ወደ 2ኛ ክፍል) ያድጋሉ!');">
                    <button type="submit" class="btn-green">🚀 2. ተማሪዎችን ወደ ቀጣይ ክፍል አሳድግ (Promote All)</button>
                </form>
            </div>
        </div>

        <!-- 📢 ማስታወቂያ መላኪያ (ከነ Quill Editor) -->
        <div class="card">
            <h3>📢 አዲስ ማስታወቂያ መላኪያ (Send Notification)</h3>
            <form id="notifForm" action="/admin/save-notice" method="POST" enctype="multipart/form-data">
                <label>ለማን ይላክ?</label>
                <select name="target_audience" style="width: 100%; max-width: 300px; display: block; margin-bottom: 15px;">
                    <option value="ALL">ለማንኛውም ሰው (ALL)</option>
                    <%- gradeCheckboxes %> <!-- ክፍል ለመምረጥ የሚረዳ (server.js ከሚያመጣው) -->
                </select>

                <label>መልዕክትዎን ይጻፉ፦</label>
                <!-- የ Quill Editor መያዣ -->
                <div id="editor"></div>
                <input type="hidden" name="message" id="hiddenMessage">

                <label style="display: block; margin-top: 15px;">📎 ፋይል ወይም ፎቶ አያይዝ (አማራጭ):</label>
                <input type="file" name="attachment" style="max-width: 300px; display: block;">

                <button type="submit" style="margin-top: 15px; width: 100%; max-width: 300px;">📩 ማስታወቂያውን ላክ</button>
            </form>
        </div>

        <!-- 🔔 የተላኩ ማስታወቂያዎች ማሳያ -->
        <div class="card">
            <h3>🔔 ቀደም ሲል የተላኩ ማስታወቂያዎች</h3>
            <div style="max-height: 400px; overflow-y: auto;">
                <%- adminNotiRows %>
            </div>
        </div>

        <div class="grid-2">
            <!-- 👨‍🎓 አዲስ ተማሪዎች (Pending) -->
            <div class="card" style="border-color: #27ae60;">
                <h3 style="color: #27ae60; border-bottom-color: #d5f5e3;">🟢 አዲስ አመልካቾች (Pending Approvals)</h3>
                <div style="overflow-x: auto;">
                    <table>
                        <tr><th>#</th><th>ID</th><th>Name</th><th>Payment</th><th>Action</th></tr>
                        <%- pRows %>
                    </table>
                </div>
            </div>

            <!-- 👩‍🏫 መምህራን አስተዳደር -->
            <div class="card" style="border-color: #8e44ad;">
                <h3 style="color: #8e44ad; border-bottom-color: #f4ecf7;">👩‍🏫 መምህራን አስተዳደር (Teachers)</h3>
                <form action="/admin/add-teacher" method="POST" style="margin-bottom: 15px; background: #fafafa; padding: 15px; border-radius: 8px;">
                    <input type="text" name="name" placeholder="Full Name" required>
                    <input type="text" name="phone" placeholder="Phone Number" required>
                    <label style="display:block; margin-bottom:5px;">የሚያስተምሩት ክፍል (ክፍልና ሴክሽን በኮማ ለይተው ይጻፉ):</label>
                    <input type="text" name="assigned_sections" placeholder="ምሳሌ: Grade 1 - Section A, Grade 2 - Section B">
                    <label style="display:block; margin-bottom:5px;">የክፍል ደረጃ (ለማስታወቂያዎች):</label>
                    <div style="margin-bottom: 10px; font-size: 13px;">
                        <%- gradeCheckboxes %>
                    </div>
                    <button type="submit" class="btn-green" style="width: 100%;">➕ አዲስ መምህር መዝግብ</button>
                </form>
                <a href="/admin/export-teachers" class="btn-orange" style="text-decoration:none; display:inline-block; margin-bottom:15px; padding: 8px 15px;">📥 ሁሉንም መምህራን አውርድ (Excel)</a>
                <div style="overflow-x: auto;">
                    <table>
                        <tr><th>ID</th><th>Name</th><th>Grades</th><th>Sections</th><th>Phone</th><th>Pass</th><th>Edit</th><th>Remove</th></tr>
                        <%- tRows %>
                    </table>
                </div>
            </div>
        </div>

        <div class="grid-2">
            <!-- 🏫 ክፍሎች (Sections) አስተዳደር -->
            <div class="card">
                <h3>🏫 የክፍል ሴክሽኖች (Sections)</h3>
                <form action="/admin/add-section" method="POST" style="display: flex; gap: 10px; margin-bottom: 15px;">
                    <input type="text" name="name" placeholder="ምሳሌ: Grade 1 - Section A" required style="margin-bottom: 0;">
                    <button type="submit">➕ ጨምር</button>
                </form>
                <div style="overflow-x: auto;">
                    <table>
                        <tr><th>Section Name</th><th>Proctor (ተቆጣጣሪ)</th><th>Delete</th><th>Actions</th></tr>
                        <%- secRows %>
                    </table>
                </div>
            </div>

            <!-- 📚 የትምህርት አይነቶች (Courses) -->
            <div class="card">
                <h3>📚 የትምህርት አይነቶች (Courses)</h3>
                <form action="/admin/add-course" method="POST" style="background: #fafafa; padding: 15px; border-radius: 8px; margin-bottom: 15px;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                        <input type="text" name="code" placeholder="Course Code (e.g. MATH101)" required>
                        <input type="text" name="title" placeholder="Course Title (e.g. Mathematics)" required>
                        <input type="number" name="credit_hours" placeholder="Credit Hours" required>
                        <select name="class_level" required>
                            <option value="">የትኛውን ክፍል ይምረጡ...</option>
                            <%- sectionOptions %>
                        </select>
                    </div>
                    <select name="teacher_id" style="margin-top: 10px;">
                        <option value="">መምህር ይምረጡ (አማራጭ)</option>
                        <%- teacherOptions %>
                    </select>
                    <button type="submit" class="btn-green" style="width: 100%;">➕ የትምህርት አይነት ጨምር</button>
                </form>
                <div style="overflow-x: auto; max-height: 400px;">
                    <table>
                        <tr><th>Code</th><th>Title</th><th>Cr.Hr</th><th>Class</th><th>Teacher</th><th>Delete</th></tr>
                        <%- cRows %>
                    </table>
                </div>
            </div>
        </div>

        <!-- 📂 አጠቃላይ የዲሬክተር ሪፖርት -->
        <div class="card" style="text-align: center; background: #fdf2e9; border-color: #e67e22;">
            <h3 style="color: #d35400;">📁 የዲሬክተር ሳምንታዊ እና ወርሃዊ ሪፖርት</h3>
            <p>የሁሉም ክፍሎች የመገኘት (Attendance) ሪፖርቶችን በአንድ ላይ ለማየት</p>
            <a href="/director-report" target="_blank" style="display: inline-block; background: #8e44ad; color: white; padding: 12px 25px; text-decoration: none; border-radius: 6px; font-weight: bold; font-size: 16px;">
                📂 ሪፖርቱን ክፈት (View Director Report)
            </a>
        </div>

                <!-- 👨‍🎓 የተማሪዎች ዝርዝር (Grouped by Class) -->
        <div class="card" id="studentsContainer">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #ecf0f1; padding-bottom: 10px; margin-bottom: 20px; flex-wrap: wrap; gap: 10px;">
                <h3 style="margin: 0; border: none; padding: 0;">👨‍🎓 የተመዘገቡ ተማሪዎች ዝርዝር (Registered Students)</h3>
                <a href="/admin/export-students" class="btn-orange" style="text-decoration:none; padding: 8px 15px; border-radius: 5px;">📥 ሁሉንም ዳውንሎድ አድርግ (Excel)</a>
            </div>
            
            <!-- 🔍 ID Search Bar -->
            <div style="margin-bottom: 20px; background: #e8f4fd; padding: 15px; border-radius: 8px; border: 1px solid #3498db;">
                <label style="font-weight: bold; color: #2980b9;">🔍 በተማሪ ID ወይም ስም መፈለጊያ:</label>
                <input type="text" id="searchInput" onkeyup="searchStudent()" placeholder="የተማሪውን መታወቂያ ቁጥር (ID) ያስገቡ... ምሳሌ: ALLS-1234" style="margin-top: 5px; border: 1px solid #3498db; padding: 12px; font-size: 16px; border-radius: 5px;">
            </div>

            <div style="display: flex; gap: 20px; margin-bottom: 20px;">
                <div class="stats-box"><div style="font-size:24px; font-weight:bold; color:#2c3e50;"><%= maleCount || 0 %></div><div>ወንድ ተማሪዎች</div></div>
                <div class="stats-box" style="border-left-color: #e74c3c;"><div style="font-size:24px; font-weight:bold; color:#2c3e50;"><%= femaleCount || 0 %></div><div>ሴት ተማሪዎች</div></div>
            </div>
            
            <!-- ከ server.js የሚመጣው የተማሪዎች ሊስት በክፍል ተከፋፍሎ -->
            <%- groupedStudentsHtml %>
        </div>

        <!-- 🔍 Search Script (ለፍለጋ የሚረዳ ጃቫስክሪፕት) -->
        <script>
        function searchStudent() {
            var input = document.getElementById("searchInput");
            var filter = input.value.toUpperCase();
            var container = document.getElementById("studentsContainer");
            var trs = container.getElementsByTagName("tr");

            for (var i = 0; i < trs.length; i++) {
                var ths = trs[i].getElementsByTagName("th");
                if (ths.length > 0) continue; // ርዕሶቹን ዝለል
                
                var tdID = trs[i].getElementsByTagName("td")[0]; // ID
                var tdName = trs[i].getElementsByTagName("td")[1]; // ስም
                
                if (tdID || tdName) {
                    var txtValueID = tdID.textContent || tdID.innerText;
                    var txtValueName = tdName.textContent || tdName.innerText;
                    
                    if (txtValueID.toUpperCase().indexOf(filter) > -1 || txtValueName.toUpperCase().indexOf(filter) > -1) {
                        trs[i].style.display = ""; // አሳየው
                    } else {
                        trs[i].style.display = "none"; // ደብቀው
                    }
                }       
            }
        }
        </script>

    <!-- የ Quill Editor ስክሪፕት (ማስታወቂያው ፎርም submit ሲደረግ ጽሁፉን ለማንበብ) -->
    <script>
        var quill = new Quill('#editor', {
            theme: 'snow',
            placeholder: 'መልዕክትዎን እዚህ ይጻፉ...',
            modules: {
                toolbar: [
                    [{ 'font': [] }, { 'size': [] }],
                    ['bold', 'italic', 'underline', 'strike'],
                    [{ 'color': [] }, { 'background': [] }],
                    [{ 'script': 'super' }, { 'script': 'sub' }],
                    [{ 'header': '1' }, { 'header': '2' }, 'blockquote', 'code-block'],
                    [{ 'list': 'ordered' }, { 'list': 'bullet' }, { 'indent': '-1' }, { 'indent': '+1' }],
                    [{ 'direction': 'rtl' }, { 'align': [] }],
                    ['link', 'image', 'video', 'formula'],
                    ['clean']
                ]
            }
        });

        // ፎርሙ ሲላክ የ Quill ውበት ያለው ጽሁፍ ወደ hidden input እንዲገባ
        document.getElementById('notifForm').onsubmit = function() {
            var html = document.querySelector('#editor .ql-editor').innerHTML;
            document.getElementById('hiddenMessage').value = html;
        };
    </script>
</body>
</html>
