<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'am' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Portal - Amanuel Light and Life School</title>
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <style>
        :root { --bg:#f4f7f6; --card:#fff; --text:#333; --border:#ddd; --primary:#1f4e79; --even:#f9f9f9; --input:#fff; }
        body.dark { --bg:#0f172a; --card:#1e293b; --text:#e2e8f0; --border:#334155; --primary:#3b82f6; --even:#162032; --input:#0f172a; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: var(--bg); margin: 0; padding: 20px; color: var(--text); transition: background 0.3s; }
        .container { max-width: 950px; margin: auto; }
        .card { background: var(--card); padding: 20px; border-radius: 10px; margin-bottom: 20px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); overflow-x: auto; color: var(--text); }
        h2 { color: var(--primary); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; }
        h3 { color: var(--primary); border-bottom: 2px solid var(--border); padding-bottom: 8px; margin-top: 0; display: flex; align-items: center; gap: 8px; }
        table { width: 100%; border-collapse: collapse; min-width: 600px; margin-top: 10px; }
        th, td { border: 1px solid var(--border); padding: 10px; text-align: center; font-size: 14px; color: var(--text); }
        th { background: var(--primary); color: white; }
        tr:nth-child(even) { background: var(--even); }
        input[type="text"], input[type="file"], input[type="date"], textarea, select { width: 100%; padding: 9px; margin-top: 5px; box-sizing: border-box; border: 1px solid var(--border); border-radius: 6px; background: var(--input); color: var(--text); }
        button { background: #27ae60; color: white; border: none; padding: 10px 18px; border-radius: 6px; cursor: pointer; font-weight: bold; margin-top: 8px; }
        button:hover { background: #219653; }
        .profile-header { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; }
        .profile-img { width: 95px; height: 95px; border-radius: 8px; object-fit: cover; border: 2px solid var(--primary); flex-shrink: 0; }
        .btn-id { background: #8e44ad; color: white; padding: 8px 15px; border-radius: 6px; text-decoration: none; font-weight: bold; display: inline-block; margin-top: 10px; font-size: 13px; }
        .logout-btn { display: inline-block; text-align: center; margin-top: 20px; color: #c0392b; font-weight: bold; font-size: 16px; text-decoration: none; }
        body.lang-am .en { display: none !important; }
        body.lang-am .am { display: inline !important; }
        body.lang-en .am { display: none !important; }
        body.lang-en .en { display: inline !important; }
        #studentEditor { height: 150px; background: var(--card); }
    </style>
</head>
<body class="lang-<%= typeof lang !== 'undefined' ? lang : 'am' %>">
<div class="container">
    <div style="display:flex; justify-content:flex-end; gap:10px; margin-bottom:15px; align-items:center; flex-wrap:wrap;">
        <button type="button" onclick="toggleDark()" id="darkBtn" style="background:#64748b; color:white; padding:7px 12px; border:none; border-radius:6px; font-weight:bold; cursor:pointer;">🌙</button>
        <span style="font-weight:bold; font-size:14px;">🔔 <span id="unreadBadge" style="background:#e74c3c;color:#fff;border-radius:50px;padding:2px 8px;font-size:12px;display:none;">0</span></span>
        <button type="button" onclick="setLang('am')" id="btn-am" style="background:#27ae60; color:white; padding:7px 14px; border:none; border-radius:6px; font-weight:bold; cursor:pointer;">🇪🇹 አማርኛ</button>
        <button type="button" onclick="setLang('en')" id="btn-en" style="background:#7f8c8d; color:white; padding:7px 14px; border:none; border-radius:6px; font-weight:bold; cursor:pointer;">🇬🇧 English</button>
    </div>

    <h2>
        <span><img src="/uploads/logo.jpg" onerror="this.style.display='none'" style="height: 40px; border-radius: 50%; vertical-align: middle; margin-right: 8px;">
            <span class="am">🎓 የተማሪ መቆጣጠሪያ ፖርታል</span><span class="en">🎓 Student Portal</span>
        </span>
        <span style="font-size: 14px; background: #eef2f5; padding: 6px 12px; border-radius: 20px; color: #2c3e50;">
            <span class="am">ክፍል:</span><span class="en">Class:</span> <%= student.class_level %>
        </span>
    </h2>
    
    <!-- Profile & Digital ID -->
    <div class="card profile-header">
        <img src="/uploads/<%= student.photo && student.photo.trim() !== '' ? student.photo : 'default.png' %>" onerror="this.src='/uploads/logo.jpg'" class="profile-img">
        <div style="flex-grow: 1;">
            <h3 style="margin: 0; border: none; padding: 0; color: #2c3e50;">
                <span class="am">ሰላም,</span><span class="en">Hello,</span> <%= student.name %>
            </h3>
            <p style="margin: 6px 0; color: #555; font-size: 14px;">
                <b><span class="am">መታወቂያ (ID):</span><span class="en">ID:</span></b> <%= student.student_id %> | 
                <b><span class="am">ስልክ:</span><span class="en">Phone:</span></b> <%= student.phone || '-' %>
            </p>
            <p style="margin: 4px 0; color: #1f4e79; font-size: 14px; font-weight:bold;">
                🛡️ <span class="am">ተቆጣጣሪ (Proctor):</span><span class="en">Proctor:</span>
                <%= typeof proctorName !== 'undefined' ? proctorName : 'N/A' %>
                <% if (typeof proctorPhone !== 'undefined' && proctorPhone) { %> (📞 <%= proctorPhone %>)<% } %>
            </p>
            <a href="/student/digital-id" target="_blank" class="btn-id">🆔 <span class="am">ዲጂታል መታወቂያ አውርድ</span><span class="en">Download Digital ID</span></a>
            <form action="/student/update-photo" method="POST" enctype="multipart/form-data" style="margin-top: 12px; display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                <input type="file" name="new_photo" accept="image/*" required style="width: auto; padding: 4px; font-size: 12px;">
                <button type="submit" style="padding: 6px 14px; margin: 0; background: #3498db; font-size: 13px;">
                    <span class="am">ፎቶ ቀይር</span><span class="en">Change Photo</span>
                </button>
            </form>
        </div>
    </div>

    <!-- Assessment Grades + Teacher -->
    <div class="card">
        <h3>📊 <span class="am">የትምህርት ውጤቶች (ከመምህር ጋር)</span><span class="en">Assessment Grades (with Teacher)</span></h3>
        <table>
            <tr>
                <th><span class="am">ኮድ</span><span class="en">Code</span></th>
                <th style="text-align: left;"><span class="am">የትምህርት ስም</span><span class="en">Course</span></th>
                <th><span class="am">መምህር</span><span class="en">Teacher</span></th>
                <th>Quiz</th>
                <th>Mid</th>
                <th>Final</th>
                <th><span class="am">ጠቅላላ</span><span class="en">Total</span></th>
                <th><span class="am">ደረጃ</span><span class="en">Grade</span></th>
            </tr>
            <%- gradesHtml || '<tr><td colspan="8" style="color:#777;">ምንም ውጤት አልተመዘገበም / No grades yet</td></tr>' %>
        </table>
    </div>

    <!-- Notifications -->
    <div class="card" style="background: #f8fafc; border: 1px solid #e2e8f0;">
        <h3 style="color: #2980b9;">🔔 <span class="am">የትምህርት ቤት ማስታወቂያዎች</span><span class="en">School Notifications</span></h3>
        <div style="margin-top: 10px;">
            <%- notiRows || '<p style="color: #777; font-style: italic;">ምንም ማስታወቂያ የለም / No notifications</p>' %>
        </div>
    </div>

    <!-- Student Send Message (with rich text) -->
    <div class="card" style="border-top: 4px solid #e67e22;">
        <h3>✉️ <span class="am">መልዕክት ላክ (ለአድሚን / ለመምህር)</span><span class="en">Send Message (to Admin / Teacher)</span></h3>
        <form id="studentMsgForm" action="/admin/send-notification" method="POST" enctype="multipart/form-data">
            <label style="font-weight:bold; font-size:13px; display:block; margin-bottom:6px;">
                <span class="am">ለማን ይላክ?</span><span class="en">Send to:</span>
            </label>
            <select name="target_audience" style="max-width:450px; margin-bottom:12px;">
                <% if (typeof studentMsgOptions !== 'undefined' && studentMsgOptions) { %>
                    <%- studentMsgOptions %>
                <% } else { %>
                    <option value="ADMIN">👑 ለአድሚን / ዲሬክተር (To Admin)</option>
                <% } %>
            </select>

            <label style="font-weight:bold; font-size:13px; display:block; margin-bottom:6px;">
                🎨 <span class="am">መልዕክትዎን ይጻፉ (ከለር፣ ፎንት፣ ሳይዝ)፦</span>
                <span class="en">Write your message (Color, Font, Size):</span>
            </label>
            <div id="studentEditor"></div>
            <input type="hidden" name="message" id="studentHiddenMsg">

            <label style="font-weight:bold; font-size:13px; display:block; margin-top:12px;">
                📎 <span class="am">ፋይል አያይዝ (አማራጭ)</span><span class="en">Attach File (Optional)</span>
            </label>
            <input type="file" name="attachment" style="max-width:300px;">

            <button type="submit" style="background:#e67e22; margin-top:12px;">
                📩 <span class="am">መልዕክት ላክ</span><span class="en">Send Message</span>
            </button>
        </form>
    </div>

    <!-- Absence Request -->
    <div class="card">
        <h3>✉️ <span class="am">የመቅረት / እረፍት ጥያቄ</span><span class="en">Absence / Leave Request</span></h3>
        <form action="/student/absence" method="POST" enctype="multipart/form-data">
            <label style="font-weight: bold; font-size: 13px;"><span class="am">ቀን:</span><span class="en">Date:</span></label>
            <input type="date" name="date" required>
            <label style="font-weight: bold; font-size: 13px; display: block; margin-top: 10px;"><span class="am">ምክንያትዎን ይጻፉ:</span><span class="en">Write your reason:</span></label>
            <textarea name="reason" rows="3" required></textarea>
            <label style="font-weight: bold; font-size: 13px; display: block; margin-top: 10px;"><span class="am">ፋይል (ካለ):</span><span class="en">File (if any):</span></label>
            <input type="file" name="attachment" accept="image/*,.pdf">
            <button type="submit"><span class="am">ፈቃድ ጥያቄ ላክ</span><span class="en">Submit Request</span></button>
        </form>
        <h4 style="margin-top: 25px; color: #2c3e50; font-size: 15px;"><span class="am">የቀረቧቸው ጥያቄዎች</span><span class="en">Request History</span></h4>
        <%- myAbsRows || '<p style="color: #777; font-size: 13px;">ምንም የቀረበ ጥያቄ የለም / No requests</p>' %>
    </div>

    <div style="text-align: center;">
        <a href="/logout" class="logout-btn">🔒 <span class="am">ውጣ</span><span class="en">Logout</span></a>
    </div>
</div>
<script>
    function setLang(l) {
        const clean = (l === 'en') ? 'en' : 'am';
        const isDark = document.body.classList.contains('dark');
        document.body.className = 'lang-' + clean + (isDark ? ' dark' : '');
        localStorage.setItem('prefLang', clean);
        const btnAm = document.getElementById('btn-am');
        const btnEn = document.getElementById('btn-en');
        if (btnAm && btnEn) {
            btnAm.style.background = clean === 'am' ? '#27ae60' : '#7f8c8d';
            btnEn.style.background = clean === 'en' ? '#2980b9' : '#7f8c8d';
        }
    }
    function toggleDark() {
        document.body.classList.toggle('dark');
        localStorage.setItem('darkMode', document.body.classList.contains('dark') ? '1' : '0');
        document.getElementById('darkBtn').textContent = document.body.classList.contains('dark') ? '☀️' : '🌙';
    }
    document.addEventListener('DOMContentLoaded', () => {
        setLang(localStorage.getItem('prefLang') || 'am');
        if (localStorage.getItem('darkMode') === '1') {
            document.body.classList.add('dark');
            document.getElementById('darkBtn').textContent = '☀️';
        }
        if (document.getElementById('studentEditor')) {
            var quill = new Quill('#studentEditor', {
                theme: 'snow',
                placeholder: 'መልዕክትዎን እዚህ ይጻፉ... / Write here...',
                modules: {
                    toolbar: [
                        [{ 'font': [] }, { 'size': ['small', false, 'large', 'huge'] }],
                        ['bold', 'italic', 'underline'],
                        [{ 'color': [] }, { 'background': [] }],
                        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                        ['clean']
                    ]
                }
            });
            document.getElementById('studentMsgForm').addEventListener('submit', function() {
                document.getElementById('studentHiddenMsg').value = quill.root.innerHTML;
            });
        }
        // Unread badge
        fetch('/api/unread-count').then(r => r.json()).then(d => {
            const b = document.getElementById('unreadBadge');
            if (b && d.count > 0) { b.textContent = d.count; b.style.display = 'inline-block'; }
        }).catch(() => {});
    });
    document.addEventListener('contextmenu', e => e.preventDefault());
    document.addEventListener('keydown', e => {
        if (e.key === 'F12' || (e.ctrlKey && e.shiftKey && ['I','i','J','j','C','c'].includes(e.key)) || (e.ctrlKey && ['U','u','S','s'].includes(e.key))) {
            e.preventDefault();
        }
    });
</script>
</body>
</html>
