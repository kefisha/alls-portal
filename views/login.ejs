<!DOCTYPE html>
<html lang="am">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Amanuel Light and Life School</title>
    <style>
        * { box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body {
            margin: 0; padding: 20px; min-height: 100vh;
            background: linear-gradient(135deg, #1f4e79 0%, #0d2b45 100%);
            display: flex; flex-direction: column; align-items: center; justify-content: center;
        }
        /* 🌐 Language Toggle CSS */
        body.lang-am .en { display: none !important; }
        body.lang-am .am { display: inline !important; }
        body.lang-en .am { display: none !important; }
        body.lang-en .en { display: inline !important; }

        .lang-bar {
            background: rgba(255,255,255,0.15); padding: 6px; border-radius: 10px;
            display: flex; gap: 8px; margin-bottom: 18px; backdrop-filter: blur(5px);
        }
        .lang-btn {
            border: none; padding: 8px 18px; border-radius: 7px; font-weight: bold;
            cursor: pointer; font-size: 14px; transition: 0.2s;
        }

        .login-card {
            background: white; width: 100%; max-width: 430px; border-radius: 16px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.3); overflow: hidden; border-top: 6px solid #f39c12;
        }
        .header {
            text-align: center; padding: 25px 20px 15px; background: #f8fafc; border-bottom: 1px solid #e2e8f0;
        }
        .header img {
            width: 80px; height: 80px; border-radius: 50%; object-fit: cover;
            border: 3px solid #f39c12; box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }
        .header h2 { margin: 10px 0 4px; color: #1f4e79; font-size: 21px; }
        .header p { margin: 0; color: #d35400; font-weight: bold; font-size: 13px; }

        .form-body { padding: 25px; }
        label { display: block; font-weight: bold; font-size: 13.5px; color: #2c3e50; margin-bottom: 6px; }
        select, input[type="text"], input[type="password"] {
            width: 100%; padding: 12px; margin-bottom: 16px; border: 1.5px solid #cbd5e1;
            border-radius: 8px; font-size: 15px; outline: none; transition: 0.2s;
        }
        select:focus, input:focus { border-color: #2980b9; box-shadow: 0 0 0 3px rgba(41,128,185,0.15); }

        .btn-login {
            width: 100%; background: #2980b9; color: white; border: none; padding: 13px;
            border-radius: 8px; font-size: 16px; font-weight: bold; cursor: pointer; transition: 0.2s;
        }
        .btn-login:hover { background: #1f4e79; }

        .links-box {
            margin-top: 18px; padding-top: 15px; border-top: 1px solid #e2e8f0;
            display: flex; flex-direction: column; gap: 10px; text-align: center;
        }
        .btn-register {
            display: block; background: #27ae60; color: white; text-decoration: none;
            padding: 12px; border-radius: 8px; font-weight: bold; font-size: 15px;
        }
        .btn-forgot {
            background: #fef9e7; color: #d35400; border: 1px solid #f39c12; padding: 10px;
            border-radius: 8px; font-weight: bold; font-size: 14px; cursor: pointer; text-decoration: none; display: block;
        }
        .error-msg {
            background: #fdecea; color: #c0392b; padding: 10px; border-radius: 6px;
            border-left: 4px solid #e74c3c; margin-bottom: 15px; font-size: 13.5px; font-weight: bold; text-align: center;
        }

        /* Modal for Reset Password */
        .modal-overlay {
            display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.65);
            align-items: center; justify-content: center; padding: 20px; z-index: 999;
        }
        .modal-box {
            background: white; width: 100%; max-width: 400px; border-radius: 14px;
            padding: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); border-top: 6px solid #8e44ad;
        }
    </style>
</head>
<body class="lang-am">

    <!-- 🌐 Language Switcher -->
    <div class="lang-bar">
        <button type="button" id="btn-am" class="lang-btn" onclick="switchPortalLang('am')" style="background:#27ae60; color:white;">🇪🇹 አማርኛ</button>
        <button type="button" id="btn-en" class="lang-btn" onclick="switchPortalLang('en')" style="background:transparent; color:white;">🇬🇧 English</button>
    </div>

    <div class="login-card">
        <div class="header">
            <img src="/uploads/logo.jpg" onerror="this.src='/uploads/logo.png'" alt="School Logo">
            <h2>AMANUEL LIGHT & LIFE SCHOOL</h2>
            <p><span class="am">አማኑኤል ብርሃንና ሕይወት ትምህርት ቤት</span><span class="en">Official School Portal</span></p>
        </div>

        <div class="form-body">
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="error-msg">
                    ❌ <span class="am">የተሳሳተ መታወቂያ ወይም የይለፍ ቃል!</span><span class="en">Invalid Username/ID or Password!</span>
                </div>
            <% } %>

            <form action="/login" method="POST" id="loginForm">
                <label>👤 <span class="am">የተጠቃሚ ሚና ይምረጡ (Role):</span><span class="en">Select User Role:</span></label>
                <select name="role" id="roleSelect" required>
                    <option value="student">👨‍🎓 ተማሪ / ወላጅ (Student / Parent)</option>
                    <option value="teacher">👩‍🏫 መምህር (Teacher)</option>
                    <option value="admin">👑 ዲሬክተር / አድሚን (Director / Admin)</option>
                </select>

                <label>🆔 <span class="am">መታወቂያ ቁጥር / Username:</span><span class="en">ID Number / Username:</span></label>
                <input type="text" name="username" id="usernameInput" placeholder="ምሳሌ: ALLS-1234 / ALLS-T-1234" required>

                <label>🔑 <span class="am">የይለፍ ቃል (PIN / Password):</span><span class="en">Password / PIN:</span></label>
                <input type="password" name="password" id="passwordInput" placeholder="****" required>

                <button type="submit" class="btn-login">
                    🔓 <span class="am">ወደ ፖርታሉ ግባ</span><span class="en">Login to Portal</span>
                </button>
            </form>

            <div class="links-box">
                <button type="button" onclick="openResetModal()" class="btn-forgot">
                    🔑 <span class="am">የይለፍ ቃል ረስተዋል? (Reset Password)</span><span class="en">Forgot Password? (Reset PIN)</span>
                </button>

                <a href="/student-register" id="regLink" class="btn-register">
                    📝 <span class="am">አዲስ ተማሪ ለመመዝገብ እዚህ ይጫኑ</span><span class="en">New Student Registration</span>
                </a>
            </div>
        </div>
    </div>

    <!-- 🔑 Reset Password Modal (Works for Both Students & Teachers) -->
    <div class="modal-overlay" id="resetModal">
        <div class="modal-box">
            <h3 style="margin-top:0; color:#8e44ad; text-align:center;">
                🔑 <span class="am">የይለፍ ቃል ዳግም ማስጀመሪያ</span><span class="en">Reset Your Password / PIN</span>
            </h3>
            <p style="font-size:13px; color:#555; text-align:center; margin-bottom:15px;">
                <span class="am">መታወቂያ ቁጥርዎን (ID) እና በምዝገባ ጊዜ ያስገቡትን ስልክ ቁጥር ያስገቡ፦</span>
                <span class="en">Enter your ID Number and registered Phone Number:</span>
            </p>

            <div id="resetResultBox" style="display:none; padding:12px; border-radius:8px; margin-bottom:15px; text-align:center; font-weight:bold;"></div>

            <form id="resetPassForm" onsubmit="submitPasswordReset(event)">
                <label>🆔 <span class="am">መታወቂያ ቁጥር (Student / Teacher ID):</span><span class="en">ID Number (e.g. ALLS-...):</span></label>
                <input type="text" id="resetIdInput" placeholder="ALLS-1234 ወይም ALLS-T-1234" required>

                <label>📞 <span class="am">ስልክ ቁጥር (Phone Number):</span><span class="en">Registered Phone Number:</span></label>
                <input type="text" id="resetPhoneInput" placeholder="09... / 07..." required>

                <button type="submit" id="resetSubmitBtn" style="width:100%; background:#8e44ad; color:white; border:none; padding:12px; border-radius:8px; font-weight:bold; font-size:15px; cursor:pointer;">
                    🔄 <span class="am">አዲስ የይለፍ ቃል አውጣ</span><span class="en">Generate New PIN</span>
                </button>
                <button type="button" onclick="closeResetModal()" style="width:100%; margin-top:8px; background:#95a5a6; color:white; border:none; padding:10px; border-radius:8px; font-weight:bold; cursor:pointer;">
                    ✖️ <span class="am">ዝጋ</span><span class="en">Close</span>
                </button>
            </form>
        </div>
    </div>

    <script>
        function switchPortalLang(lang) {
            const clean = (lang === 'en') ? 'en' : 'am';
            document.body.className = 'lang-' + clean;
            localStorage.setItem('prefLang', clean);

            const btnAm = document.getElementById('btn-am');
            const btnEn = document.getElementById('btn-en');
            if (btnAm && btnEn) {
                btnAm.style.background = clean === 'am' ? '#27ae60' : 'transparent';
                btnEn.style.background = clean === 'en' ? '#2980b9' : 'transparent';
            }

            const regLink = document.getElementById('regLink');
            if (regLink) regLink.href = '/student-register?lang=' + clean;

            const loginForm = document.getElementById('loginForm');
            if (loginForm) loginForm.action = '/login?lang=' + clean;
        }

        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const initialLang = urlParams.get('lang') || localStorage.getItem('prefLang') || 'am';
            switchPortalLang(initialLang);
        });

        function openResetModal() {
            document.getElementById('resetResultBox').style.display = 'none';
            document.getElementById('resetModal').style.display = 'flex';
        }

        function closeResetModal() {
            document.getElementById('resetModal').style.display = 'none';
        }

        function submitPasswordReset(e) {
            e.preventDefault();
            const idVal = document.getElementById('resetIdInput').value.trim();
            const phoneVal = document.getElementById('resetPhoneInput').value.trim();
            const resBox = document.getElementById('resetResultBox');
            const btn = document.getElementById('resetSubmitBtn');

            btn.disabled = true;
            btn.innerText = '⏳ በመፈለግ ላይ...';

            fetch('/api/recover-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: idVal, phone: phoneVal })
            })
            .then(r => r.json())
            .then(data => {
                btn.disabled = false;
                btn.innerText = '🔄 አዲስ የይለፍ ቃል አውጣ';
                resBox.style.display = 'block';
                if (data.success) {
                    resBox.style.background = '#d4edda';
                    resBox.style.color = '#155724';
                    resBox.style.border = '2px solid #27ae60';
                    resBox.innerHTML = `✅ ተሳክቷል!<br>አዲሱ የይለፍ ቃልዎ (New PIN):<br><span style="font-size:28px; color:#e74c3c; letter-spacing:3px;">${data.newPassword}</span>`;
                } else {
                    resBox.style.background = '#f8d7da';
                    resBox.style.color = '#721c24';
                    resBox.style.border = '1px solid #e74c3c';
                    resBox.innerHTML = `❌ መታወቂያ ቁጥሩ ወይም ስልክ ቁጥሩ አልተገኘም! እባክዎ ትክክለኛ መረጃ ያስገቡ።`;
                }
            })
            .catch(() => {
                btn.disabled = false;
                btn.innerText = '🔄 አዲስ የይለፍ ቃል አውጣ';
                resBox.style.display = 'block';
                resBox.style.background = '#f8d7da';
                resBox.innerHTML = '❌ የኔትወርክ ስህተት ተፈጥሯል!';
            });
        }
    </script>
</body>
</html>
