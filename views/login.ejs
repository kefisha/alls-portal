<!DOCTYPE html>
<html lang="am">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Amanuel Light and Life School - Portal</title>
    <style>
        /* 🎨 አጠቃላይ የጀርባ ቀለም እና ፎንት */
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background: linear-gradient(135deg, #1f4e79 0%, #3498db 100%);
            min-height: 100vh; 
            margin: 0; 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            color: #333; 
        }

        /* 🏫 የትምህርት ቤቱ ርዕስ ንድፍ */
        .header-text { 
            text-align: center; color: white; margin-top: 50px; margin-bottom: 20px;
            text-shadow: 2px 2px 5px rgba(0,0,0,0.3); 
        }
        .header-text h1 { margin: 0; font-size: 2.5em; }

        /* 📦 የካርዶች አጠቃላይ ንድፍ */
        .card { 
            background: white; border-radius: 12px; padding: 30px; 
            box-shadow: 0 10px 25px rgba(0,0,0,0.2); 
            width: 100%; max-width: 450px; margin-bottom: 30px;
        }

        .card h2 { text-align: center; margin-top: 0; color: #2c3e50; border-bottom: 2px solid #ecf0f1; padding-bottom: 10px; margin-bottom: 20px; }

        /* ✍️ የፎርም መጻፊያ ሳጥኖች */
        input[type="text"], input[type="password"], input[type="number"], select { 
            width: 100%; padding: 12px; margin-bottom: 15px; 
            border: 1px solid #ccd1d9; border-radius: 6px; 
            box-sizing: border-box; font-size: 15px; background: #fdfdfd;
        }
        input:focus, select:focus { border-color: #3498db; outline: none; background: white; }

        /* 🔘 ራዲዮ በተን (የተጠቃሚ አይነት መምረጫ) */
        .role-selector {
            display: flex; justify-content: space-around; margin-bottom: 20px; 
            background: #f4f6f9; padding: 10px; border-radius: 8px; border: 1px solid #e0e6ed;
        }
        .role-selector label { font-weight: bold; color: #1f4e79; cursor: pointer; }

        /* 🔘 አዝራሮች (Buttons) */
        button.action-btn { 
            width: 100%; padding: 14px; border: none; border-radius: 6px; 
            color: white; font-weight: bold; font-size: 16px; cursor: pointer; 
            transition: background 0.3s ease;
        }
        .btn-login { background: #e67e22; }
        .btn-login:hover { background: #d35400; }
        
        .btn-register { background: #27ae60; }
        .btn-register:hover { background: #219653; }

        /* 📂 ፋይል ማያያዣ */
        .file-upload { border: 2px dashed #bdc3c7; padding: 10px; text-align: center; border-radius: 6px; margin-bottom: 15px; background: #fafafa; }
    </style>
</head>
<body>
    
    <!-- 🏫 የትምህርት ቤቱ ርዕስ -->
    <div class="header-text">
        <h1>🎓 Amanuel Light and Life School</h1>
        <p>ወደ ትምህርት ቤታችን ፖርታል በሰላም መጡ!</p>
    </div>

    <!-- 🔐 1. መግቢያ ካርድ (Login Section) - ከላይ -->
    <div class="card" style="border-top: 5px solid #e67e22;">
        <h2>🔐 ወደ ፖርታል መግቢያ (Login)</h2>
        <form action="/login" method="POST">
            
            <!-- የተጠቃሚ አይነት መምረጫ (Role Selector) -->
            <div class="role-selector">
                <label><input type="radio" name="role" value="student" checked> ተማሪ</label>
                <label><input type="radio" name="role" value="teacher"> መምህር</label>
                <label><input type="radio" name="role" value="admin"> አድሚን</label>
            </div>

            <label style="font-weight:bold; color:#555; display:block; margin-bottom:5px;">👤 መታወቂያ ቁጥር (ID):</label>
            <input type="text" name="username" placeholder="ALLS-1234 / ADMIN" required>

            <label style="font-weight:bold; color:#555; display:block; margin-bottom:5px;">🔑 የይለፍ ቃል (Password):</label>
            <input type="password" name="password" placeholder="••••••••" required>
            
            <button type="submit" class="action-btn btn-login">ግባ (Login)</button>
        </form>
    </div>

    <!-- 📝 2. የአዲስ ተማሪ መመዝገቢያ (Registration Section) - ከታች -->
    <div class="card" style="border-top: 5px solid #27ae60;">
        <h2>📝 አዲስ ተማሪ ምዝገባ (Register)</h2>
        <form action="/register-student" method="POST" enctype="multipart/form-data">
            
            <input type="text" name="name" placeholder="👤 የተማሪው ሙሉ ስም" required>
            
            <div style="display:flex; gap:10px;">
                <select name="gender" required>
                    <option value="">⚧ ፆታ ይምረጡ</option>
                    <option value="Male">ወንድ</option>
                    <option value="Female">ሴት</option>
                </select>
                <input type="text" name="phone" placeholder="📞 ስልክ ቁጥር" required>
            </div>

            <select name="class_level" required>
                <option value="">🏫 የሚገቡበትን ክፍል ይምረጡ</option>
                <option value="KG 1">KG 1</option>
                <option value="KG 2">KG 2</option>
                <option value="KG 3">KG 3</option>
                <option value="Grade 1">1ኛ ክፍል (Grade 1)</option>
                <option value="Grade 2">2ኛ ክፍል (Grade 2)</option>
                <option value="Grade 3">3ኛ ክፍል (Grade 3)</option>
                <option value="Grade 4">4ኛ ክፍል (Grade 4)</option>
                <option value="Grade 5">5ኛ ክፍል (Grade 5)</option>
                <option value="Grade 6">6ኛ ክፍል (Grade 6)</option>
                <option value="Grade 7">7ኛ ክፍል (Grade 7)</option>
                <option value="Grade 8">8ኛ ክፍል (Grade 8)</option>
            </select>

            <div class="file-upload">
                <label style="font-weight:bold; color:#555; display:block; margin-bottom:5px;">🧾 የባንክ ክፍያ ደረሰኝ ያያይዙ</label>
                <input type="file" name="bank_slip" required style="border:none; padding:0; background:transparent;">
            </div>

            <button type="submit" class="action-btn btn-register">አሁን ተመዝገብ</button>
        </form>
    </div>

</body>
</html>
