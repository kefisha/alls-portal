<style id="ui-2026">
/* ===== ALLS Login · 2026 UI layer (visual only; markup & logic untouched) ===== */
:root{
  --violet:#8b5cf6; --indigo:#6366f1; --pink:#d946ef; --cyan:#22d3ee;
  --grad:linear-gradient(135deg,#6366f1 0%,#8b5cf6 55%,#d946ef 100%);
  --radius:30px; --shadow:0 40px 90px -20px rgba(0,0,0,.65),0 0 0 1px rgba(255,255,255,.04) inset;
}
body{font-family:'Outfit','Noto Sans Ethiopic','Segoe UI',system-ui,sans-serif;-webkit-font-smoothing:antialiased}

/* aurora background */
.bg{background:
  radial-gradient(900px 560px at 8% -10%,rgba(99,102,241,.45),transparent 58%),
  radial-gradient(760px 520px at 96% 6%,rgba(217,70,239,.30),transparent 55%),
  radial-gradient(640px 460px at 55% 112%,rgba(34,211,238,.20),transparent 55%),
  linear-gradient(165deg,#05070f 0%,#0b1020 50%,#090d1c 100%)}
.bg::before{content:"";position:absolute;inset:0;
  background-image:linear-gradient(rgba(255,255,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px);
  background-size:46px 46px;-webkit-mask-image:radial-gradient(ellipse 70% 60% at 50% 38%,#000 20%,transparent 75%);mask-image:radial-gradient(ellipse 70% 60% at 50% 38%,#000 20%,transparent 75%)}
.orb{filter:blur(70px)}
.orb.a{background:rgba(99,102,241,.38)}
.orb.b{background:rgba(217,70,239,.26)}

.wrap{padding:max(24px,env(safe-area-inset-top)) 16px max(40px,env(safe-area-inset-bottom))}

/* language pill */
.lang-pill{background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.12);-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px)}
.lang-pill button.active{background:var(--grad);box-shadow:0 8px 20px -6px rgba(139,92,246,.6)}
.lang-pill button:not(.active):hover{color:#fff}
.install-btn{box-shadow:0 10px 24px -8px rgba(245,197,66,.45)}

/* card with gradient hairline border */
.card{position:relative;background:linear-gradient(170deg,rgba(255,255,255,.10) 0%,rgba(255,255,255,.035) 100%);
  border:1px solid transparent;border-radius:var(--radius);-webkit-backdrop-filter:blur(26px) saturate(1.4);backdrop-filter:blur(26px) saturate(1.4);max-width:460px}
.card::before{content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;pointer-events:none;
  background:linear-gradient(150deg,rgba(255,255,255,.35),rgba(139,92,246,.25) 40%,rgba(255,255,255,.05) 70%,rgba(217,70,239,.35));
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask:linear-gradient(#000 0 0) content-box exclude,linear-gradient(#000 0 0);mask-composite:exclude}
.topbar{max-width:460px}.footer-note{max-width:460px}

/* brand */
.brand{padding:36px 28px 22px}
.brand::before{width:140px;background:linear-gradient(90deg,#f5c542,#8b5cf6,#d946ef)}
.logo-ring{position:relative;width:98px;height:98px;background:none;box-shadow:0 16px 40px -8px rgba(139,92,246,.6)}
.logo-ring::before{content:"";position:absolute;inset:0;border-radius:50%;
  background:conic-gradient(from 0deg,#f5c542,#6366f1,#d946ef,#22d3ee,#f5c542);animation:uiSpin 6s linear infinite}
.logo-ring img{position:relative;z-index:1}
@keyframes uiSpin{to{transform:rotate(360deg)}}
.brand h1{font-size:1.28rem;letter-spacing:.04em;background:linear-gradient(90deg,#fff 0%,#c4b5fd 60%,#f0abfc 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.brand .tag{color:#fcd34d;background:rgba(245,197,66,.10);border-color:rgba(245,197,66,.30)}

/* role selector: squircle tiles + check badge */
.role-grid{gap:12px}
.role-card{border-radius:20px;padding:16px 10px;background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.10);transition:transform .2s,border-color .2s,background .2s,box-shadow .2s}
.role-card:hover{transform:translateY(-2px);border-color:rgba(139,92,246,.6);background:rgba(139,92,246,.10)}
.role-card .ico{font-size:26px;margin-bottom:8px}
.role-card.active{border-color:rgba(167,139,250,.9);background:linear-gradient(160deg,rgba(99,102,241,.32),rgba(217,70,239,.14));
  box-shadow:0 0 0 1px rgba(139,92,246,.5),0 16px 32px -12px rgba(139,92,246,.55)}
.role-card.active::after{content:"✓";position:absolute;top:8px;right:8px;width:20px;height:20px;border-radius:50%;
  display:grid;place-items:center;font-size:11px;font-weight:800;color:#fff;background:var(--grad);box-shadow:0 4px 10px rgba(139,92,246,.6)}

/* inputs */
label.field-label{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:#a5acd0}
.field input{border-radius:16px;padding:15px 16px 15px 46px;background:rgba(5,7,15,.45);border-color:rgba(255,255,255,.12)}
.field input:focus{border-color:rgba(167,139,250,.9);box-shadow:0 0 0 4px rgba(139,92,246,.22);background:rgba(5,7,15,.6)}
.field:focus-within .icon{opacity:1}
.field input:-webkit-autofill,.field input:-webkit-autofill:focus{-webkit-text-fill-color:#f8fafc;-webkit-box-shadow:0 0 0 1000px #0c1022 inset;caret-color:#fff}
.parent-hint{border-radius:16px;background:rgba(99,102,241,.12);border-color:rgba(129,140,248,.35)}

/* buttons */
.btn-login{position:relative;overflow:hidden;border-radius:16px;padding:16px;letter-spacing:.01em;
  background:linear-gradient(135deg,#6366f1 0%,#8b5cf6 55%,#d946ef 100%);box-shadow:0 18px 36px -12px rgba(139,92,246,.7)}
.btn-login::after{content:"";position:absolute;top:0;left:-120%;width:60%;height:100%;
  background:linear-gradient(100deg,transparent,rgba(255,255,255,.35),transparent);transform:skewX(-20deg);transition:left .7s}
.btn-login:hover::after{left:140%}
.btn-login:hover{transform:translateY(-2px);filter:brightness(1.07)}
.btn-login:focus-visible,.btn-register:focus-visible,.btn-forgot:focus-visible,.role-card:focus-within{outline:3px solid rgba(167,139,250,.55);outline-offset:2px}
.btn-register{border-radius:16px;box-shadow:0 14px 28px -12px rgba(16,185,129,.55);transition:transform .2s,filter .2s}
.btn-register:hover{transform:translateY(-1px);filter:brightness(1.06)}
.btn-forgot{border-radius:16px;transition:background .2s}
.btn-forgot:hover{background:rgba(245,197,66,.18)}

/* error + modal */
.error-msg{border-radius:16px;animation:uiShake .45s}
@keyframes uiShake{0%,100%{transform:none}20%{transform:translateX(-6px)}40%{transform:translateX(6px)}60%{transform:translateX(-4px)}80%{transform:translateX(4px)}}
.modal-overlay{background:rgba(3,5,12,.75)}
.modal-box{border-radius:26px;background:linear-gradient(165deg,#161b36,#0a0d1f);border-color:rgba(255,255,255,.12)}
.modal-box input{border-radius:14px}
.modal-actions button{border-radius:14px}
.btn-purple{background:var(--grad)}

@media (max-width:420px){.brand{padding:30px 20px 16px}.role-card{padding:14px 8px}.logo-ring{width:90px;height:90px}}
@media (prefers-reduced-motion:reduce){*{animation:none !important;transition:none !important}}
</style>
