<!DOCTYPE html>
<html lang="am">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teacher Dashboard - Amanuel Light and Life School</title>
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #eef2f5; margin: 0; padding: 20px; color: #333; }
        .container { max-width: 1150px; margin: auto; }
        body.lang-am .en { display: none !important; }
        body.lang-am .am { display: inline !important; }
        body.lang-en .am { display: none !important; }
        body.lang-en .en { display: inline !important; }
        .top-bar { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 20px; background: white; padding: 15px 20px; border-radius: 12px; box-shadow: 0 3px 10px rgba(0,0,0,0.05); }
        .card { background: white; padding: 22px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); margin-bottom: 22px; border-top: 4px solid #2980b9; }
        .card h3 { color: #1f4e79; margin-top: 0; border-bottom: 2px solid #ecf0f1; padding-bottom: 10px; }
        table { width: 100%; border-collapse: collapse; margin-top: 12px; }
        th, td { border: 1px solid #cbd5e1; padding: 10px; text-align: center; font-size: 14px; }
        th { background: #1f4e79; color: white; }
        tr:nth-child(even) { background: #f8fafc; }
        select, input[type="text"], input[type="number"], input[type="file"], textarea {
            width: 100%; padding: 10px; margin-bottom: 10px; border: 1px solid #cbd5e1; border-radius: 6px; box-sizing: border-box; font-family: inherit;
        }
        button { background: #2980b9; color: white; border: none; padding: 10px 18px; border-radius: 6px; font-weight: bold; cursor: pointer; }
        .logout-btn { background: #e74c3c; color: white; padding: 9px 18px; border-radius: 6px; text-decoration: none; font-weight: bold; }
        #teacherEditor { height: 160px; background: white; }
    </style>
</head>
<body class="lang-am">
    <div class="container">
        <div class="top-bar">
            <div>
                <h2 style="margin:0; color:#1f4e79;">👩‍🏫 <span class="am">የመምህራን መቆጣጠሪያ ገጽ</span><span class="en">Teacher Portal Dashboard</span></h2>
                <p style="margin:4px 0 0; color:#555; font-weight:bold;">👤 <%= teacher.name %> (<span style="color:#2980b9;"><%= teacher.id %></span>)</p>
            </div>
            <div style="display:flex; gap:10px; align-items:center;">
                <button type="button" onclick="setLang('am')" id="btn-am" style="background:#27ae60; color:white; padding:7px 14px;">🇪🇹 አማርኛ</button>
                <button type="button" onclick="setLang('en')" id="btn-en" style="background:#7f8c8d; color:white; padding:7px 14px;">🇬🇧 English</button>
                <a href="/logout" class="logout-btn">🚪 <span class="am">ውጣ</span><span class="en">Logout</span></a>
            </div>
        </div>

        <!-- Class & Course Selector -->
        <div class="card" style="border-top-color:#8e44ad;">
            <h3>🏫 <span class="am">ክፍል እና ትምህርት ይምረጡ</span><span class="en">Select Class & Subject</span></h3>
            <form method="GET" action="/teacher-dashboard" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap:12px; align-items:end;">
                <div>
                    <label style="font-weight:bold; font-size:13px;"><span class="am">ክፍል / Section:</span><span class="en">Class / Section:</span></label>
                    <select name="cls" onchange="this.form.submit()" style="margin-bottom:0;"><%- classOptions %></select>
                </div>
                <div>
                    <label style="font-weight:bold; font-size:13px;"><span class="am">የትምህርት ዓይነት / Course:</span><span class="en">Course / Subject:</span></label>
                    <select name="course_id" onchange="this.form.submit()" style="margin-bottom:0;"><%- courseOptions %></select>
                </div>
                <div>
                    <button type="submit" style="width:100%; background:#8e44ad;">🔄 <span class="am">ክፍሉን ክፈት</span><span class="en">Load Class</span></button>
                </div>
            </form>
        </div>

        <%- proctorPanel %>

        <!-- Student Grades Entry -->
        <div class="card" style="border-top-color:#27ae60;">
            <h3>📊 <span class="am">የተማሪዎች ውጤት መሙያ (<%= selectedClass %>)</span><span class="en">Student Assessment & Grades (<%= selectedClass %>)</span></h3>
            <div style="overflow-x:auto;">
                <table>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>ID</th>
                            <th><span class="am">የተማሪ ስም</span><span class="en">Student Name</span></th>
                            <th>Quiz (20%)</th>
                            <th>Mid (30%)</th>
                            <th>Final (50%)</th>
                            <th><span class="am">አስቀምጥ / አስተካክል</span><span class="en">Save / Edit</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        <%- studentRows %>
                    </tbody>
                </table>
            </div>

            <div style="margin-top:20px; padding:15px; background:#f0fdf4; border:2px solid #27ae60; border-radius:10px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
                <div>
                    <strong style="color:#166534; font-size:15px;">📤 <span class="am">የክፍሉን ውጤት ለአድሚን ያስረክቡ፦</span><span class="en">Submit Final Class Grades to Admin:</span></strong>
                </div>
                <form action="/teacher/submit-final-grades" method="POST" style="display:flex; gap:10px; align-items:center; margin:0;">
                    <input type="hidden" name="class_level" value="<%= selectedClass %>">
                    <input type="hidden" name="course_id" value="<%= selectedCourseId %>">
                    <input type="text" name="academic_year" value="2019 E.C" style="width:110px; margin:0; font-weight:bold;">
                    <button type="submit" style="background:#27ae60; padding:10px 20px;">✅ <span class="am">ውጤቱን ለአድሚን አስረክብ</span><span class="en">Submit to Admin</span></button>
                </form>
            </div>
        </div>

        <!-- Teacher Notification Center with Search + Rich Text -->
        <div class="card" style="border-top-color:#e67e22;">
            <h3>📢 <span class="am">ማስታወቂያ መላኪያ (ለአድሚን፣ ለክፍሎቼ ወይም ለተማሪ)</span><span class="en">Send Notification (Admin / My Classes / Student)</span></h3>
            <form id="teacherNotifForm" action="/teacher/send-notification?cls=<%= encodeURIComponent(selectedClass) %>" method="POST" enctype="multipart/form-data">
                
                <label style="font-weight:bold; display:block; margin-bottom:6px;">
                    🎯 <span class="am">1. ቀላል ምርጫ (ለአድሚን / ለክፍሎቼ)</span><span class="en">1. Quick Select:</span>
                </label>
                <select id="teacherQuickTarget" style="max-width:450px; margin-bottom:12px;">
                    <% if (typeof teacherTargetOptions !== 'undefined' && teacherTargetOptions) { %>
                        <%- teacherTargetOptions %>
                    <% } else { %>
                        <option value="ADMIN">👑 ለአድሚን / ዲሬክተር (To Admin)</option>
                        <option value="<%= selectedClass %>">🏫 ለዚህ ክፍል (<%= selectedClass %>)</option>
                    <% } %>
                </select>
                <input type="hidden" name="target_audience" id="teacherFinalTarget" value="ADMIN">

                <!-- Search individual student (only from teacher's classes) -->
                <div style="background:#f0f7ff; border:2px solid #3498db; border-radius:10px; padding:14px; margin-bottom:16px;">
                    <label style="font-weight:bold; display:block; margin-bottom:6px; color:#1f4e79;">
                        🔍 <span class="am">2. ወይም የተማሪ ስም / ID ፈልገው ይላኩ (ከሚያስተምሩባቸው ክፍሎች ብቻ)</span>
                        <span class="en">2. Or search student by name/ID (only your classes)</span>
                    </label>
                    <input type="text" id="teacherSearchInput" placeholder="ስም ወይም ID... (e.g. Bereket or ALLS-5430)"
                           style="max-width:450px; padding:10px; border:1px solid #3498db; border-radius:6px;" autocomplete="off">
                    <div id="teacherSearchResults" style="display:none; max-width:450px; max-height:180px; overflow-y:auto; background:white; border:1px solid #cbd5e1; border-radius:0 0 6px 6px;"></div>
                    <div id="teacherSelectedBox" style="display:none; margin-top:10px; padding:8px 12px; background:#e8f5e9; border:1px solid #27ae60; border-radius:6px; max-width:450px;">
                        <span style="font-weight:bold; color:#1b5e20;">✅ ተመርጧል:</span>
                        <span id="teacherSelectedText" style="font-weight:bold;"></span>
                        <button type="button" onclick="clearTeacherSelection()" style="float:right; background:#e74c3c; color:white; border:none; padding:3px 8px; border-radius:4px; font-size:12px; cursor:pointer;">✕</button>
                    </div>
                    <input type="hidden" id="teacherIndividualTarget" value="">
                </div>

                <label style="font-weight:bold; display:block; margin-bottom:6px;">
                    🎨 <span class="am">መልዕክትዎን ይጻፉ (ከለር፣ ፎንት፣ ሳይዝ፣ Bold)፦</span>
                    <span class="en">Write message (Color, Font, Size, Bold):</span>
                </label>
                <div id="teacherEditor"></div>
                <input type="hidden" name="message" id="teacherHiddenMsg">

                <label style="font-weight:bold; display:block; margin-top:12px; margin-bottom:6px;">
                    📎 <span class="am">ፋይል / ፎቶ አያይዝ (አማራጭ)</span><span class="en">Attach File / Photo (Optional)</span>
                </label>
                <input type="file" name="attachment" style="max-width:350px;">

                <button type="submit" style="background:#e67e22; display:block; margin-top:12px;">
                    📩 <span class="am">ማስታወቂያውን ላክ</span><span class="en">Send Notification</span>
                </button>
            </form>
        </div>

        <!-- Sent Notifications -->
        <div class="card">
            <h3>🔔 <span class="am">እርስዎ የላኳቸው ማስታወቂያዎች (የራስዎን ብቻ ማስተካከል/ማጥፋት ይችላሉ)</span><span class="en">Your Sent Notifications (Edit/Delete own only)</span></h3>
            <div>
                <%- teacherNotiRows || '<p style="color:#777;">ምንም የተላከ ማስታወቂያ የለም። / No sent notifications.</p>' %>
            </div>
        </div>

        <!-- Absence Requests -->
        <div class="card">
            <h3>📝 <span class="am">የተማሪዎች የፈቃድ ጥያቄዎች</span><span class="en">Student Absence Requests</span></h3>
            <table>
                <tr><th>Student</th><th>Date</th><th>Reason</th><th>Feedback</th></tr>
                <%- absRows || '<tr><td colspan="4">ምንም የፈቃድ ጥያቄ የለም። / No requests.</td></tr>' %>
            </table>
        </div>
    </div>

    <script>
        function setLang(l) {
            const clean = (l === 'en') ? 'en' : 'am';
            document.body.className = 'lang-' + clean;
            localStorage.setItem('prefLang', clean);
            const btnAm = document.getElementById('btn-am');
            const btnEn = document.getElementById('btn-en');
            if (btnAm && btnEn) {
                btnAm.style.background = clean === 'am' ? '#27ae60' : '#7f8c8d';
                btnEn.style.background = clean === 'en' ? '#2980b9' : '#7f8c8d';
            }
        }

        // Students in current class for search (passed from server if available)
        const teacherStudentsData = <%- typeof teacherStudentsJson !== 'undefined' ? teacherStudentsJson : '[]' %>;

        document.addEventListener('DOMContentLoaded', () => {
            setLang(localStorage.getItem('prefLang') || 'am');

            // Quill rich text
            if (document.getElementById('teacherEditor')) {
                var quill = new Quill('#teacherEditor', {
                    theme: 'snow',
                    placeholder: 'መልዕክትዎን እዚህ ይጻፉ... / Write your message...',
                    modules: {
                        toolbar: [
                            [{ 'font': [] }, { 'size': ['small', false, 'large', 'huge'] }],
                            ['bold', 'italic', 'underline', 'strike'],
                            [{ 'color': [] }, { 'background': [] }],
                            [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                            ['clean']
                        ]
                    }
                });

                document.getElementById('teacherNotifForm').addEventListener('submit', function() {
                    document.getElementById('teacherHiddenMsg').value = quill.root.innerHTML;
                    const indiv = document.getElementById('teacherIndividualTarget').value;
                    const finalF = document.getElementById('teacherFinalTarget');
                    if (indiv) finalF.value = indiv;
                    else finalF.value = document.getElementById('teacherQuickTarget').value;
                });
            }

            // Sync quick select
            const tQuick = document.getElementById('teacherQuickTarget');
            if (tQuick) {
                tQuick.addEventListener('change', function() {
                    document.getElementById('teacherIndividualTarget').value = '';
                    document.getElementById('teacherSelectedBox').style.display = 'none';
                    document.getElementById('teacherFinalTarget').value = this.value;
                });
                document.getElementById('teacherFinalTarget').value = tQuick.value;
            }

            // Search
            const tSearch = document.getElementById('teacherSearchInput');
            const tResults = document.getElementById('teacherSearchResults');
            if (tSearch) {
                tSearch.addEventListener('input', function() {
                    const q = this.value.trim().toLowerCase();
                    if (q.length < 1) { tResults.style.display = 'none'; return; }
                    const matches = (teacherStudentsData || []).filter(s =>
                        (s.name || '').toLowerCase().includes(q) || (s.id || '').toLowerCase().includes(q)
                    );
                    if (matches.length === 0) {
                        tResults.innerHTML = '<div style="padding:10px;color:#777;">ምንም አልተገኘም / No results</div>';
                    } else {
                        tResults.innerHTML = matches.slice(0, 12).map(s => `
                            <div class="t-search-item" data-value="STUDENT:${s.id}" data-label="👨‍🎓 ${s.name} (${s.id})"
                                 style="padding:10px 12px; cursor:pointer; border-bottom:1px solid #eee; font-size:13.5px;"
                                 onmouseover="this.style.background='#e3f2fd'" onmouseout="this.style.background='white'">
                                👨‍🎓 ${s.name} (${s.id})
                            </div>
                        `).join('');
                    }
                    tResults.style.display = 'block';
                    tResults.querySelectorAll('.t-search-item').forEach(item => {
                        item.addEventListener('click', function() {
                            const val = this.getAttribute('data-value');
                            document.getElementById('teacherIndividualTarget').value = val;
                            document.getElementById('teacherFinalTarget').value = val;
                            document.getElementById('teacherSelectedText').textContent = this.getAttribute('data-label');
                            document.getElementById('teacherSelectedBox').style.display = 'block';
                            tSearch.value = '';
                            tResults.style.display = 'none';
                        });
                    });
                });
            }

            window.clearTeacherSelection = function() {
                document.getElementById('teacherIndividualTarget').value = '';
                document.getElementById('teacherSelectedBox').style.display = 'none';
                document.getElementById('teacherSearchInput').value = '';
                const qs = document.getElementById('teacherQuickTarget');
                if (qs) document.getElementById('teacherFinalTarget').value = qs.value;
            };

            // AJAX Grade Save
            document.querySelectorAll('.ajax-grade-form').forEach(form => {
                form.addEventListener('submit', function(e) {
                    e.preventDefault();
                    const btn = this.querySelector('button[type="submit"]');
                    const row = this.closest('tr');
                    const quizInput = row.querySelector('input[name="quiz"]');
                    const midInput = row.querySelector('input[name="mid"]');
                    const finalInput = row.querySelector('input[name="final"]');
                    const studentId = this.querySelector('input[name="student_id"]').value;
                    const courseId = this.querySelector('input[name="course_id"]') ? this.querySelector('input[name="course_id"]').value : '';
                    btn.disabled = true;
                    btn.innerText = '⏳...';
                    fetch(this.action, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            student_id: studentId, course_id: courseId,
                            quiz: quizInput ? quizInput.value : 0,
                            mid: midInput ? midInput.value : 0,
                            final: finalInput ? finalInput.value : 0
                        })
                    })
                    .then(r => r.json())
                    .then(data => {
                        btn.disabled = false;
                        if (data && data.success) {
                            btn.style.background = '#16a085';
                            btn.innerText = `✅ ${data.total}`;
                        } else {
                            btn.style.background = '#e74c3c';
                            btn.innerText = '❌ Error';
                        }
                    })
                    .catch(() => {
                        btn.disabled = false;
                        btn.style.background = '#e74c3c';
                        btn.innerText = '❌ Error';
                    });
                });
            });
        });
    </script>
</body>
</html>
