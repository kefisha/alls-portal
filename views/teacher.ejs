    <script>
        function setLang(l) {
            const clean = (l === 'en') ? 'en' : 'am';
            const isDark = document.body.classList.contains('dark');
            document.body.className = 'lang-' + clean + (isDark ? ' dark' : '');
            localStorage.setItem('prefLang', clean);
            const btnAm = document.getElementById('btn-am');
            const btnEn = document.getElementById('btn-en');
            if (btnAm && btnEn) {
                btnAm.style.background = clean === 'am' ? '#27ae60' : '#7f8c8d';
                btnEn.style.background = clean === 'en' ? '#2980b9' : '#7f8c8d';
            }
        }
        function toggleDark() {
            document.body.classList.toggle('dark');
            localStorage.setItem('darkMode', document.body.classList.contains('dark') ? '1' : '0');
            document.getElementById('darkBtn').textContent = document.body.classList.contains('dark') ? '☀️' : '🌙';
        }

        // Students in current class for search (passed from server if available)
        const teacherStudentsData = <%- typeof teacherStudentsJson !== 'undefined' ? teacherStudentsJson : '[]' %>;

        document.addEventListener('DOMContentLoaded', () => {
            setLang(localStorage.getItem('prefLang') || 'am');
            if (localStorage.getItem('darkMode') === '1') {
                document.body.classList.add('dark');
                const db = document.getElementById('darkBtn');
                if (db) db.textContent = '☀️';
            }
            fetch('/api/unread-count').then(r => r.json()).then(d => {
                const b = document.getElementById('unreadBadge');
                if (b && d.count > 0) { b.textContent = d.count; b.style.display = 'inline-block'; }
            }).catch(() => {});

            // Quill rich text
            if (document.getElementById('teacherEditor')) {
                var quill = new Quill('#teacherEditor', {
                    theme: 'snow',
                    placeholder: 'መልዕክትዎን እዚህ ይጻፉ... / Write your message...',
                    modules: {
                        toolbar: [
                            [{ 'font': [] }, { 'size': ['small', false, 'large', 'huge'] }],
                            ['bold', 'italic', 'underline', 'strike'],
                            [{ 'color': [] }, { 'background': [] }],
                            [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                            ['clean']
                        ]
                    }
                });

                document.getElementById('teacherNotifForm').addEventListener('submit', function() {
                    document.getElementById('teacherHiddenMsg').value = quill.root.innerHTML;
                    const indiv = (document.getElementById('teacherIndividualTarget').value || '').trim();
                    const finalF = document.getElementById('teacherFinalTarget');
                    const quickVal = document.getElementById('teacherQuickTarget').value;
                    if (indiv && indiv.startsWith('STUDENT:')) {
                        finalF.value = indiv;  // one student only
                    } else {
                        finalF.value = quickVal || 'ADMIN';
                    }
                    if (!finalF.value) finalF.value = 'ADMIN';
                });
            }

            // Sync quick select
            const tQuick = document.getElementById('teacherQuickTarget');
            if (tQuick) {
                tQuick.addEventListener('change', function() {
                    document.getElementById('teacherIndividualTarget').value = '';
                    document.getElementById('teacherSelectedBox').style.display = 'none';
                    document.getElementById('teacherFinalTarget').value = this.value;
                });
                document.getElementById('teacherFinalTarget').value = tQuick.value;
            }

            // Search
            const tSearch = document.getElementById('teacherSearchInput');
            const tResults = document.getElementById('teacherSearchResults');
            if (tSearch) {
                tSearch.addEventListener('input', function() {
                    const q = this.value.trim().toLowerCase();
                    if (q.length < 1) { tResults.style.display = 'none'; return; }
                    const matches = (teacherStudentsData || []).filter(s =>
                        (s.name || '').toLowerCase().includes(q) || (s.id || '').toLowerCase().includes(q)
                    );
                    if (matches.length === 0) {
                        tResults.innerHTML = '<div style="padding:10px;color:#777;">ምንም አልተገኘም / No results</div>';
                    } else {
                        tResults.innerHTML = matches.slice(0, 12).map(s => `
                            <div class="t-search-item" data-value="STUDENT:${s.id}" data-label="👨‍🎓 ${s.name} (${s.id}) — ${s.cls || ''}"
                                 style="padding:10px 12px; cursor:pointer; border-bottom:1px solid #eee; font-size:13.5px;"
                                 onmouseover="this.style.background='#e3f2fd'" onmouseout="this.style.background='white'">
                                👨‍🎓 ${s.name} (${s.id}) <small style="color:#64748b;">${s.cls || ''}</small>
                            </div>
                        `).join('');
                    }
                    tResults.style.display = 'block';
                    tResults.querySelectorAll('.t-search-item').forEach(item => {
                        item.addEventListener('click', function() {
                            const val = this.getAttribute('data-value');
                            document.getElementById('teacherIndividualTarget').value = val;
                            document.getElementById('teacherFinalTarget').value = val;
                            document.getElementById('teacherSelectedText').textContent = this.getAttribute('data-label');
                            document.getElementById('teacherSelectedBox').style.display = 'block';
                            tSearch.value = '';
                            tResults.style.display = 'none';
                        });
                    });
                });
            }

            window.clearTeacherSelection = function() {
                document.getElementById('teacherIndividualTarget').value = '';
                document.getElementById('teacherSelectedBox').style.display = 'none';
                document.getElementById('teacherSearchInput').value = '';
                const qs = document.getElementById('teacherQuickTarget');
                if (qs) document.getElementById('teacherFinalTarget').value = qs.value;
            };

            // AJAX Grade Save
            document.querySelectorAll('.ajax-grade-form').forEach(form => {
                form.addEventListener('submit', function(e) {
                    e.preventDefault();
                    const btn = this.querySelector('button[type="submit"]');
                    const row = this.closest('tr');
                    const quizInput = row.querySelector('input[name="quiz"]');
                    const assignInput = row.querySelector('input[name="assignment"]');
                    const projectInput = row.querySelector('input[name="project"]');
                    const midInput = row.querySelector('input[name="mid"]');
                    const finalInput = row.querySelector('input[name="final"]');
                    const studentId = this.querySelector('input[name="student_id"]').value;
                    const courseId = this.querySelector('input[name="course_id"]') ? this.querySelector('input[name="course_id"]').value : '';
                    btn.disabled = true;
                    btn.innerText = '⏳...';
                    fetch(this.action, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            student_id: studentId, course_id: courseId,
                            quiz: quizInput ? quizInput.value : 0,
                            assignment: assignInput ? assignInput.value : 0,
                            project: projectInput ? projectInput.value : 0,
                            mid: midInput ? midInput.value : 0,
                            final: finalInput ? finalInput.value : 0
                        })
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data && data.success && window.showToast) showToast('✅ Grade saved');
                        if (typeof window.classAvgCalc === 'function') window.classAvgCalc();
                        else if (data && data.error && window.showToast) showToast(data.error, 'err');
                        btn.disabled = false;
                        if (data && data.success) {
                            btn.style.background = '#16a085';
                            btn.innerText = `✅ ${data.total}`;
                        } else {
                            btn.style.background = '#e74c3c';
                            btn.innerText = '❌ Error';
                        }
                    })
                    .catch(() => {
                        btn.disabled = false;
                        btn.style.background = '#e74c3c';
                        btn.innerText = '❌ Error';
                    });
                });
            });
        });
    
    // Stay in place after save/send/reply (no jump to top)
    (function(){
        const KEY = 'scrollPos_' + location.pathname;
        const saved = sessionStorage.getItem(KEY);
        if (saved) {
            const y = parseInt(saved, 10);
            if (!isNaN(y)) {
                requestAnimationFrame(function(){ window.scrollTo(0, y); });
                setTimeout(function(){ window.scrollTo(0, y); }, 50);
                setTimeout(function(){ window.scrollTo(0, y); }, 200);
            }
            sessionStorage.removeItem(KEY);
        }
        function saveScroll(){ sessionStorage.setItem(KEY, String(window.scrollY || window.pageYOffset || 0)); }
        document.addEventListener('submit', function(e){
            const f = e.target;
            if (!f || f.tagName !== 'FORM') return;
            // AJAX forms handle themselves
            if (f.classList.contains('ajax-grade-form') || f.id === 'studentChatForm' || f.id === 'chatForm') return;
            saveScroll();
        }, true);
        document.addEventListener('click', function(e){
            const a = e.target.closest && e.target.closest('a[href]');
            if (!a) return;
            const href = a.getAttribute('href') || '';
            if (href.indexOf('/admin/approve/') === 0 || href.indexOf('/admin/reject/') === 0 ||
                href.indexOf('/delete-notification/') === 0 || href.indexOf('/edit-notification/') === 0) {
                saveScroll();
            }
        }, true);
    })();


    // Toast + loading + file preview + table search
    (function(){
        if (!document.querySelector('.toast-wrap')) {
            const w = document.createElement('div');
            w.className = 'toast-wrap';
            document.body.appendChild(w);
        }
        window.showToast = function(msg, type) {
            const w = document.querySelector('.toast-wrap');
            const t = document.createElement('div');
            t.className = 'toast' + (type === 'err' ? ' err' : type === 'info' ? ' info' : '');
            t.textContent = msg;
            w.appendChild(t);
            setTimeout(() => { t.remove(); }, 3200);
        };
        // Loading on non-AJAX form submit
        document.addEventListener('submit', function(e) {
            const f = e.target;
            if (!f || f.tagName !== 'FORM') return;
            if (f.classList.contains('ajax-grade-form') || f.id === 'studentChatForm' || f.id === 'chatForm') return;
            const btn = f.querySelector('button[type="submit"]');
            if (btn) { btn.classList.add('btn-loading'); btn.disabled = true; }
        }, true);
        // File preview for /uploads/ links
        document.addEventListener('click', function(e) {
            const a = e.target.closest && e.target.closest('a[href*="/uploads/"]');
            if (!a) return;
            const href = a.getAttribute('href') || '';
            if (!/\.(jpg|jpeg|png|gif|webp|pdf)(\?|$)/i.test(href) && href.indexOf('/uploads/') === -1) return;
            // preview images
            if (/\.(jpg|jpeg|png|gif|webp)(\?|$)/i.test(href)) {
                e.preventDefault();
                let m = document.getElementById('filePreviewModal');
                if (!m) {
                    m = document.createElement('div');
                    m.id = 'filePreviewModal';
                    m.className = 'preview-modal';
                    m.innerHTML = '<div class="box"><button type="button" class="close" onclick="document.getElementById(\'filePreviewModal\').classList.remove(\'show\')">×</button><img id="previewImg" src=""></div>';
                    document.body.appendChild(m);
                    m.addEventListener('click', function(ev){ if (ev.target === m) m.classList.remove('show'); });
                }
                document.getElementById('previewImg').src = href;
                m.classList.add('show');
            }
        });
        // Table search: input.search-box data-table="tableId"
        document.querySelectorAll('.search-box[data-table]').forEach(function(inp) {
            inp.addEventListener('input', function() {
                const q = (inp.value || '').toLowerCase();
                const table = document.getElementById(inp.getAttribute('data-table'));
                if (!table) return;
                table.querySelectorAll('tr').forEach(function(tr, i) {
                    if (i === 0 && tr.querySelector('th')) return;
                    tr.style.display = !q || tr.textContent.toLowerCase().indexOf(q) !== -1 ? '' : 'none';
                });
            });
        });
        // Empty states
        document.querySelectorAll('table[data-empty]').forEach(function(table) {
            const rows = table.querySelectorAll('tr');
            const dataRows = Array.from(rows).filter(r => !r.querySelector('th'));
            if (dataRows.length === 0) {
                const wrap = document.createElement('div');
                wrap.className = 'empty-state';
                wrap.innerHTML = '<span class="ico">📭</span>' + (table.getAttribute('data-empty') || 'No data');
                table.parentNode.insertBefore(wrap, table.nextSibling);
            }
        });
    })();

    // Grade save toast
    document.querySelectorAll('.ajax-grade-form').forEach(form => {
        form.addEventListener('submit', function() {
            const orig = form.onsubmit;
        });
    });
    const _fetch = window.fetch;
    // enhance existing ajax grade success if present
    document.querySelectorAll('.ajax-grade-form').forEach(form => {
        form.addEventListener('submit', function(e) {
            // existing handler may preventDefault - add toast after short delay via MutationObserver on button text
        });
    });


    window.classAvgCalc = function() {
        const totals = [];
        document.querySelectorAll('.ajax-grade-form').forEach(f => {
            const row = f.closest('tr');
            if (!row) return;
            const nums = row.querySelectorAll('input[type="number"]');
            let s = 0; nums.forEach(n => s += parseFloat(n.value)||0);
            totals.push(s);
        });
        const el = document.getElementById('classAvg');
        if (!el || !totals.length) return;
        const avg = totals.reduce((a,b)=>a+b,0)/totals.length;
        el.textContent = '📊 Class average (sum of components): ' + avg.toFixed(1) + ' · Students: ' + totals.length;
    };
    window.classAvgCalc();

    fetch('/api/homework-submissions',{credentials:'same-origin'}).then(r=>r.json()).then(d=>{
        var el=document.getElementById('homeworkSubList');
        if(!el) return;
        var rows=d.rows||[];
        if(!rows.length){ el.innerHTML='<p style="color:#888;">No homework submissions yet</p>'; return; }
        el.innerHTML='<h4>📥 Homework to grade</h4>'+rows.slice(0,20).map(function(s){
            return '<div style="border:1px solid #ddd;padding:10px;border-radius:8px;margin:6px 0;">'
              +'<b>'+(s.student_name||'')+'</b> (HW #'+s.homework_id+') — '+(s.status||'')
              +(s.file_path?' · <a href="/uploads/'+s.file_path+'" target="_blank">File</a>':'')
              +'<form action="/teacher/homework-grade" method="POST" style="display:flex;gap:6px;margin-top:6px;flex-wrap:wrap;">'
              +'<input type="hidden" name="id" value="'+s.id+'">'
              +'<input type="number" name="score" placeholder="Score" value="'+(s.score||'')+'" style="width:90px;">'
              +'<input type="hidden" name="status" value="graded">'
              +'<button type="submit">Save grade</button></form></div>';
        }).join('');
    }).catch(function(){});
</script>


<script>
(function(){
  function secsList(){
    var s = window.TEACHER_SECTIONS;
    if (Array.isArray(s) && s.length) return s;
    return [];
  }
  function fillSelect(sel){
    if (!sel) return;
    var cur = sel.value;
    var have = {};
    Array.prototype.forEach.call(sel.options, function(o){ have[o.value]=true; });
    secsList().forEach(function(sec){
      if (!sec || have[sec]) return;
      var opt = document.createElement('option');
      opt.value = sec; opt.textContent = sec;
      if (sec === cur) opt.selected = true;
      sel.appendChild(opt);
    });
  }
  function fillAllClassSelects(){
    ['handoutClassSelect','quizClassSelect'].forEach(function(id){
      fillSelect(document.getElementById(id));
    });
    // homework class if select/input
    var hw = document.querySelector('form[action="/teacher/homework"] input[name="class_level"], form[action="/teacher/homework"] select[name="class_level"]');
    if (hw && hw.tagName === 'SELECT') fillSelect(hw);
    // fill every "my class" select (lesson plan, unlock request)
    document.querySelectorAll('select.my-class-select').forEach(function(sel){
      if (sel.getAttribute('data-filled')) return;
      sel.setAttribute('data-filled','1');
      if (sel.getAttribute('data-all') === '1' && secsList().length > 1) {
        var oa = document.createElement('option'); oa.value = 'ALL'; oa.textContent = 'All my classes'; sel.appendChild(oa);
      }
      secsList().forEach(function(sec){
        var o = document.createElement('option'); o.value = sec; o.textContent = sec; sel.appendChild(o);
      });
    });
  }

  window.loadMyQuizzes = function(){
    var box = document.getElementById('myQuizzesList');
    if (!box) return;
    box.innerHTML = 'Loading...';
    fetch('/api/teacher/quizzes', { credentials:'same-origin' })
      .then(function(r){ return r.json(); })
      .then(function(d){
        if (!d || !d.success) {
          box.innerHTML = '<p style="color:#c00;margin:0">Failed: '+(d && d.error ? d.error : 'unknown')+'</p>';
          return;
        }
        if (!(d.quizzes||[]).length) {
          box.innerHTML = '<p style="color:#64748b;margin:0">No quizzes yet. Create one below.</p>';
          return;
        }
        box.innerHTML = d.quizzes.map(function(q){
          return '<div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding:10px;border-bottom:1px solid #e9d5ff;">'+
            '<div style="flex:1;min-width:160px"><b>'+ (q.title||'Quiz') +'</b><br><small>'+ (q.class_level||'') +' · '+ (q.count||0) +' questions</small></div>'+
            '<button type="button" onclick="editQuiz('+q.id+')" style="background:#f59e0b;color:#fff;border:none;padding:8px 12px;border-radius:8px;font-weight:bold;">✏️ Edit</button>'+
            '<button type="button" onclick="deleteQuiz('+q.id+')" style="background:#e74c3c;color:#fff;border:none;padding:8px 12px;border-radius:8px;font-weight:bold;">🗑️ Delete</button>'+
            '<a href="/quiz/'+q.id+'" target="_blank" style="background:#2980b9;color:#fff;padding:8px 12px;border-radius:8px;text-decoration:none;font-weight:bold;">▶️ Open</a>'+
          '</div>';
        }).join('');
      })
      .catch(function(err){
        box.innerHTML = '<p style="color:#c00;margin:0">Network error loading quizzes</p>';
      });
  };

  window.loadMyHandouts = function(){
    var box = document.getElementById('myHandoutsList');
    if (!box) return;
    box.innerHTML = 'Loading...';
    fetch('/api/teacher/handouts', { credentials:'same-origin' })
      .then(function(r){ return r.json(); })
      .then(function(d){
        if (!d || !d.success) { box.innerHTML = '<p style="color:#c00;margin:0">Failed to load handouts</p>'; return; }
        if (!(d.rows||[]).length) { box.innerHTML = '<p style="color:#64748b;margin:0">No handouts yet.</p>'; return; }
        window.__handouts = d.rows;
        box.innerHTML = d.rows.map(function(h){
          var link = h.file_path ? ('<a href="/uploads/'+h.file_path+'" target="_blank">Open</a>') : '';
          return '<div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding:8px 0;border-bottom:1px solid #bae6fd;">'+
            '<div style="flex:1;min-width:140px"><b>'+(h.title||'')+'</b><br><small>Class: '+(h.class_level||'')+'</small> '+link+'</div>'+
            '<button type="button" onclick="editHandout('+h.id+')" style="background:#f59e0b;color:#fff;border:none;padding:6px 10px;border-radius:6px;">✏️ Edit</button>'+
            '<button type="button" onclick="deleteHandout('+h.id+')" style="background:#e74c3c;color:#fff;border:none;padding:6px 10px;border-radius:6px;">🗑️ Delete</button>'+
          '</div>';
        }).join('');
      })
      .catch(function(){ box.innerHTML = '<p style="color:#c00">Failed to load</p>'; });
  };

  window.deleteHandout = function(id){
    if (!confirm('Delete this handout/photo?')) return;
    fetch('/teacher/handout/'+id+'/delete', { method:'POST', credentials:'same-origin' })
      .then(function(r){ return r.json(); })
      .then(function(d){ if(d.success) loadMyHandouts(); else alert('Delete failed'); });
  };

  window.editQuiz = function(id){
    fetch('/api/teacher/quiz/'+id, { credentials:'same-origin' })
      .then(function(r){ return r.json(); })
      .then(function(d){
        if (!d.success) { alert('Cannot load quiz'); return; }
        var q = d.quiz;
        document.getElementById('editQuizId').value = q.id;
        document.getElementById('editQuizTitle').value = q.title || '';
        buildClassChecks(document.getElementById('editQuizClassBox'), q.class_level || '');
        var wrap = document.getElementById('editQuestions');
        wrap.innerHTML = '';
        (q.questions||[]).forEach(function(qq, i){ appendEditQ(wrap, qq, i); });
        if (!(q.questions||[]).length) appendEditQ(wrap, {}, 0);
        document.getElementById('quizEditPanel').style.display = 'block';
      });
  };

  function appendEditQ(wrap, qq, i){
    qq = qq || {};
    var opts = qq.options || {};
    var div = document.createElement('div');
    div.className = 'edit-qblock';
    div.style.cssText = 'border:1px solid #ddd;border-radius:10px;padding:10px;margin:8px 0;background:#f8fafc;';
    div.innerHTML =
      '<div style="display:flex;justify-content:space-between;align-items:center"><b>Q'+(i+1)+'</b>'+
      '<button type="button" class="del-eq" style="background:#e74c3c;color:#fff;border:none;border-radius:6px;padding:4px 10px;">🗑️</button></div>'+
      '<textarea class="eq-q" rows="2" placeholder="Question" style="width:100%;margin:6px 0;"></textarea>'+
      '<div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;">'+
      '<input class="eq-A" placeholder="A">'+
      '<input class="eq-B" placeholder="B">'+
      '<input class="eq-C" placeholder="C">'+
      '<input class="eq-D" placeholder="D">'+
      '</div>'+
      '<input class="eq-a" placeholder="Correct answer (A/B/C/D)" style="width:100%;margin-top:6px;">'+
      '<textarea class="eq-d" rows="2" placeholder="Explanation (optional)" style="width:100%;margin-top:6px;"></textarea>';
    wrap.appendChild(div);
    div.querySelector('.eq-q').value = qq.q || '';
    div.querySelector('.eq-A').value = opts.A || '';
    div.querySelector('.eq-B').value = opts.B || '';
    div.querySelector('.eq-C').value = opts.C || '';
    div.querySelector('.eq-D').value = opts.D || '';
    div.querySelector('.eq-a').value = qq.a || '';
    div.querySelector('.eq-d').value = qq.desc || '';
    div.querySelector('.del-eq').onclick = function(){ div.remove(); };
  }
  window.addEditQuestion = function(){
    var wrap = document.getElementById('editQuestions');
    appendEditQ(wrap, {}, wrap.querySelectorAll('.edit-qblock').length);
  };
  window.saveEditQuiz = function(){
    var id = document.getElementById('editQuizId').value;
    var questions = [];
    document.querySelectorAll('#editQuestions .edit-qblock').forEach(function(div){
      var q = (div.querySelector('.eq-q').value||'').trim();
      if (!q) return;
      questions.push({
        q: q,
        a: (div.querySelector('.eq-a').value||'').trim(),
        desc: (div.querySelector('.eq-d').value||'').trim(),
        type: 'mcq',
        options: {
          A: div.querySelector('.eq-A').value||'',
          B: div.querySelector('.eq-B').value||'',
          C: div.querySelector('.eq-C').value||'',
          D: div.querySelector('.eq-D').value||''
        }
      });
    });
    if (!questions.length) { alert('Add at least one question'); return; }
    var form = document.createElement('form');
    form.method = 'POST';
    form.action = '/teacher/quiz/'+id+'/update';
    function hid(n,v){ var i=document.createElement('input'); i.type='hidden'; i.name=n; i.value=v; form.appendChild(i); }
    hid('title', document.getElementById('editQuizTitle').value);
    hid('class_level', readClassChecks(document.getElementById('editQuizClassBox')));
    hid('questions_json', JSON.stringify(questions));
    document.body.appendChild(form);
    form.submit();
  };
  window.deleteQuiz = function(id){
    if (!confirm('Delete this quiz?')) return;
    fetch('/teacher/quiz/'+id+'/delete', { method:'POST', credentials:'same-origin' })
      .then(function(r){ return r.json(); })
      .then(function(d){ if (d.success) loadMyQuizzes(); else alert('Delete failed'); });
  };

  // also fetch sections from API as backup
  fetch('/api/teacher/my-sections', { credentials:'same-origin' })
    .then(function(r){ return r.json(); })
    .then(function(d){
      if (d.sections && d.sections.length) {
        window.TEACHER_SECTIONS = d.sections;
      }
      fillAllClassSelects();
    })
    .catch(function(){ fillAllClassSelects(); });

  loadMyQuizzes();
  loadMyHandouts();
})();
</script>



<script>
(function(){
  function sections(){
    var s = window.TEACHER_SECTIONS;
    return Array.isArray(s) ? s : [];
  }
  function syncBox(box){
    var hidden = box.querySelector('.cm-hidden');
    if (!hidden) return;
    var all = box.querySelector('.cm-all');
    var ab = box.querySelector('.cm-ab');
    var checks = box.querySelectorAll('.cm-list input[type=checkbox]');
    var vals = [];
    if (all && all.checked) {
      vals = sections().slice();
      if (!vals.length) vals = ['ALL'];
    } else {
      if (ab && ab.checked) {
        // expand A&B for each grade present
        var grades = {};
        sections().forEach(function(sec){
          var m = String(sec).match(/(\d+)/);
          var g = m ? m[1] : '';
          if (!g) return;
          if (!grades[g]) grades[g] = {A:false,B:false,raw:[]};
          grades[g].raw.push(sec);
          if (/section\s*a\b|\bA\b/i.test(sec)) grades[g].A = true;
          if (/section\s*b\b|\bB\b/i.test(sec)) grades[g].B = true;
        });
        Object.keys(grades).forEach(function(g){
          grades[g].raw.forEach(function(x){ if (vals.indexOf(x)<0) vals.push(x); });
        });
      }
      checks.forEach(function(c){ if (c.checked && vals.indexOf(c.value)<0) vals.push(c.value); });
    }
    hidden.value = vals.join(', ');
  }
  function buildBox(box){
    var list = box.querySelector('.cm-list');
    if (!list) return;
    list.innerHTML = '';
    var secs = sections();
    if (!secs.length) {
      list.innerHTML = '<span style="color:#b91c1c;font-size:13px;">No assigned classes — Admin must assign sections to this teacher.</span>';
    } else {
      secs.forEach(function(sec){
        var lab = document.createElement('label');
        lab.style.cssText = 'display:inline-flex;align-items:center;gap:6px;background:#fff;border:1px solid #e2e8f0;padding:6px 10px;border-radius:8px;';
        lab.innerHTML = '<input type="checkbox" value=""> <span></span>';
        lab.querySelector('input').value = sec;
        lab.querySelector('span').textContent = sec;
        lab.querySelector('input').addEventListener('change', function(){ syncBox(box); });
        list.appendChild(lab);
      });
    }
    var all = box.querySelector('.cm-all');
    var ab = box.querySelector('.cm-ab');
    if (all) all.addEventListener('change', function(){
      if (all.checked) {
        list.querySelectorAll('input').forEach(function(c){ c.checked = true; });
        if (ab) ab.checked = true;
      }
      syncBox(box);
    });
    if (ab) ab.addEventListener('change', function(){
      if (ab.checked) {
        // check all section A and B variants
        list.querySelectorAll('input').forEach(function(c){ c.checked = true; });
        if (all) all.checked = true;
      }
      syncBox(box);
    });
    // form submit ensure hidden filled
    var form = box.closest('form');
    if (form && !form.getAttribute('data-cm')) {
      form.setAttribute('data-cm','1');
      form.addEventListener('submit', function(e){
        syncBox(box);
        var hidden = box.querySelector('.cm-hidden');
        if (hidden && !(hidden.value||'').trim()) {
          e.preventDefault();
          alert('Select at least one class / section');
        }
      });
    }
    syncBox(box);
  }
  function initAll(){
    document.querySelectorAll('.class-multi-box').forEach(buildBox);
  }
  // refresh when sections load
  var prev = window.TEACHER_SECTIONS;
  fetch('/api/teacher/my-sections', { credentials:'same-origin' })
    .then(function(r){ return r.json(); })
    .then(function(d){
      if (d.sections && d.sections.length) window.TEACHER_SECTIONS = d.sections;
      initAll();
    })
    .catch(function(){ initAll(); });
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initAll);
  else initAll();
})();
</script>


<script>
(function(){
  function loadQuizAnalytics(){
    var box=document.getElementById('quizAnalyticsList'); if(!box) return;
    fetch('/api/teacher/quiz-analytics',{credentials:'same-origin'}).then(r=>r.json()).then(function(d){
      if(!d.success||!(d.quizzes||[]).length){ box.innerHTML='<p style="margin:0;color:#64748b">No quiz data yet.</p>'; return; }
      box.innerHTML=d.quizzes.map(function(q){
        var recent=(q.recent||[]).map(function(a){ return '<div style="font-size:12px">'+a.student+': <b>'+a.percent+'%</b> ('+a.score+'/'+a.total+')</div>'; }).join('');
        var wrong=(q.question_stats||[]).filter(function(s){return s.wrong>0;}).map(function(s){
          return '<div style="font-size:12px;margin:4px 0;padding:6px;background:#fff;border-left:3px solid #e11d48;border-radius:4px">'+
            '<b>Q'+s.index+'</b> ❌ wrong: <b>'+s.wrong+'</b> · ✅ right: '+s.right+
            '<br><span style="color:#334155">'+String(s.q||'').replace(/</g,'&lt;')+'</span>'+
            '<br><span style="color:#b91c1c">Wrong answers: '+(s.wrong_answers||'-')+'</span>'+
            '<br><span style="color:#047857">Correct: '+(s.correct||'-')+'</span></div>';
        }).join('') || '<div style="font-size:12px;color:#64748b">No wrong answers yet (or no attempts).</div>';
        return '<div style="border-bottom:1px solid #e9d5ff;padding:10px 0"><b>'+q.title+'</b> · '+q.class_level+
          '<br><small>Questions: '+q.questions+' · Attempts: '+q.attempts+' · Avg: <b>'+q.avg_percent+'%</b></small>'+
          '<div style="margin-top:8px"><b>Wrong questions</b>'+wrong+'</div>'+
          (recent?('<div style="margin-top:6px"><b>Recent</b>'+recent+'</div>'):'')+'</div>';
      }).join('');
    }).catch(function(){ box.innerHTML='Failed to load analytics'; });
  }
  function loadLessonPlans(){
    var box=document.getElementById('lessonPlanList'); if(!box) return;
    fetch('/api/lesson-plans',{credentials:'same-origin'}).then(r=>r.json()).then(function(d){
      var rows=d.rows||[];
      if(!rows.length){ box.innerHTML='<p style="margin:0;color:#64748b">No lesson plans yet. Save one below.</p>'; return; }
      window.__lessons = rows;
      box.innerHTML=rows.map(function(p){
        return '<div style="border-bottom:1px solid #99f6e4;padding:8px 0"><b>'+(p.week_label||'Plan')+'</b> · '+(p.class_level||'')+
          '<br><small>'+(p.teacher_name||'')+' · '+(p.created_at||'')+'</small>'+
          '<div style="white-space:pre-wrap;font-size:13px;margin-top:4px">'+(p.content||'')+'</div>'+
          (String(p.teacher_id)===String(window.MY_TEACHER_ID)
            ? '<button type="button" onclick="editLesson('+p.id+')" style="margin-top:6px;background:#f59e0b;color:#fff;border:none;border-radius:6px;padding:4px 10px">✏️ Edit</button> <button type="button" onclick="deleteLesson('+p.id+')" style="margin-top:6px;background:#e11d48;color:#fff;border:none;border-radius:6px;padding:4px 10px">🗑️ Delete</button>'
            : '')+'</div>';
      }).join('');
    }).catch(function(){ box.innerHTML='Failed'; });
  }
  window.deleteLesson=function(id){
    if(!confirm('Delete lesson plan?')) return;
    fetch('/teacher/lesson-plan/'+id+'/delete',{method:'POST',credentials:'same-origin'}).then(r=>r.json()).then(function(d){ if(d.success) loadLessonPlans(); });
  };
  loadQuizAnalytics();
  loadLessonPlans();
})();
</script>


