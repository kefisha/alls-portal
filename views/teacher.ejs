<!DOCTYPE html>
<html lang="am">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teacher Dashboard - Amanuel Light and Life School</title>
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <style>
        :root { --bg:#eef2f5; --card:#fff; --text:#333; --border:#cbd5e1; --primary:#1f4e79; --even:#f8fafc; --input:#fff; }
        body.dark { --bg:#0f172a; --card:#1e293b; --text:#e2e8f0; --border:#334155; --primary:#3b82f6; --even:#162032; --input:#0f172a; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: var(--bg); margin: 0; padding: 20px; color: var(--text); transition: background 0.3s; }
        .container { max-width: 1150px; margin: auto; }
        body.lang-am .en { display: none !important; }
        body.lang-am .am { display: inline !important; }
        body.lang-en .am { display: none !important; }
        body.lang-en .en { display: inline !important; }
        .top-bar { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 20px; background: var(--card); padding: 15px 20px; border-radius: 12px; box-shadow: 0 3px 10px rgba(0,0,0,0.05); color: var(--text); }
        .card { background: var(--card); padding: 22px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); margin-bottom: 22px; border-top: 4px solid #2980b9; color: var(--text); }
        .card h3 { color: var(--primary); margin-top: 0; border-bottom: 2px solid var(--border); padding-bottom: 10px; }
        table { width: 100%; border-collapse: collapse; margin-top: 12px; }
        th, td { border: 1px solid var(--border); padding: 10px; text-align: center; font-size: 14px; color: var(--text); }
        th { background: var(--primary); color: white; }
        tr:nth-child(even) { background: var(--even); }
        select, input[type="text"], input[type="number"], input[type="file"], textarea {
            width: 100%; padding: 10px; margin-bottom: 10px; border: 1px solid var(--border); border-radius: 6px; box-sizing: border-box; font-family: inherit; background: var(--input); color: var(--text);
        }
        button { background: #2980b9; color: white; border: none; padding: 10px 18px; border-radius: 6px; font-weight: bold; cursor: pointer; }
        .logout-btn { background: #e74c3c; color: white; padding: 9px 18px; border-radius: 6px; text-decoration: none; font-weight: bold; }
        #teacherEditor { height: 160px; background: white; }
    
        /* ===== Modern UI 1-10 ===== */
        .toast-wrap { position: fixed; top: 18px; right: 18px; z-index: 99999; display: flex; flex-direction: column; gap: 8px; max-width: 320px; }
        .toast { background: #1e293b; color: #fff; padding: 12px 16px; border-radius: 10px; box-shadow: 0 8px 24px rgba(0,0,0,.25); font-size: 14px; font-weight: 600; animation: toastIn .25s ease; border-left: 4px solid #27ae60; }
        .toast.err { border-left-color: #e74c3c; }
        .toast.info { border-left-color: #3498db; }
        @keyframes toastIn { from { opacity:0; transform: translateY(-10px); } to { opacity:1; transform:none; } }
        .btn-loading { position: relative; pointer-events: none; opacity: .75; }
        .btn-loading::after { content: ""; width: 14px; height: 14px; border: 2px solid #fff; border-top-color: transparent; border-radius: 50%; display: inline-block; margin-left: 8px; vertical-align: middle; animation: spin .7s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
        .widget-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin-bottom: 18px; }
        .widget { background: var(--card); border-radius: 12px; padding: 14px 16px; box-shadow: 0 2px 10px var(--shadow); border: 1px solid var(--border); text-align: center; }
        .widget .n { font-size: 26px; font-weight: 800; color: var(--primary); }
        .widget .l { font-size: 12px; color: var(--text2); margin-top: 4px; }
        .search-box { width: 100%; max-width: 320px; padding: 10px 14px; border-radius: 24px; border: 1px solid var(--input-border); background: var(--input-bg); color: var(--text); margin-bottom: 12px; }
        .empty-state { text-align: center; padding: 28px 16px; color: var(--text2); font-size: 14px; }
        .empty-state .ico { font-size: 36px; display: block; margin-bottom: 8px; }
        .preview-modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.7); z-index: 99998; align-items: center; justify-content: center; padding: 20px; }
        .preview-modal.show { display: flex; }
        .preview-modal .box { background: #fff; border-radius: 12px; max-width: 90vw; max-height: 90vh; overflow: auto; padding: 12px; position: relative; }
        .preview-modal img, .preview-modal iframe { max-width: 100%; max-height: 80vh; }
        .preview-modal .close { position: absolute; top: 8px; right: 12px; background: #e74c3c; color: #fff; border: none; border-radius: 50%; width: 32px; height: 32px; font-weight: bold; cursor: pointer; }
        .mobile-nav { display: none; position: sticky; top: 0; z-index: 100; background: var(--primary); color: #fff; padding: 10px 14px; margin: -20px -20px 16px -20px; }
        .mobile-nav a { color: #fff; text-decoration: none; font-weight: bold; margin-right: 12px; font-size: 13px; }
        @media (max-width: 768px) {
            body { padding: 12px; }
            .mobile-nav { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
            .card { padding: 16px; }
            h2 { font-size: 20px; }
            table { font-size: 12px; display: block; overflow-x: auto; }
            th, td { padding: 8px; }
            button, .logout-btn { min-height: 44px; }
            input, select, textarea { font-size: 16px; } /* prevent iOS zoom */
        }
        @media print {
            .no-print, .mobile-nav, .logout-btn, .dark-toggle, .lang-bar { display: none !important; }
            body { background: #fff; padding: 0; }
            .card { box-shadow: none; border: 1px solid #ccc; break-inside: avoid; }
        }

</style>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Noto+Sans+Ethiopic:wght@400;600;700;800&display=swap" rel="stylesheet">
<style id="ui-2026">
/* ===== ALLS Teacher · 2026 UI layer (visual only; markup & logic untouched) ===== */
:root{
  --bg:#f4f5fb; --card:#ffffff; --text:#0f1226; --text2:#6b7194; --border:#e6e8f4;
  --primary:#4f46e5; --accent:#7c3aed; --even:#fafaff; --hover-row:#f0efff;
  --input:#f7f8fd; --input-bg:#f7f8fd; --input-border:#d9dcef; --radius:20px;
  --shadow:rgba(60,60,140,.14); --ring:rgba(99,102,241,.28);
  --grad:linear-gradient(135deg,#6366f1 0%,#8b5cf6 55%,#d946ef 100%);
  --soft:0 1px 2px rgba(20,22,60,.04),0 12px 32px -8px rgba(60,60,140,.12);
}
body.dark{
  --bg:#070914; --card:#10142a; --text:#eaecff; --text2:#9aa1c8; --border:#222849;
  --primary:#a5b4fc; --accent:#8b5cf6; --even:#0d1124; --hover-row:#1a1f40;
  --input:#0b0e20; --input-bg:#0b0e20; --input-border:#2c3358; --shadow:rgba(0,0,0,.5);
  --ring:rgba(139,147,255,.32);
  --soft:0 1px 0 rgba(255,255,255,.03) inset,0 18px 40px -12px rgba(0,0,0,.65);
}
html{scroll-behavior:smooth}
body{font-family:'Outfit','Noto Sans Ethiopic','Segoe UI',system-ui,sans-serif;-webkit-font-smoothing:antialiased;padding:20px 20px 44px;
  background:radial-gradient(900px 520px at 8% -8%,rgba(99,102,241,.16),transparent 60%),
             radial-gradient(800px 480px at 100% 0%,rgba(217,70,239,.12),transparent 55%),
             radial-gradient(700px 500px at 50% 110%,rgba(34,211,238,.10),transparent 60%),var(--bg);
  background-attachment:fixed}
body.dark{background-image:radial-gradient(900px 520px at 8% -8%,rgba(99,102,241,.22),transparent 60%),
             radial-gradient(800px 480px at 100% 0%,rgba(217,70,239,.14),transparent 55%),
             radial-gradient(700px 500px at 50% 110%,rgba(34,211,238,.08),transparent 60%)}
.container{max-width:1240px}
::selection{background:rgba(124,58,237,.28)}
*{scrollbar-width:thin;scrollbar-color:rgba(124,58,237,.45) transparent}
::-webkit-scrollbar{width:9px;height:9px}::-webkit-scrollbar-thumb{background:rgba(124,58,237,.4);border-radius:99px}

/* top bar: floating glass */
.top-bar{position:sticky;top:10px;z-index:90;border-radius:22px;padding:14px 20px;
  background:color-mix(in srgb,var(--card) 74%,transparent);
  -webkit-backdrop-filter:blur(18px) saturate(160%);backdrop-filter:blur(18px) saturate(160%);
  border:1px solid color-mix(in srgb,var(--border) 80%,transparent);box-shadow:var(--soft)}
.top-bar h2{font-size:clamp(1.15rem,2.6vw,1.6rem);letter-spacing:-.02em;font-weight:800;
  background:var(--grad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent !important}
.top-bar p{color:var(--text2) !important;font-weight:600 !important}
.top-bar p span{color:var(--accent) !important}
#topLogout{margin-bottom:14px !important}

/* cards */
.card{background:var(--card);border:1px solid var(--border);border-top:1px solid var(--border);border-radius:var(--radius);
  padding:24px 26px;box-shadow:var(--soft);animation:uiRise .5s cubic-bezier(.2,.7,.2,1) both;transition:box-shadow .25s,border-color .25s}
.card:hover{border-color:color-mix(in srgb,var(--accent) 35%,var(--border));box-shadow:0 22px 50px -18px rgba(99,102,241,.32)}
.card h3{display:flex;align-items:center;gap:10px;flex-wrap:wrap;color:var(--text);font-size:1.1rem;font-weight:700;letter-spacing:-.01em;
  border-bottom:1px solid var(--border);padding-bottom:12px;margin-bottom:16px}
.card h3::before{content:"";width:5px;height:20px;border-radius:99px;background:var(--grad);flex:none}
@keyframes uiRise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}

/* stat widgets (if present) */
.widget-grid{grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px}
.widget{border-radius:20px;padding:18px 16px;box-shadow:var(--soft);transition:border-color .25s,box-shadow .25s}
.widget:hover{border-color:var(--accent)}
.widget .n{font-weight:800;letter-spacing:-.03em;background:var(--grad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.widget .l{text-transform:uppercase;letter-spacing:.08em;font-size:11px}

/* tables */
table{border-collapse:separate;border-spacing:0;border:1px solid var(--border);border-radius:14px;background:var(--card)}
th,td{border:0;border-bottom:1px solid var(--border);padding:12px}
tr:last-child td{border-bottom:0}
th{background:var(--input) !important;color:var(--text2) !important;font-size:11.5px;font-weight:700;text-transform:uppercase;letter-spacing:.07em}
tr:nth-child(even){background:var(--even)}
tr:hover td{background:var(--hover-row)}

/* forms */
select,input[type="text"],input[type="number"],input[type="file"],input[type="password"],input[type="date"],textarea,.search-box{
  border-radius:12px;border:1px solid var(--input-border);padding:12px 14px;background:var(--input);color:var(--text);
  transition:border-color .2s,box-shadow .2s}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 4px var(--ring)}
.search-box{border-radius:99px}
input[type="checkbox"],input[type="radio"]{accent-color:var(--accent)}

/* buttons */
button,.logout-btn{background:var(--grad);border-radius:12px;font-weight:700;letter-spacing:.005em;
  box-shadow:0 8px 20px -8px rgba(124,58,237,.55);transition:transform .15s,filter .15s,box-shadow .2s}
button:hover,.logout-btn:hover{filter:brightness(1.07) saturate(1.1);transform:translateY(-1px);box-shadow:0 14px 26px -10px rgba(124,58,237,.6)}
button:active{transform:translateY(0) scale(.98)}
button:focus-visible,a:focus-visible{outline:3px solid var(--ring);outline-offset:2px}
.logout-btn{background:linear-gradient(135deg,#fb7185,#e11d48);box-shadow:0 8px 20px -8px rgba(225,29,72,.5);display:inline-flex;align-items:center;gap:6px;padding:10px 18px}
button[style*="border-radius:50px"]{border-radius:99px}

/* quiz paste zones */
.paste-zone{border:2px dashed color-mix(in srgb,var(--accent) 55%,transparent);background:color-mix(in srgb,var(--accent) 7%,var(--card));border-radius:16px;transition:border-color .2s,background .2s}
.paste-zone:hover{border-color:var(--accent)}
.paste-zone:focus,.paste-zone.active{border-color:#10b981;background:color-mix(in srgb,#10b981 10%,var(--card))}
.paste-zone .pz-hint{color:var(--primary)}.paste-zone .pz-sub{color:var(--text2)}
.paste-zone img{border-radius:12px}

/* dark-mode safety for pale inline backgrounds */
body.dark div[style*="background:#fff"],body.dark div[style*="background: #fff"],
body.dark div[style*="background:#f8fafc"],body.dark div[style*="background: #f8fafc"],
body.dark div[style*="background:#faf5ff"],body.dark div[style*="background:#f0fdfa"],
body.dark div[style*="background:#f0f9ff"]{background:var(--input) !important;color:var(--text) !important;border-color:var(--border) !important}
body.dark div[style*="background:#fff3cd"],body.dark div[style*="background:#fef3c7"]{background:rgba(245,158,11,.14) !important;color:#fde68a !important}
body.dark a{color:var(--primary)}

/* misc */
.toast{border-radius:16px;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}
.preview-modal{-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);background:rgba(7,9,20,.7)}
.preview-modal .box{border-radius:22px;background:var(--card);color:var(--text)}
.mobile-nav{background:color-mix(in srgb,var(--card) 82%,transparent);color:var(--text);-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);border-bottom:1px solid var(--border)}
.mobile-nav a{color:var(--primary)}
@media (max-width:768px){
  body{padding:12px 12px 32px}
  .top-bar{top:6px;border-radius:18px;padding:12px 14px}
  table{display:block;overflow-x:auto;-webkit-overflow-scrolling:touch}
  th,td{padding:8px 6px}
  .card{padding:18px 16px;border-radius:18px}
  .widget{text-align:center}
}
@media (prefers-reduced-motion:reduce){*{animation:none !important;transition:none !important;scroll-behavior:auto !important}}
@media print{.card{animation:none}.top-bar{position:static;backdrop-filter:none}}

/* teacher v3 additions */
.quick-nav{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 18px}
.quick-nav a{padding:9px 16px;border-radius:99px;background:var(--card);border:1px solid var(--border);color:var(--primary);font-weight:700;font-size:13px;text-decoration:none;box-shadow:var(--soft);transition:border-color .2s}
.quick-nav a:hover{border-color:var(--accent)}
.class-chips{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:14px}
.class-chips .chips-label{font-weight:700;font-size:13px;color:var(--text2)}
.class-chips .chip{padding:7px 14px;border-radius:99px;border:1px solid var(--border);background:var(--input);color:var(--text);font-weight:700;font-size:13px;text-decoration:none}
.class-chips .chip.active{background:var(--grad);color:#fff;border-color:transparent}
.cls-checks{display:flex;flex-wrap:wrap;gap:8px 12px}
.cls-check{display:inline-flex;align-items:center;gap:6px;background:var(--input);border:1px solid var(--border);padding:6px 10px;border-radius:10px;font-weight:600;font-size:13px;color:var(--text)}
.cls-check input{width:auto;margin:0}
body.dark div[style*="background:#fffbeb"]{background:var(--input) !important;color:var(--text) !important;border-color:var(--border) !important}
html{scroll-padding-top:90px}

/* ===== Grades table: swipe LEFT / RIGHT, every column reachable ===== */
#grades,#grades.card{overflow:visible}
#grades > div[style*="overflow-x"]{
  overflow-x:scroll !important;overflow-y:hidden;max-width:100%;
  -webkit-overflow-scrolling:touch;touch-action:pan-x pan-y;overscroll-behavior-x:contain;
  scrollbar-width:auto;scrollbar-color:#7c3aed rgba(124,58,237,.15);padding-bottom:8px}
#grades > div[style*="overflow-x"]::-webkit-scrollbar{height:12px}
#grades > div[style*="overflow-x"]::-webkit-scrollbar-track{background:rgba(124,58,237,.12);border-radius:99px}
#grades > div[style*="overflow-x"]::-webkit-scrollbar-thumb{background:#7c3aed;border-radius:99px}
#grades table{display:table !important;width:max-content !important;min-width:760px;max-width:none;overflow:visible !important;border-radius:0;border:0}
#grades th,#grades td{white-space:nowrap;padding:10px 8px}
#grades td input[type="number"]{width:72px !important;min-width:72px;padding:10px 6px;text-align:center;margin:0;font-size:16px;font-weight:700}
#grades td:nth-child(3),#grades th:nth-child(3){position:sticky;left:0;z-index:2;background:var(--card);box-shadow:2px 0 0 var(--border);min-width:96px}
#grades th:nth-child(3){background:var(--input) !important}
#grades td button{white-space:nowrap}
.scroll-hint{display:none;margin:0 0 8px;font-size:13px;font-weight:800;color:var(--accent)}
@media (max-width:768px){.scroll-hint{display:block}}

.view-toggle{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 10px}
.view-toggle button{background:var(--input) !important;color:var(--text) !important;border:1px solid var(--border);box-shadow:none;padding:8px 14px;font-size:13px}
.view-toggle button.on{background:var(--grad) !important;color:#fff !important;border-color:transparent;box-shadow:0 8px 20px -8px rgba(124,58,237,.55)}
#grades.cards .scroll-hint{display:none !important}
#grades.cards > div[style*="overflow-x"]{overflow:visible !important}
#grades.cards table,#grades.cards tbody{display:block !important;width:100% !important;min-width:0 !important;border:0;background:transparent;overflow:visible !important}
#grades.cards thead{display:none}
#grades.cards th,#grades.cards td{white-space:normal}
#grades.cards tbody tr,#grades.cards tbody tr:nth-child(even){display:grid;grid-template-columns:repeat(3,1fr);gap:12px 10px;padding:16px;margin:0 0 14px;border:1px solid var(--border);border-radius:18px;background:var(--card);box-shadow:var(--soft)}
#grades.cards tr:hover td{background:transparent}
#grades.cards td{display:block;border:0;padding:0;text-align:left;min-width:0}
#grades.cards td:nth-child(1){grid-column:1;font-weight:800;color:var(--text2)}
#grades.cards td:nth-child(2){grid-column:2 / 4;text-align:right}
#grades.cards td:nth-child(3){grid-column:1 / -1;font-weight:700;font-size:16px;text-align:left !important;position:static;box-shadow:none;background:transparent}
#grades.cards td:nth-child(n+4):nth-child(-n+8)::before{display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--text2);margin-bottom:5px}
#grades.cards td:nth-child(4)::before{content:"Quiz"}
#grades.cards td:nth-child(5)::before{content:"Assign"}
#grades.cards td:nth-child(6)::before{content:"Project"}
#grades.cards td:nth-child(7)::before{content:"Mid"}
#grades.cards td:nth-child(8)::before{content:"Final"}
#grades.cards td input[type="number"]{width:100% !important;min-width:0;padding:13px 4px;font-size:17px}
#grades.cards td:nth-child(9){align-self:end}
#grades.cards td:nth-child(9) button{width:100%;min-height:48px;padding:10px 6px !important}
#grades.cards td[colspan]{grid-column:1 / -1 !important;text-align:center !important}
</style>
</head>
<script>window.TEACHER_SECTIONS = <%- typeof teacherSectionsJson !== 'undefined' ? teacherSectionsJson : '[]' %>; window.MY_TEACHER_ID = <%- JSON.stringify(String(teacher.id)) %>;</script>
<body class="lang-am">
    <div class="container">
        <div id="topLogout" style="display:flex;justify-content:flex-end;margin-bottom:12px;gap:8px;flex-wrap:wrap;">
            <a href="/logout" class="logout-btn" style="margin:0;">🚪 Logout / ውጣ</a>
        </div>
        <div class="top-bar">
            <div>
                <h2 style="margin:0; color:#1f4e79;">👩‍🏫 <span class="am">የመምህራን መቆጣጠሪያ ገጽ</span><span class="en">Teacher Portal Dashboard</span></h2>
                <p style="margin:4px 0 0; color:#555; font-weight:bold;">👤 <%= teacher.name %> (<span style="color:#2980b9;"><%= teacher.id %></span>)</p>
            </div>
            <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
                <button type="button" onclick="toggleDark()" id="darkBtn" style="background:#64748b; color:white; padding:7px 12px; border:none; border-radius:6px; font-weight:bold; cursor:pointer;">🌙</button>
                <span style="font-weight:bold; font-size:14px;">🔔 <span id="unreadBadge" style="background:#e74c3c;color:#fff;border-radius:50px;padding:2px 8px;font-size:12px;display:none;">0</span></span>
                <button type="button" onclick="setLang('am')" id="btn-am" style="background:#27ae60; color:white; padding:7px 14px;">🇪🇹 አማርኛ</button>
                <button type="button" onclick="setLang('en')" id="btn-en" style="background:#7f8c8d; color:white; padding:7px 14px;">🇬🇧 English</button>
                
    <a href="/logout" class="logout-btn">🚪 <span class="am">ውጣ</span><span class="en">Logout</span></a>
            </div>
        </div>

        <nav class="quick-nav">
            <a href="#grades">📊 <span class="am">ውጤት</span><span class="en">Grades</span></a>
            <a href="#notifications">📢 <span class="am">ማስታወቂያ</span><span class="en">Messages</span></a>
            <a href="#absenceCard">📝 <span class="am">የፈቃድ ጥያቄ</span><span class="en">Absence</span></a>
            <a href="#homework">📚 <span class="am">ሆምወርክ / ኩዊዝ</span><span class="en">Homework / Quiz</span></a>
