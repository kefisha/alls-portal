<div id="qeModal" class="preview-modal"><div class="box" style="width:min(540px,92vw);">
  <button type="button" class="close" onclick="closeQuickEdit()">×</button>
  <h3 id="qeTitle" style="margin:4px 30px 12px 0;"></h3>
  <div id="qeBody"></div>
  <div style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap;">
    <button type="button" id="qeSave">💾 Save</button>
    <button type="button" onclick="closeQuickEdit()" style="background:#64748b;">Cancel</button>
  </div>
</div></div>

<script>
(function(){
  function secs(){ return Array.isArray(window.TEACHER_SECTIONS) ? window.TEACHER_SECTIONS : []; }
  function esc(v){ return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;'); }

  // checkbox list of MY classes only
  window.buildClassChecks = function(box, current){
    if (!box) return;
    var cur = String(current||'').split(/[,;]+/).map(function(x){ return x.trim().toLowerCase(); }).filter(Boolean);
    box.innerHTML = '';
    if (!secs().length) { box.innerHTML = '<span style="color:#b91c1c;font-size:13px;">No assigned classes — Admin must assign sections.</span>'; return; }
    secs().forEach(function(sec){
      var lab = document.createElement('label'); lab.className = 'cls-check';
      var inp = document.createElement('input'); inp.type = 'checkbox'; inp.value = sec;
      inp.checked = cur.indexOf(sec.toLowerCase()) >= 0 || cur.indexOf('all') >= 0;
      var sp = document.createElement('span'); sp.textContent = sec;
      lab.appendChild(inp); lab.appendChild(sp); box.appendChild(lab);
    });
  };
  window.readClassChecks = function(box){
    var v = []; if (box) box.querySelectorAll('input:checked').forEach(function(c){ v.push(c.value); });
    return v.join(', ');
  };

  window.closeQuickEdit = function(){ document.getElementById('qeModal').classList.remove('show'); };
  window.openQuickEdit = function(cfg){
    document.getElementById('qeTitle').textContent = cfg.title;
    var body = document.getElementById('qeBody'); body.innerHTML = '';
    (cfg.fields||[]).forEach(function(f){
      var w = document.createElement('div'); w.style.marginBottom = '8px';
      var lb = document.createElement('label'); lb.style.cssText = 'font-weight:bold;font-size:13px;display:block;margin-bottom:4px;'; lb.textContent = f.label; w.appendChild(lb);
      var el;
      if (f.type === 'textarea') { el = document.createElement('textarea'); el.rows = 3; }
      else if (f.type === 'classes') { el = document.createElement('div'); el.className = 'cls-checks'; buildClassChecks(el, f.value); }
      else { el = document.createElement('input'); el.type = f.type || 'text'; }
      el.setAttribute('data-f', f.name);
      if (f.type !== 'classes' && f.type !== 'file') el.value = (f.value == null ? '' : f.value);
      w.appendChild(el); body.appendChild(w);
    });
    document.getElementById('qeSave').onclick = function(){
      var ok = true, fd = cfg.multipart ? new FormData() : new URLSearchParams();
      body.querySelectorAll('[data-f]').forEach(function(el){
        var n = el.getAttribute('data-f');
        if (el.classList.contains('cls-checks')) { var v = readClassChecks(el); if (!v) ok = false; fd.append(n, v); }
        else if (el.type === 'file') { if (cfg.multipart && el.files && el.files[0]) fd.append(n, el.files[0]); }
        else fd.append(n, el.value);
      });
      if (!ok) { alert('Select at least one class / section'); return; }
      var opts = { method: 'POST', credentials: 'same-origin', headers: { 'Accept': 'application/json' }, body: cfg.multipart ? fd : fd.toString() };
      if (!cfg.multipart) opts.headers['Content-Type'] = 'application/x-www-form-urlencoded';
      fetch(cfg.url, opts).then(function(r){ return r.json(); }).then(function(d){
        if (d && d.success) { closeQuickEdit(); if (window.showToast) showToast('✅ Saved'); if (cfg.after) cfg.after(); }
        else alert((d && d.error) || 'Save failed');
      }).catch(function(){ alert('Network error'); });
    };
    document.getElementById('qeModal').classList.add('show');
  };

  // ----- My homework: list / edit / delete -----
  window.loadMyHomework = function(){
    var box = document.getElementById('myHomeworkList'); if (!box) return;
    fetch('/api/teacher/homework', { credentials: 'same-origin' }).then(function(r){ return r.json(); }).then(function(d){
      var rows = (d && d.rows) || []; window.__homework = rows;
      if (!rows.length) { box.innerHTML = '<p style="margin:0;color:#64748b">No homework yet. Assign one above.</p>'; return; }
      box.innerHTML = rows.map(function(h){
        return '<div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding:8px 0;border-bottom:1px solid #fde68a;">'
          + '<div style="flex:1;min-width:160px"><b>' + esc(h.title) + '</b><br><small>' + esc(h.class_level) + (h.due_date ? ' · Due ' + esc(h.due_date) : '') + '</small></div>'
          + '<button type="button" onclick="editHomework(' + h.id + ')" style="background:#f59e0b;color:#fff;border:none;padding:6px 10px;border-radius:6px;">✏️ Edit</button>'
          + '<button type="button" onclick="deleteHomework(' + h.id + ')" style="background:#e74c3c;color:#fff;border:none;padding:6px 10px;border-radius:6px;">🗑️ Delete</button>'
          + '</div>';
      }).join('');
    }).catch(function(){ box.innerHTML = '<p style="color:#c00;margin:0">Failed to load</p>'; });
  };
  window.editHomework = function(id){
    var h = (window.__homework||[]).filter(function(x){ return String(x.id) === String(id); })[0]; if (!h) return;
    openQuickEdit({ title: '✏️ Edit homework', url: '/teacher/homework/' + id + '/update', after: loadMyHomework, fields: [
      { name: 'title', label: 'Title', value: h.title },
      { name: 'description', label: 'Instructions', type: 'textarea', value: h.description },
      { name: 'due_date', label: 'Due date', type: 'date', value: h.due_date },
      { name: 'class_level', label: 'Class / Section', type: 'classes', value: h.class_level } ] });
  };
  window.deleteHomework = function(id){
    if (!confirm('Delete this homework (and its submissions)?')) return;
    fetch('/teacher/homework/' + id + '/delete', { method: 'POST', credentials: 'same-origin' }).then(function(r){ return r.json(); })
      .then(function(d){ if (d.success) loadMyHomework(); else alert('Delete failed'); });
  };

  // ----- Handout edit -----
  window.editHandout = function(id){
    var h = (window.__handouts||[]).filter(function(x){ return String(x.id) === String(id); })[0]; if (!h) return;
    openQuickEdit({ title: '✏️ Edit handout', url: '/teacher/handout/' + id + '/update', multipart: true, after: function(){ loadMyHandouts(); }, fields: [
      { name: 'title', label: 'Title', value: h.title },
      { name: 'note', label: 'Note', type: 'textarea', value: h.note },
      { name: 'class_level', label: 'Class / Section', type: 'classes', value: h.class_level },
      { name: 'file', label: 'Replace photo / file (optional)', type: 'file' } ] });
  };

  // ----- Lesson plan edit -----
  window.editLesson = function(id){
    var p = (window.__lessons||[]).filter(function(x){ return String(x.id) === String(id); })[0]; if (!p) return;
    openQuickEdit({ title: '✏️ Edit lesson plan', url: '/teacher/lesson-plan/' + id + '/update', after: function(){ location.reload(); }, fields: [
      { name: 'week_label', label: 'Week', value: p.week_label },
      { name: 'class_level', label: 'Class / Section', type: 'classes', value: p.class_level },
      { name: 'content', label: 'Lesson plan', type: 'textarea', value: p.content } ] });
  };

  loadMyHomework();
})();
</script>

<script>
(function(){
  function apply(v){
    var g=document.getElementById('grades'); if(!g) return;
    g.classList.toggle('cards', v==='cards');
    var a=document.getElementById('gvTable'), b=document.getElementById('gvCards');
    if(a) a.classList.toggle('on', v!=='cards');
    if(b) b.classList.toggle('on', v==='cards');
  }
  window.setGradeView=function(v){ try{ localStorage.setItem('gradeView',v); }catch(e){} apply(v); };
  var saved='table'; try{ saved=localStorage.getItem('gradeView')||'table'; }catch(e){}
  apply(saved);
})();
</script>

</body>
</html>
