<!DOCTYPE html>
<html lang="am">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teacher Dashboard - Amanuel Light and Life School</title>
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <style>
        :root { --bg:#eef2f5; --card:#fff; --text:#333; --border:#cbd5e1; --primary:#1f4e79; --even:#f8fafc; --input:#fff; }
        body.dark { --bg:#0f172a; --card:#1e293b; --text:#e2e8f0; --border:#334155; --primary:#3b82f6; --even:#162032; --input:#0f172a; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: var(--bg); margin: 0; padding: 20px; color: var(--text); transition: background 0.3s; }
        .container { max-width: 1150px; margin: auto; }
        body.lang-am .en { display: none !important; }
        body.lang-am .am { display: inline !important; }
        body.lang-en .am { display: none !important; }
        body.lang-en .en { display: inline !important; }
        .top-bar { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 20px; background: var(--card); padding: 15px 20px; border-radius: 12px; box-shadow: 0 3px 10px rgba(0,0,0,0.05); color: var(--text); }
        .card { background: var(--card); padding: 22px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); margin-bottom: 22px; border-top: 4px solid #2980b9; color: var(--text); }
        .card h3 { color: var(--primary); margin-top: 0; border-bottom: 2px solid var(--border); padding-bottom: 10px; }
        table { width: 100%; border-collapse: collapse; margin-top: 12px; }
        th, td { border: 1px solid var(--border); padding: 10px; text-align: center; font-size: 14px; color: var(--text); }
        th { background: var(--primary); color: white; }
        tr:nth-child(even) { background: var(--even); }
        select, input[type="text"], input[type="number"], input[type="file"], textarea {
            width: 100%; padding: 10px; margin-bottom: 10px; border: 1px solid var(--border); border-radius: 6px; box-sizing: border-box; font-family: inherit; background: var(--input); color: var(--text);
        }
        button { background: #2980b9; color: white; border: none; padding: 10px 18px; border-radius: 6px; font-weight: bold; cursor: pointer; }
        .logout-btn { background: #e74c3c; color: white; padding: 9px 18px; border-radius: 6px; text-decoration: none; font-weight: bold; }
        #teacherEditor { height: 160px; background: white; }
    
        /* ===== Modern UI 1-10 ===== */
        .toast-wrap { position: fixed; top: 18px; right: 18px; z-index: 99999; display: flex; flex-direction: column; gap: 8px; max-width: 320px; }
        .toast { background: #1e293b; color: #fff; padding: 12px 16px; border-radius: 10px; box-shadow: 0 8px 24px rgba(0,0,0,.25); font-size: 14px; font-weight: 600; animation: toastIn .25s ease; border-left: 4px solid #27ae60; }
        .toast.err { border-left-color: #e74c3c; }
        .toast.info { border-left-color: #3498db; }
        @keyframes toastIn { from { opacity:0; transform: translateY(-10px); } to { opacity:1; transform:none; } }
        .btn-loading { position: relative; pointer-events: none; opacity: .75; }
        .btn-loading::after { content: ""; width: 14px; height: 14px; border: 2px solid #fff; border-top-color: transparent; border-radius: 50%; display: inline-block; margin-left: 8px; vertical-align: middle; animation: spin .7s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
        .widget-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin-bottom: 18px; }
        .widget { background: var(--card); border-radius: 12px; padding: 14px 16px; box-shadow: 0 2px 10px var(--shadow); border: 1px solid var(--border); text-align: center; }
        .widget .n { font-size: 26px; font-weight: 800; color: var(--primary); }
        .widget .l { font-size: 12px; color: var(--text2); margin-top: 4px; }
        .search-box { width: 100%; max-width: 320px; padding: 10px 14px; border-radius: 24px; border: 1px solid var(--input-border); background: var(--input-bg); color: var(--text); margin-bottom: 12px; }
        .empty-state { text-align: center; padding: 28px 16px; color: var(--text2); font-size: 14px; }
        .empty-state .ico { font-size: 36px; display: block; margin-bottom: 8px; }
        .preview-modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.7); z-index: 99998; align-items: center; justify-content: center; padding: 20px; }
        .preview-modal.show { display: flex; }
        .preview-modal .box { background: #fff; border-radius: 12px; max-width: 90vw; max-height: 90vh; overflow: auto; padding: 12px; position: relative; }
        .preview-modal img, .preview-modal iframe { max-width: 100%; max-height: 80vh; }
        .preview-modal .close { position: absolute; top: 8px; right: 12px; background: #e74c3c; color: #fff; border: none; border-radius: 50%; width: 32px; height: 32px; font-weight: bold; cursor: pointer; }
        .mobile-nav { display: none; position: sticky; top: 0; z-index: 100; background: var(--primary); color: #fff; padding: 10px 14px; margin: -20px -20px 16px -20px; }
        .mobile-nav a { color: #fff; text-decoration: none; font-weight: bold; margin-right: 12px; font-size: 13px; }
        @media (max-width: 768px) {
            body { padding: 12px; }
            .mobile-nav { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
            .card { padding: 16px; }
            h2 { font-size: 20px; }
            table { font-size: 12px; display: block; overflow-x: auto; }
            th, td { padding: 8px; }
            button, .logout-btn { min-height: 44px; }
            input, select, textarea { font-size: 16px; } /* prevent iOS zoom */
        }
        @media print {
            .no-print, .mobile-nav, .logout-btn, .dark-toggle, .lang-bar { display: none !important; }
            body { background: #fff; padding: 0; }
            .card { box-shadow: none; border: 1px solid #ccc; break-inside: avoid; }
        }

</style>
</head>
<body class="lang-am">
    <div class="container">
        <div class="top-bar">
            <div>
                <h2 style="margin:0; color:#1f4e79;">👩‍🏫 <span class="am">የመምህራን መቆጣጠሪያ ገጽ</span><span class="en">Teacher Portal Dashboard</span></h2>
                <p style="margin:4px 0 0; color:#555; font-weight:bold;">👤 <%= teacher.name %> (<span style="color:#2980b9;"><%= teacher.id %></span>)</p>
            </div>
            <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
                <button type="button" onclick="toggleDark()" id="darkBtn" style="background:#64748b; color:white; padding:7px 12px; border:none; border-radius:6px; font-weight:bold; cursor:pointer;">🌙</button>
                <span style="font-weight:bold; font-size:14px;">🔔 <span id="unreadBadge" style="background:#e74c3c;color:#fff;border-radius:50px;padding:2px 8px;font-size:12px;display:none;">0</span></span>
                <button type="button" onclick="setLang('am')" id="btn-am" style="background:#27ae60; color:white; padding:7px 14px;">🇪🇹 አማርኛ</button>
                <button type="button" onclick="setLang('en')" id="btn-en" style="background:#7f8c8d; color:white; padding:7px 14px;">🇬🇧 English</button>
                
    <div class="card" id="homework">
        <h3>📝 Homework · ❓ Quiz · 📋 Lesson Plan · 📥 Bulk Grades</h3>
        <form action="/teacher/homework" method="POST" style="margin-bottom:14px;">
            <input type="text" name="title" placeholder="Homework title" required>
            <textarea name="description" rows="2" placeholder="Instructions"></textarea>
            <input type="text" name="class_level" placeholder="Class" value="<%= typeof selectedClass !== 'undefined' ? selectedClass : '' %>">
            <input type="date" name="due_date">
            <button type="submit">📝 Assign Homework</button>
        </form>
        <form id="quizBuilderForm" action="/teacher/quiz" method="POST" enctype="multipart/form-data" style="margin-bottom:14px;border-top:1px solid #ddd;padding-top:12px;">
            <div style="background:#fff3cd;border:1px solid #ffc107;border-radius:8px;padding:12px;margin-bottom:12px;font-size:13px;line-height:1.5;">
                <b>📌 ቀመር እንደ ፎቶ ለማስቀመጥ (ምርጥ መንገድ):</b><br>
                1) ጥያቄውን Screenshot ያድርጉ ወይም ፎቶ Copy<br>
                2) ከታች ባለው <b>ጫማ ሳጥን</b> ላይ ጠቅ ያድርጉና <b>Paste (Ctrl+V / long-press Paste)</b><br>
                3) ፎቶው ይታያል → A B C D ይሙሉ → Publish<br>
                <span style="color:#666;">ጽሁፍ ብቻ paste ካደረጉ ቀመር ሊበላሽ ይችላል — ፎቶ ሁልጊዜ ይቀራል።</span>
            </div>
            <input type="text" name="title" placeholder="Quiz title" required>
            <input type="text" name="class_level" placeholder="Class" value="<%= typeof selectedClass !== 'undefined' ? selectedClass : '' %>">
            <input type="hidden" name="questions_json" id="questionsJson">
            <div id="quizQuestions"></div>
            <button type="button" onclick="addQuizQuestion()" style="background:#8e44ad;margin-top:8px;">➕ Add Question</button>
            <button type="submit" style="margin-top:8px;">❓ Publish Quiz</button>
        </form>
        <style>
            .quiz-paste { width:100%; box-sizing:border-box; font-size:15px; line-height:1.5; white-space:pre-wrap; }
            .paste-zone {
                border: 2px dashed #2980b9; border-radius: 12px; padding: 16px; text-align: center;
                background: #eef6fc; cursor: pointer; margin: 8px 0; min-height: 90px;
            }
            .paste-zone:focus, .paste-zone.active { border-color: #27ae60; background: #e8f8f0; outline: none; }
            .paste-zone img { max-width: 100%; max-height: 220px; border-radius: 8px; margin-top: 8px; }
            .paste-zone .pz-hint { color: #1f4e79; font-weight: 600; font-size: 14px; }
            .paste-zone .pz-sub { color: #64748b; font-size: 12px; margin-top: 4px; }
        </style>
        <script>
        (function(){
            function setFileOnInput(fileInput, file) {
                try {
                    var dt = new DataTransfer();
                    dt.items.add(file);
                    fileInput.files = dt.files;
                } catch (e) { console.warn(e); }
            }

            function handleImageFile(div, file) {
                if (!file || !file.type || file.type.indexOf('image/') !== 0) return false;
                var img = div.querySelector('.pz-img');
                var fileInput = div.querySelector('.qimg');
                var hint = div.querySelector('.pz-hint');
                img.src = URL.createObjectURL(file);
                img.style.display = 'block';
                if (hint) hint.textContent = '✅ ፎቶ ተለጥፏል — አሁን A–D ይሙሉ';
                setFileOnInput(fileInput, file);
                return true;
            }

            function bindPasteZone(div) {
                var zone = div.querySelector('.paste-zone');
                var fileInput = div.querySelector('.qimg');
                zone.addEventListener('click', function() { fileInput.click(); });
                zone.tabIndex = 0;
                zone.addEventListener('paste', function(e) {
                    var cd = e.clipboardData || window.clipboardData;
                    if (!cd) return;
                    // Prefer image from clipboard
                    if (cd.items) {
                        for (var i = 0; i < cd.items.length; i++) {
                            if (cd.items[i].type.indexOf('image/') === 0) {
                                e.preventDefault();
                                var f = cd.items[i].getAsFile();
                                if (f) handleImageFile(div, f);
                                return;
                            }
                        }
                    }
                    if (cd.files && cd.files.length) {
                        for (var j = 0; j < cd.files.length; j++) {
                            if (cd.files[j].type.indexOf('image/') === 0) {
                                e.preventDefault();
                                handleImageFile(div, cd.files[j]);
                                return;
                            }
                        }
                    }
                });
                // Also allow paste image while focused on any field in this question block
                div.addEventListener('paste', function(e) {
                    var cd = e.clipboardData || window.clipboardData;
                    if (!cd || !cd.items) return;
                    for (var i = 0; i < cd.items.length; i++) {
                        if (cd.items[i].type.indexOf('image/') === 0) {
                            e.preventDefault();
                            var f = cd.items[i].getAsFile();
                            if (f) handleImageFile(div, f);
                            return;
                        }
                    }
                });
                fileInput.addEventListener('change', function() {
                    if (fileInput.files && fileInput.files[0]) {
                        handleImageFile(div, fileInput.files[0]);
                    }
                });
            }

            let n = 0;
            window.addQuizQuestion = function() {
                n++;
                const wrap = document.getElementById('quizQuestions');
                const div = document.createElement('div');
                div.className = 'qblock';
                div.style.cssText = 'border:1px solid #ddd;border-radius:8px;padding:12px;margin:10px 0;background:#f8fafc;';
                div.innerHTML = '<b>Q'+n+'</b>'
                  + '<div class="paste-zone" title="Click or Paste image here">'
                  +   '<div class="pz-hint">📷 ፎቶ እዚህ Paste ያድርጉ (Ctrl+V) ወይም ጠቅ በማድረግ ይምረጡ</div>'
                  +   '<div class="pz-sub">Screenshot of formula → Copy → Paste here</div>'
                  +   '<img class="pz-img" style="display:none;" alt="Question image">'
                  + '</div>'
                  + '<input type="file" class="qimg" name="qimg_'+n+'" accept="image/*" style="display:none;">'
                  + '<textarea class="qq quiz-paste" rows="2" placeholder="Optional: question text (if no image)" style="margin-top:8px;"></textarea>'
                  + '<div style="display:grid;grid-template-columns:28px 1fr;gap:6px;align-items:start;margin:8px 0;">'
                  + '<label style="padding-top:8px;"><input type="radio" class="qcorrect" name="corr'+n+'" value="A" checked> A</label><textarea class="qoA quiz-paste" rows="2" placeholder="Option A"></textarea>'
                  + '<label style="padding-top:8px;"><input type="radio" class="qcorrect" name="corr'+n+'" value="B"> B</label><textarea class="qoB quiz-paste" rows="2" placeholder="Option B"></textarea>'
                  + '<label style="padding-top:8px;"><input type="radio" class="qcorrect" name="corr'+n+'" value="C"> C</label><textarea class="qoC quiz-paste" rows="2" placeholder="Option C"></textarea>'
                  + '<label style="padding-top:8px;"><input type="radio" class="qcorrect" name="corr'+n+'" value="D"> D</label><textarea class="qoD quiz-paste" rows="2" placeholder="Option D"></textarea>'
                  + '</div>'
                  + '<textarea class="qd quiz-paste" rows="2" placeholder="Solution / explanation (optional text)"></textarea>';
                wrap.appendChild(div);
                bindPasteZone(div);
            };
            addQuizQuestion();
            document.getElementById('quizBuilderForm').addEventListener('submit', function() {
                const qs = [];
                document.querySelectorAll('#quizQuestions > .qblock').forEach(function(div, i) {
                    const q = (div.querySelector('.qq').value || '');
                    const opts = {
                        A: (div.querySelector('.qoA').value || ''),
                        B: (div.querySelector('.qoB').value || ''),
                        C: (div.querySelector('.qoC').value || ''),
                        D: (div.querySelector('.qoD').value || '')
                    };
                    const corrEl = div.querySelector('.qcorrect:checked');
                    const correct = corrEl ? corrEl.value : 'A';
                    const d = (div.querySelector('.qd').value || '');
                    const fileInp = div.querySelector('.qimg');
                    const hasImg = fileInp && fileInp.files && fileInp.files[0];
                    if (!q.trim() && !hasImg) return;
                    qs.push({
                        q: q,
                        options: opts,
                        a: correct,
                        desc: d,
                        type: 'mcq',
                        imageField: 'qimg_' + (i + 1)
                    });
                });
                document.getElementById('questionsJson').value = JSON.stringify(qs);
            });
        })();
        </script>
        <form action="/teacher/lesson-plan" method="POST" style="margin-bottom:14px;border-top:1px solid #ddd;padding-top:12px;">
            <input type="text" name="week_label" placeholder="Week e.g. Week 12" required>
            <input type="text" name="class_level" placeholder="Class">
            <textarea name="content" rows="3" placeholder="Lesson plan content..." required></textarea>
            <button type="submit">📋 Save Lesson Plan</button>
        </form>
        <form action="/teacher/bulk-grades" method="POST" enctype="multipart/form-data" style="border-top:1px solid #ddd;padding-top:12px;">
            <p style="font-size:12px;color:#666;">CSV: student_id,quiz,assignment,project,mid,final</p>
            <input type="text" name="course_code" placeholder="Course code" value="GEN">
            <input type="text" name="course_title" placeholder="Course title">
            <input type="file" name="csv" accept=".csv,text/csv" required>
            <button type="submit">📥 Import Grades CSV</button>
        </form>
        <p style="margin-top:12px;"><a href="/learning-hub">📚 Learning Hub</a> · <a href="/qr-scan">📷 QR Attendance</a></p>
        <div id="classAvg" style="margin-top:10px;font-weight:bold;color:#1f4e79;"></div>
    </div>

    <a href="/logout" class="logout-btn">🚪 <span class="am">ውጣ</span><span class="en">Logout</span></a>
            </div>
        </div>

        <!-- Class & Course Selector -->
        <div class="card" style="border-top-color:#8e44ad;">
            <h3>🏫 <span class="am">ክፍል እና ትምህርት ይምረጡ</span><span class="en">Select Class & Subject</span></h3>
            <form method="GET" action="/teacher-dashboard" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap:12px; align-items:end;">
                <div>
                    <label style="font-weight:bold; font-size:13px;"><span class="am">ክፍል / Section:</span><span class="en">Class / Section:</span></label>
                    <select name="cls" onchange="this.form.submit()" style="margin-bottom:0;"><%- classOptions %></select>
                </div>
                <div>
                    <label style="font-weight:bold; font-size:13px;"><span class="am">የትምህርት ዓይነት / Course:</span><span class="en">Course / Subject:</span></label>
                    <select name="course_id" onchange="this.form.submit()" style="margin-bottom:0;"><%- courseOptions %></select>
                </div>
                <div>
                    <button type="submit" style="width:100%; background:#8e44ad;">🔄 <span class="am">ክፍሉን ክፈት</span><span class="en">Load Class</span></button>
                </div>
            </form>
        </div>

        <%- proctorPanel %>

        <!-- Student Grades Entry -->
        <div class="card" style="border-top-color:#27ae60;">
            <h3>📊 <span class="am">የተማሪዎች ውጤት መሙያ (<%= selectedClass %>)</span><span class="en">Student Assessment & Grades (<%= selectedClass %>)</span></h3>
            <div style="overflow-x:auto;">
                <table>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>ID</th>
                            <th><span class="am">የተማሪ ስም</span><span class="en">Student Name</span></th>
                            <th>Quiz</th>
                            <th>Assign</th>
                            <th>Project</th>
                            <th>Mid</th>
                            <th>Final</th>
                            <th><span class="am">አስቀምጥ</span><span class="en">Save</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        <%- studentRows %>
                    </tbody>
                </table>
            </div>

            <div style="margin-top:20px; padding:15px; background:#f0fdf4; border:2px solid #27ae60; border-radius:10px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
                <div>
                    <strong style="color:#166534; font-size:15px;">📤 <span class="am">የክፍሉን ውጤት ለአድሚን ያስረክቡ፦</span><span class="en">Submit Final Class Grades to Admin:</span></strong>
                </div>
                <form action="/teacher/submit-final-grades" method="POST" style="display:flex; gap:10px; align-items:center; margin:0;">
                    <input type="hidden" name="class_level" value="<%= selectedClass %>">
                    <input type="hidden" name="course_id" value="<%= selectedCourseId %>">
                    <input type="text" name="academic_year" value="2019 E.C" style="width:110px; margin:0; font-weight:bold;">
                    <button type="submit" style="background:#27ae60; padding:10px 20px;">✅ <span class="am">ውጤቱን ለአድሚን አስረክብ</span><span class="en">Submit to Admin</span></button>
                </form>
            </div>
        </div>

        <!-- Teacher Notification Center with Search + Rich Text -->
        <div class="card" style="border-top-color:#e67e22;">
            <h3>📢 <span class="am">ማስታወቂያ መላኪያ (ለአድሚን፣ ለክፍሎቼ ወይም ለተማሪ)</span><span class="en">Send Notification (Admin / My Classes / Student)</span></h3>
            <form id="teacherNotifForm" action="/teacher/send-notification?cls=<%= encodeURIComponent(selectedClass) %>" method="POST" enctype="multipart/form-data">
                
                <label style="font-weight:bold; display:block; margin-bottom:6px;">
                    🎯 <span class="am">1. ቀላል ምርጫ (ለአድሚን / ለክፍሎቼ)</span><span class="en">1. Quick Select:</span>
                </label>
                <select id="teacherQuickTarget" style="max-width:450px; margin-bottom:12px;">
                    <% if (typeof teacherTargetOptions !== 'undefined' && teacherTargetOptions) { %>
                        <%- teacherTargetOptions %>
                    <% } else { %>
                        <option value="ADMIN">👑 ለአድሚን / ዲሬክተር (To Admin)</option>
                        <option value="<%= selectedClass %>">🏫 ለዚህ ክፍል (<%= selectedClass %>)</option>
                    <% } %>
                </select>
                <input type="hidden" name="target_audience" id="teacherFinalTarget" value="ADMIN">

                <!-- Search individual student (only from teacher's classes) -->
                <div style="background:#f0f7ff; border:2px solid #3498db; border-radius:10px; padding:14px; margin-bottom:16px;">
                    <label style="font-weight:bold; display:block; margin-bottom:6px; color:#1f4e79;">
                        🔍 <span class="am">2. ወይም የተማሪ ስም / ID ፈልገው ይላኩ (ከሚያስተምሩባቸው ክፍሎች ብቻ)</span>
                        <span class="en">2. Or search student by name/ID (only your classes)</span>
                    </label>
                    <input type="text" id="teacherSearchInput" placeholder="ስም ወይም ID... (e.g. Bereket or ALLS-5430)"
                           style="max-width:450px; padding:10px; border:1px solid #3498db; border-radius:6px;" autocomplete="off">
                    <div id="teacherSearchResults" style="display:none; max-width:450px; max-height:180px; overflow-y:auto; background:white; border:1px solid #cbd5e1; border-radius:0 0 6px 6px;"></div>
                    <div id="teacherSelectedBox" style="display:none; margin-top:10px; padding:8px 12px; background:#e8f5e9; border:1px solid #27ae60; border-radius:6px; max-width:450px;">
                        <span style="font-weight:bold; color:#1b5e20;">✅ ተመርጧል:</span>
                        <span id="teacherSelectedText" style="font-weight:bold;"></span>
                        <button type="button" onclick="clearTeacherSelection()" style="float:right; background:#e74c3c; color:white; border:none; padding:3px 8px; border-radius:4px; font-size:12px; cursor:pointer;">✕</button>
                    </div>
                    <input type="hidden" id="teacherIndividualTarget" value="">
                </div>

                <label style="font-weight:bold; display:block; margin-bottom:6px;">
                    🎨 <span class="am">መልዕክትዎን ይጻፉ (ከለር፣ ፎንት፣ ሳይዝ፣ Bold)፦</span>
                    <span class="en">Write message (Color, Font, Size, Bold):</span>
                </label>
                <div id="teacherEditor"></div>
                <input type="hidden" name="message" id="teacherHiddenMsg">

                <label style="font-weight:bold; display:block; margin-top:12px; margin-bottom:6px;">
                    📎 <span class="am">ፋይል / ፎቶ አያይዝ (አማራጭ)</span><span class="en">Attach File / Photo (Optional)</span>
                </label>
                <input type="file" name="attachment" style="max-width:350px;">

                <button type="submit" style="background:#e67e22; display:block; margin-top:12px;">
                    📩 <span class="am">ማስታወቂያውን ላክ</span><span class="en">Send Notification</span>
                </button>
            </form>
        </div>

        <!-- Sent Notifications -->
        <div class="card">
            <h3>🔔 <span class="am">እርስዎ የላኳቸው ማስታወቂያዎች (የራስዎን ብቻ ማስተካከል/ማጥፋት ይችላሉ)</span><span class="en">Your Sent Notifications (Edit/Delete own only)</span></h3>
            <div>
                <%- teacherNotiRows || '<p style="color:#777;">ምንም የተላከ ማስታወቂያ የለም። / No sent notifications.</p>' %>
            </div>
        </div>

        <!-- Absence Requests -->
        <div class="card">
            <h3>📝 <span class="am">የተማሪዎች የፈቃድ ጥያቄዎች</span><span class="en">Student Absence Requests</span></h3>
            <table>
                <tr id="absences"><th>Student</th><th>Date</th><th>Reason</th><th>Feedback / Reply</th></tr>
                <%- absRows || '<tr><td colspan="4">ምንም የፈቃድ ጥያቄ የለም። / No requests.</td></tr>' %>
            </table>
        </div>
    </div>

    <script>
        function setLang(l) {
            const clean = (l === 'en') ? 'en' : 'am';
            const isDark = document.body.classList.contains('dark');
            document.body.className = 'lang-' + clean + (isDark ? ' dark' : '');
            localStorage.setItem('prefLang', clean);
            const btnAm = document.getElementById('btn-am');
            const btnEn = document.getElementById('btn-en');
            if (btnAm && btnEn) {
                btnAm.style.background = clean === 'am' ? '#27ae60' : '#7f8c8d';
                btnEn.style.background = clean === 'en' ? '#2980b9' : '#7f8c8d';
            }
        }
        function toggleDark() {
            document.body.classList.toggle('dark');
            localStorage.setItem('darkMode', document.body.classList.contains('dark') ? '1' : '0');
            document.getElementById('darkBtn').textContent = document.body.classList.contains('dark') ? '☀️' : '🌙';
        }

        // Students in current class for search (passed from server if available)
        const teacherStudentsData = <%- typeof teacherStudentsJson !== 'undefined' ? teacherStudentsJson : '[]' %>;

        document.addEventListener('DOMContentLoaded', () => {
            setLang(localStorage.getItem('prefLang') || 'am');
            if (localStorage.getItem('darkMode') === '1') {
                document.body.classList.add('dark');
                const db = document.getElementById('darkBtn');
                if (db) db.textContent = '☀️';
            }
            fetch('/api/unread-count').then(r => r.json()).then(d => {
                const b = document.getElementById('unreadBadge');
                if (b && d.count > 0) { b.textContent = d.count; b.style.display = 'inline-block'; }
            }).catch(() => {});

            // Quill rich text
            if (document.getElementById('teacherEditor')) {
                var quill = new Quill('#teacherEditor', {
                    theme: 'snow',
                    placeholder: 'መልዕክትዎን እዚህ ይጻፉ... / Write your message...',
                    modules: {
                        toolbar: [
                            [{ 'font': [] }, { 'size': ['small', false, 'large', 'huge'] }],
                            ['bold', 'italic', 'underline', 'strike'],
                            [{ 'color': [] }, { 'background': [] }],
                            [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                            ['clean']
                        ]
                    }
                });

                document.getElementById('teacherNotifForm').addEventListener('submit', function() {
                    document.getElementById('teacherHiddenMsg').value = quill.root.innerHTML;
                    const indiv = (document.getElementById('teacherIndividualTarget').value || '').trim();
                    const finalF = document.getElementById('teacherFinalTarget');
                    const quickVal = document.getElementById('teacherQuickTarget').value;
                    if (indiv && indiv.startsWith('STUDENT:')) {
                        finalF.value = indiv;  // one student only
                    } else {
                        finalF.value = quickVal || 'ADMIN';
                    }
                    if (!finalF.value) finalF.value = 'ADMIN';
                });
            }

            // Sync quick select
            const tQuick = document.getElementById('teacherQuickTarget');
            if (tQuick) {
                tQuick.addEventListener('change', function() {
                    document.getElementById('teacherIndividualTarget').value = '';
                    document.getElementById('teacherSelectedBox').style.display = 'none';
                    document.getElementById('teacherFinalTarget').value = this.value;
                });
                document.getElementById('teacherFinalTarget').value = tQuick.value;
            }

            // Search
            const tSearch = document.getElementById('teacherSearchInput');
            const tResults = document.getElementById('teacherSearchResults');
            if (tSearch) {
                tSearch.addEventListener('input', function() {
                    const q = this.value.trim().toLowerCase();
                    if (q.length < 1) { tResults.style.display = 'none'; return; }
                    const matches = (teacherStudentsData || []).filter(s =>
                        (s.name || '').toLowerCase().includes(q) || (s.id || '').toLowerCase().includes(q)
                    );
                    if (matches.length === 0) {
                        tResults.innerHTML = '<div style="padding:10px;color:#777;">ምንም አልተገኘም / No results</div>';
                    } else {
                        tResults.innerHTML = matches.slice(0, 12).map(s => `
                            <div class="t-search-item" data-value="STUDENT:${s.id}" data-label="👨‍🎓 ${s.name} (${s.id})"
                                 style="padding:10px 12px; cursor:pointer; border-bottom:1px solid #eee; font-size:13.5px;"
                                 onmouseover="this.style.background='#e3f2fd'" onmouseout="this.style.background='white'">
                                👨‍🎓 ${s.name} (${s.id})
                            </div>
                        `).join('');
                    }
                    tResults.style.display = 'block';
                    tResults.querySelectorAll('.t-search-item').forEach(item => {
                        item.addEventListener('click', function() {
                            const val = this.getAttribute('data-value');
                            document.getElementById('teacherIndividualTarget').value = val;
                            document.getElementById('teacherFinalTarget').value = val;
                            document.getElementById('teacherSelectedText').textContent = this.getAttribute('data-label');
                            document.getElementById('teacherSelectedBox').style.display = 'block';
                            tSearch.value = '';
                            tResults.style.display = 'none';
                        });
                    });
                });
            }

            window.clearTeacherSelection = function() {
                document.getElementById('teacherIndividualTarget').value = '';
                document.getElementById('teacherSelectedBox').style.display = 'none';
                document.getElementById('teacherSearchInput').value = '';
                const qs = document.getElementById('teacherQuickTarget');
                if (qs) document.getElementById('teacherFinalTarget').value = qs.value;
            };

            // AJAX Grade Save
            document.querySelectorAll('.ajax-grade-form').forEach(form => {
                form.addEventListener('submit', function(e) {
                    e.preventDefault();
                    const btn = this.querySelector('button[type="submit"]');
                    const row = this.closest('tr');
                    const quizInput = row.querySelector('input[name="quiz"]');
                    const assignInput = row.querySelector('input[name="assignment"]');
                    const projectInput = row.querySelector('input[name="project"]');
                    const midInput = row.querySelector('input[name="mid"]');
                    const finalInput = row.querySelector('input[name="final"]');
                    const studentId = this.querySelector('input[name="student_id"]').value;
                    const courseId = this.querySelector('input[name="course_id"]') ? this.querySelector('input[name="course_id"]').value : '';
                    btn.disabled = true;
                    btn.innerText = '⏳...';
                    fetch(this.action, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            student_id: studentId, course_id: courseId,
                            quiz: quizInput ? quizInput.value : 0,
                            assignment: assignInput ? assignInput.value : 0,
                            project: projectInput ? projectInput.value : 0,
                            mid: midInput ? midInput.value : 0,
                            final: finalInput ? finalInput.value : 0
                        })
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data && data.success && window.showToast) showToast('✅ Grade saved');
                        if (typeof window.classAvgCalc === 'function') window.classAvgCalc();
                        else if (data && data.error && window.showToast) showToast(data.error, 'err');
                        btn.disabled = false;
                        if (data && data.success) {
                            btn.style.background = '#16a085';
                            btn.innerText = `✅ ${data.total}`;
                        } else {
                            btn.style.background = '#e74c3c';
                            btn.innerText = '❌ Error';
                        }
                    })
                    .catch(() => {
                        btn.disabled = false;
                        btn.style.background = '#e74c3c';
                        btn.innerText = '❌ Error';
                    });
                });
            });
        });
    
    // Stay in place after save/send/reply (no jump to top)
    (function(){
        const KEY = 'scrollPos_' + location.pathname;
        const saved = sessionStorage.getItem(KEY);
        if (saved) {
            const y = parseInt(saved, 10);
            if (!isNaN(y)) {
                requestAnimationFrame(function(){ window.scrollTo(0, y); });
                setTimeout(function(){ window.scrollTo(0, y); }, 50);
                setTimeout(function(){ window.scrollTo(0, y); }, 200);
            }
            sessionStorage.removeItem(KEY);
        }
        function saveScroll(){ sessionStorage.setItem(KEY, String(window.scrollY || window.pageYOffset || 0)); }
        document.addEventListener('submit', function(e){
            const f = e.target;
            if (!f || f.tagName !== 'FORM') return;
            // AJAX forms handle themselves
            if (f.classList.contains('ajax-grade-form') || f.id === 'studentChatForm' || f.id === 'chatForm') return;
            saveScroll();
        }, true);
        document.addEventListener('click', function(e){
            const a = e.target.closest && e.target.closest('a[href]');
            if (!a) return;
            const href = a.getAttribute('href') || '';
            if (href.indexOf('/admin/approve/') === 0 || href.indexOf('/admin/reject/') === 0 ||
                href.indexOf('/delete-notification/') === 0 || href.indexOf('/edit-notification/') === 0) {
                saveScroll();
            }
        }, true);
    })();


    // Toast + loading + file preview + table search
    (function(){
        if (!document.querySelector('.toast-wrap')) {
            const w = document.createElement('div');
            w.className = 'toast-wrap';
            document.body.appendChild(w);
        }
        window.showToast = function(msg, type) {
            const w = document.querySelector('.toast-wrap');
            const t = document.createElement('div');
            t.className = 'toast' + (type === 'err' ? ' err' : type === 'info' ? ' info' : '');
            t.textContent = msg;
            w.appendChild(t);
            setTimeout(() => { t.remove(); }, 3200);
        };
        // Loading on non-AJAX form submit
        document.addEventListener('submit', function(e) {
            const f = e.target;
            if (!f || f.tagName !== 'FORM') return;
            if (f.classList.contains('ajax-grade-form') || f.id === 'studentChatForm' || f.id === 'chatForm') return;
            const btn = f.querySelector('button[type="submit"]');
            if (btn) { btn.classList.add('btn-loading'); btn.disabled = true; }
        }, true);
        // File preview for /uploads/ links
        document.addEventListener('click', function(e) {
            const a = e.target.closest && e.target.closest('a[href*="/uploads/"]');
            if (!a) return;
            const href = a.getAttribute('href') || '';
            if (!/\.(jpg|jpeg|png|gif|webp|pdf)(\?|$)/i.test(href) && href.indexOf('/uploads/') === -1) return;
            // preview images
            if (/\.(jpg|jpeg|png|gif|webp)(\?|$)/i.test(href)) {
                e.preventDefault();
                let m = document.getElementById('filePreviewModal');
                if (!m) {
                    m = document.createElement('div');
                    m.id = 'filePreviewModal';
                    m.className = 'preview-modal';
                    m.innerHTML = '<div class="box"><button type="button" class="close" onclick="document.getElementById(\'filePreviewModal\').classList.remove(\'show\')">×</button><img id="previewImg" src=""></div>';
                    document.body.appendChild(m);
                    m.addEventListener('click', function(ev){ if (ev.target === m) m.classList.remove('show'); });
                }
                document.getElementById('previewImg').src = href;
                m.classList.add('show');
            }
        });
        // Table search: input.search-box data-table="tableId"
        document.querySelectorAll('.search-box[data-table]').forEach(function(inp) {
            inp.addEventListener('input', function() {
                const q = (inp.value || '').toLowerCase();
                const table = document.getElementById(inp.getAttribute('data-table'));
                if (!table) return;
                table.querySelectorAll('tr').forEach(function(tr, i) {
                    if (i === 0 && tr.querySelector('th')) return;
                    tr.style.display = !q || tr.textContent.toLowerCase().indexOf(q) !== -1 ? '' : 'none';
                });
            });
        });
        // Empty states
        document.querySelectorAll('table[data-empty]').forEach(function(table) {
            const rows = table.querySelectorAll('tr');
            const dataRows = Array.from(rows).filter(r => !r.querySelector('th'));
            if (dataRows.length === 0) {
                const wrap = document.createElement('div');
                wrap.className = 'empty-state';
                wrap.innerHTML = '<span class="ico">📭</span>' + (table.getAttribute('data-empty') || 'No data');
                table.parentNode.insertBefore(wrap, table.nextSibling);
            }
        });
    })();

    // Grade save toast
    document.querySelectorAll('.ajax-grade-form').forEach(form => {
        form.addEventListener('submit', function() {
            const orig = form.onsubmit;
        });
    });
    const _fetch = window.fetch;
    // enhance existing ajax grade success if present
    document.querySelectorAll('.ajax-grade-form').forEach(form => {
        form.addEventListener('submit', function(e) {
            // existing handler may preventDefault - add toast after short delay via MutationObserver on button text
        });
    });


    window.classAvgCalc = function() {
        const totals = [];
        document.querySelectorAll('.ajax-grade-form').forEach(f => {
            const row = f.closest('tr');
            if (!row) return;
            const nums = row.querySelectorAll('input[type="number"]');
            let s = 0; nums.forEach(n => s += parseFloat(n.value)||0);
            totals.push(s);
        });
        const el = document.getElementById('classAvg');
        if (!el || !totals.length) return;
        const avg = totals.reduce((a,b)=>a+b,0)/totals.length;
        el.textContent = '📊 Class average (sum of components): ' + avg.toFixed(1) + ' · Students: ' + totals.length;
    };
    window.classAvgCalc();
</script>
</body>
</html>
