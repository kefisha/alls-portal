<div class="class-multi-box cm-quiz" style="border:1px solid #cbd5e1;border-radius:12px;padding:12px;margin:8px 0 12px;background:#f8fafc;">
  <div style="font-weight:800;color:#1e3a8a;margin-bottom:8px;">🏫 Class / Section (select one or more)</div>
  <label style="display:inline-flex;align-items:center;gap:6px;margin:4px 10px 4px 0;font-weight:700;"><input type="checkbox" class="cm-all" value="ALL"> All my classes</label>
  <label style="display:inline-flex;align-items:center;gap:6px;margin:4px 10px 4px 0;"><input type="checkbox" class="cm-ab" value="A&B"> A &amp; B (both)</label>
  <div class="cm-list" style="display:flex;flex-wrap:wrap;gap:8px 14px;margin-top:8px;"></div>
  <input type="hidden" name="class_level" class="cm-hidden" value="">
