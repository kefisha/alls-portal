<!DOCTYPE html>
<html lang="am">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teacher Dashboard - Amanuel Light and Life School</title>
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <style>
        :root { --bg:#eef2f5; --card:#fff; --text:#333; --border:#cbd5e1; --primary:#1f4e79; --even:#f8fafc; --input:#fff; }
        body.dark { --bg:#0f172a; --card:#1e293b; --text:#e2e8f0; --border:#334155; --primary:#3b82f6; --even:#162032; --input:#0f172a; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: var(--bg); margin: 0; padding: 20px; color: var(--text); transition: background 0.3s; }
        .container { max-width: 1150px; margin: auto; }
        body.lang-am .en { display: none !important; }
        body.lang-am .am { display: inline !important; }
        body.lang-en .am { display: none !important; }
        body.lang-en .en { display: inline !important; }
        .top-bar { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 20px; background: var(--card); padding: 15px 20px; border-radius: 12px; box-shadow: 0 3px 10px rgba(0,0,0,0.05); color: var(--text); }
        .card { background: var(--card); padding: 22px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); margin-bottom: 22px; border-top: 4px solid #2980b9; color: var(--text); }
        .card h3 { color: var(--primary); margin-top: 0; border-bottom: 2px solid var(--border); padding-bottom: 10px; }
        table { width: 100%; border-collapse: collapse; margin-top: 12px; }
        th, td { border: 1px solid var(--border); padding: 10px; text-align: center; font-size: 14px; color: var(--text); }
        th { background: var(--primary); color: white; }
        tr:nth-child(even) { background: var(--even); }
        select, input[type="text"], input[type="number"], input[type="file"], textarea {
            width: 100%; padding: 10px; margin-bottom: 10px; border: 1px solid var(--border); border-radius: 6px; box-sizing: border-box; font-family: inherit; background: var(--input); color: var(--text);
        }
        button { background: #2980b9; color: white; border: none; padding: 10px 18px; border-radius: 6px; font-weight: bold; cursor: pointer; }
        .logout-btn { background: #e74c3c; color: white; padding: 9px 18px; border-radius: 6px; text-decoration: none; font-weight: bold; }
        #teacherEditor { height: 160px; background: white; }
    
        /* ===== Modern UI 1-10 ===== */
        .toast-wrap { position: fixed; top: 18px; right: 18px; z-index: 99999; display: flex; flex-direction: column; gap: 8px; max-width: 320px; }
        .toast { background: #1e293b; color: #fff; padding: 12px 16px; border-radius: 10px; box-shadow: 0 8px 24px rgba(0,0,0,.25); font-size: 14px; font-weight: 600; animation: toastIn .25s ease; border-left: 4px solid #27ae60; }
        .toast.err { border-left-color: #e74c3c; }
        .toast.info { border-left-color: #3498db; }
        @keyframes toastIn { from { opacity:0; transform: translateY(-10px); } to { opacity:1; transform:none; } }
        .btn-loading { position: relative; pointer-events: none; opacity: .75; }
        .btn-loading::after { content: ""; width: 14px; height: 14px; border: 2px solid #fff; border-top-color: transparent; border-radius: 50%; display: inline-block; margin-left: 8px; vertical-align: middle; animation: spin .7s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
        .widget-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin-bottom: 18px; }
        .widget { background: var(--card); border-radius: 12px; padding: 14px 16px; box-shadow: 0 2px 10px var(--shadow); border: 1px solid var(--border); text-align: center; }
        .widget .n { font-size: 26px; font-weight: 800; color: var(--primary); }
        .widget .l { font-size: 12px; color: var(--text2); margin-top: 4px; }
        .search-box { width: 100%; max-width: 320px; padding: 10px 14px; border-radius: 24px; border: 1px solid var(--input-border); background: var(--input-bg); color: var(--text); margin-bottom: 12px; }
        .empty-state { text-align: center; padding: 28px 16px; color: var(--text2); font-size: 14px; }
        .empty-state .ico { font-size: 36px; display: block; margin-bottom: 8px; }
        .preview-modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.7); z-index: 99998; align-items: center; justify-content: center; padding: 20px; }
        .preview-modal.show { display: flex; }
        .preview-modal .box { background: #fff; border-radius: 12px; max-width: 90vw; max-height: 90vh; overflow: auto; padding: 12px; position: relative; }
        .preview-modal img, .preview-modal iframe { max-width: 100%; max-height: 80vh; }
        .preview-modal .close { position: absolute; top: 8px; right: 12px; background: #e74c3c; color: #fff; border: none; border-radius: 50%; width: 32px; height: 32px; font-weight: bold; cursor: pointer; }
        .mobile-nav { display: none; position: sticky; top: 0; z-index: 100; background: var(--primary); color: #fff; padding: 10px 14px; margin: -20px -20px 16px -20px; }
        .mobile-nav a { color: #fff; text-decoration: none; font-weight: bold; margin-right: 12px; font-size: 13px; }
        @media (max-width: 768px) {
            body { padding: 12px; }
            .mobile-nav { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
            .card { padding: 16px; }
            h2 { font-size: 20px; }
            table { font-size: 12px; display: block; overflow-x: auto; }
            th, td { padding: 8px; }
            button, .logout-btn { min-height: 44px; }
            input, select, textarea { font-size: 16px; } /* prevent iOS zoom */
        }
        @media print {
            .no-print, .mobile-nav, .logout-btn, .dark-toggle, .lang-bar { display: none !important; }
            body { background: #fff; padding: 0; }
            .card { box-shadow: none; border: 1px solid #ccc; break-inside: avoid; }
        }

</style>
</head>
